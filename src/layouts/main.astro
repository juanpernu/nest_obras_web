---
/**
 * Layout base del sitio. Carga el stylesheet global (Tailwind + tokens).
 * NO renombrar (ver docs/PLAN-EJECUCION.md §3.3).
 *
 * Provee: canonical autorreferencial, Open Graph por ruta, JSON-LD global
 * (GeneralContractor + Organization desde site.ts). Las páginas pueden pasar
 * structured data adicional (Person, Service, BreadcrumbList…) vía `jsonLd`.
 */
import '@/styles/global.css';
import { site } from '@/data/site';
// Preload solo el peso del <h1> (latin) — el resto compite con el LCP (identidad §2.1).
// 05/09/2026 (auditoría de performance): antes se precargaba 300, pero el 300
// solo lo usan los párrafos `font-light`. El <h1> de la home es 400 y el de las
// subpáginas (CabeceraPagina) es 500: se precarga el que cada ruta pinta primero.
import fuente400 from '@fontsource/roboto-condensed/files/roboto-condensed-latin-400-normal.woff2?url';
import fuente500 from '@fontsource/roboto-condensed/files/roboto-condensed-latin-500-normal.woff2?url';
import Nav from '@/components/astro/Nav.astro';
import Footer from '@/components/astro/Footer.astro';
import BotonFlotanteWhatsapp from '@/components/astro/BotonFlotanteWhatsapp.astro';
// Toolbar de anotaciones (solo desarrollo). Es el ÚNICO `client:*` del proyecto y
// existe detrás de `import.meta.env.DEV`: en el build de producción la condición es
// falsa, el island no se renderiza y no se emite JS (verificado con `pnpm build`).
// No renderizarlo sin el guard — rompe la regla de cero hidratación (§7.1).
import { Agentation } from 'agentation';
import Analytics from '@/components/astro/Analytics.astro';
import type { EventoDePagina } from '@/data/analytics';

interface Props {
  title?: string;
  description?: string;
  /** Ruta relativa a una imagen social (og:image). Opcional. */
  ogImage?: string;
  /** Texto alternativo de la og:image. Pasar siempre que se pase ogImage. */
  ogImageAlt?: string;
  /** true en rutas que no deben indexarse (ej. /contacto/gracias). */
  noindex?: boolean;
  /** Structured data específico de la página, se agrega al global. */
  jsonLd?: Record<string, unknown>[];
  /**
   * Evento de analítica que la página dispara al cargar (una vista de obra o de
   * servicio, que no nacen de un click). Los eventos de interacción NO van acá:
   * se instrumentan con `data-evento` en el elemento (ver Analytics.astro).
   */
  evento?: EventoDePagina;
  /**
   * Imagen a precargar con prioridad alta (candidata a LCP de la ruta). La
   * home pasa el poster del hero: la ruta vive en la página, junto al <video>
   * que la usa, así un rename no deja acá un preload a un 404.
   */
  preloadImagen?: string;
}

// Cast explícito: el binding implícito de `Props` a `Astro.props` no es fiable
// en todos los .astro de este toolchain (algunos quedan como Record<string,any>).
const {
  title = `${site.marca} | Constructora premium en Zona Norte y CABA | Viviendas y proyectos`,
  description = site.descripcion,
  ogImage,
  ogImageAlt,
  noindex = false,
  jsonLd = [],
  evento,
  preloadImagen,
} = Astro.props as Props;

const esHome = Astro.url.pathname.replace(/\/$/, '') === '';
const heroFont = esHome ? fuente400 : fuente500;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;

// Escapa `<` para que ningún valor de datos pueda cerrar el <script> del JSON-LD
// e inyectar HTML/JS (XSS, CWE-79/83). Crítico cuando `jsonLd` traiga datos de
// contenido (obras) en Fase 4. JSON.stringify NO escapa `<`, `>` ni `/`.
const toSafeJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');

// JSON-LD global: GeneralContractor + Organization. `address` se omite hasta
// tener la dirección real (§11) — no se inventan datos. Fundadores, contactPoint
// y descripción son datos reales del spec (§1). Sin AggregateRating/Review (§6.6).
const organizacionLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['GeneralContractor', 'Organization'],
  '@id': `${site.url}/#organizacion`,
  name: site.nombre,
  alternateName: site.marca,
  description: site.descripcion,
  url: site.url,
  email: site.email,
  telephone: `+${site.whatsapp.numero}`,
  areaServed: site.areaServed,
  founder: [
    { '@type': 'Person', name: 'Morena Alegre', jobTitle: 'Arquitecta' },
    { '@type': 'Person', name: 'Carlos Alegre', jobTitle: 'Ingeniero Civil' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: `+${site.whatsapp.numero}`,
    email: site.email,
    areaServed: 'AR',
    availableLanguage: ['es'],
  },
  sameAs: [site.instagram],
};
if (site.direccion) {
  organizacionLd.address = {
    '@type': 'PostalAddress',
    streetAddress: site.direccion.calle,
    addressLocality: site.direccion.localidad,
    addressRegion: site.direccion.provincia,
    // `postalCode` solo si lo tenemos: un CP inventado ensucia el NAP y el local SEO.
    ...(site.direccion.codigoPostal ? { postalCode: site.direccion.codigoPostal } : {}),
    addressCountry: site.direccion.pais,
  };
}

const webSiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.nombre,
  alternateName: site.marca,
  url: site.url,
  inLanguage: 'es-AR',
  publisher: { '@id': `${site.url}/#organizacion` },
};

// Un solo documento JSON-LD con @graph: más robusto que bloques sueltos y los
// @id se resuelven dentro del mismo grafo. El @context va una vez arriba; se lo
// quita de cada nodo (incluidos los que pasan las páginas vía `jsonLd`).
const stripCtx = (n: Record<string, unknown>) => {
  const copia = { ...n };
  delete copia['@context'];
  return copia;
};
const grafo = {
  '@context': 'https://schema.org',
  '@graph': [organizacionLd, webSiteLd, ...jsonLd].map(stripCtx),
};
---

<!doctype html>
<html lang="es-AR" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Favicon (05/09/2026): isotipo de NEST en blanco sobre navy, hecho a
        partir de los tres trazos de la marca en /logo-nest-oscuro.svg (sin el
        texto). SVG para browsers modernos, .ico (16/32/48 con PNG embebido)
        de fallback y apple-touch-icon de 180px para la pantalla de inicio
        de iOS, que ignora el SVG. Los tres se generan de public/favicon.svg. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={heroFont} as="font" type="font/woff2" crossorigin />
    {/* 05/09/2026: la página que tiene una imagen candidata a LCP la precarga
        con prioridad alta para que no espere detrás del CSS y las fuentes.
        En la home es el poster del hero (el LCP de texto es el <h1>; el poster
        es el candidato de imagen que Chrome ≥116 también evalúa). */}
    {preloadImagen && <link rel="preload" href={preloadImagen} as="image" fetchpriority="high" />}
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

    <script type="application/ld+json" is:inline set:html={toSafeJson(grafo)} />

    {/* El estado oculto de `data-reveal` lo activa ESTE script, no el CSS
        estático (16/08/2026). La diferencia importa: si el estado inicial
        viviera en la hoja de estilos, cualquier escenario donde el módulo de
        abajo no llegue a correr —error de red al pedir el .js, CSP, fallo de
        parseo— dejaría todo el contenido debajo del hero permanentemente
        invisible, con el HTML presente pero sin pintar. Un <noscript> no cubre
        nada de eso: solo cubre JS deshabilitado.

        Invirtiendo la lógica, el default del documento es VISIBLE y ocultar es
        una decisión que toma JS. Va `is:inline` y en el <head> por dos motivos:
        corre antes del primer paint, así no hay destello de contenido visible
        que se oculta, y al estar embebido no puede fallar por red.

        El failsafe cubre el caso restante: JS habilitado (así que la clase se
        aplicó y el contenido está oculto) pero el módulo nunca corre. Si a los
        2s nadie reclamó el reveal, se destraba solo. */}
    {/* En una línea a propósito: `is:inline` no pasa por el minificador y cada
        byte cuenta para el presupuesto de 5 KB de JS por ruta (§7.1). */}
    <script is:inline>var h=document.documentElement;h.classList.add('js-reveal');setTimeout(function(){h.hasAttribute('data-reveal-listo')||h.classList.remove('js-reveal')},2000)</script>
  </head>
  <body class="flex min-h-screen flex-col bg-white">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <BotonFlotanteWhatsapp />
    {import.meta.env.DEV && <Agentation client:only="react" />}

    {/* Va al final del <body>, no en el <head>: Astro inyecta el <link> del CSS
        al final del <head>, así que un script inline ahí queda por delante del
        stylesheet que pinta el <h1> (el LCP). Acá no compite con nada, y sigue
        corriendo mucho antes del `load`, que es cuando se piden los scripts
        reales — el orden que Consent Mode exige se respeta igual. */}
    <Analytics evento={evento} />
  </body>
</html>

{/* Entrada escalonada de los bloques de cada sección — el patrón `.reveal` del
    proto (09/08/2026). Nació dentro de index.astro y el 16/08/2026 subió acá,
    cuando el resto de las páginas adoptó el lenguaje de la Home: son seis
    páginas que necesitan exactamente las mismas 30 líneas, y copiarlas una vez
    por página es la forma segura de que un día dejen de estar sincronizadas.

    Todo cuelga de `.js-reveal`, que aplica el script inline del <head>. Sin esa
    clase el contenido está visible y sin transición: es el default del
    documento, y lo que garantiza que un fallo del módulo no deje la página en
    blanco. Ver la nota extensa allá arriba. */}
<style is:global>
  /* Entrada más marcada (18/08/2026, pedido explícito, segunda pasada): el
   * desplazamiento pasa de 10px a 28px y la duración de 0.7s a 1.1s, así el
   * movimiento se lee como una entrada y no como un fundido con un
   * empujoncito. El escalonado entre bloques también sube (90ms → 240ms, ver
   * el script de abajo): es lo que hace que se perciba la secuencia dentro de
   * cada sección en vez de que todo aparezca casi junto.
   *
   * Los mismos 1.1s y 28px que usa la entrada del hero (`reveal-up` en
   * `global.css` + los delays del markup de index.astro): son dos mecanismos
   * distintos —el hero anima al cargar, esto al entrar en viewport— pero
   * tienen que verse igual, así que si se calibra uno hay que mover el otro. */
  .js-reveal [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .js-reveal [data-reveal].visible {
    opacity: 1;
    transform: none;
  }

  /* 05/09/2026 (auditoría de performance): lo que ya está en el viewport al
   * cargar se muestra de una, sin transición ni escalonado — antes arrancaba
   * en opacity 0 igual que el resto y el último bloque de la primera sección
   * recién aparecía a ~2.5s. El script marca esos elementos con esta clase. */
  .js-reveal [data-reveal].visible.sin-transicion {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .js-reveal [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  /* El escalonado no se escribe a mano: cada elemento recibe un delay según su
   * posición DENTRO de su sección, así agregar o mover bloques no obliga a
   * renumerar nada. El footer y el header quedan afuera por construcción:
   * `data-reveal` solo se marca en el contenido de las páginas. */

  /* Reclama el reveal antes que nada: desarma el failsafe del <head>, que a los
   * 2s destraba la página asumiendo que este módulo nunca llegó. */
  document.documentElement.setAttribute('data-reveal-listo', '');

  const elementos = document.querySelectorAll<HTMLElement>('[data-reveal]');

  const mostrarTodo = () => elementos.forEach((el) => el.classList.add('visible'));

  if (elementos.length) {
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window)
    ) {
      mostrarTodo();
    } else {
      // 05/09/2026 (auditoría de performance): lo que ya está dentro del
      // viewport al cargar no se anima ni se observa — se marca visible sin
      // transición (`.sin-transicion`, ver el <style>) y sin delay. El efecto
      // queda solo para lo que entra por scroll. Se decide por posición y no
      // por el observer para que no haya ni un frame en opacity 0.
      const altoViewport = window.innerHeight;
      const porObservar = new Set<HTMLElement>();
      for (const el of elementos) {
        if (el.getBoundingClientRect().top < altoViewport) {
          el.classList.add('visible', 'sin-transicion');
        } else {
          porObservar.add(el);
        }
      }

      if (porObservar.size) {
        for (const seccion of document.querySelectorAll('section')) {
          // 240ms y no 90 (18/08/2026): escalonado más marcado, ver el
          // comentario de `.js-reveal [data-reveal]` en el <style>. El índice
          // cuenta solo los bloques que sí se van a animar dentro de la
          // sección, así el primero que entra por scroll arranca en 0ms.
          let i = 0;
          for (const el of seccion.querySelectorAll<HTMLElement>('[data-reveal]')) {
            if (!porObservar.has(el)) continue;
            el.style.transitionDelay = `${i++ * 240}ms`;
          }
        }
      }

      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (!entrada.isIntersecting) continue;
            entrada.target.classList.add('visible');
            observador.unobserve(entrada.target);
          }
        },
        // El margen inferior negativo evita que algo "entre" cuando apenas
        // asoma un píxel al borde de la ventana.
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      porObservar.forEach((el) => observador.observe(el));
    }
  }

  // Tap-to-color: en hover:none (touch) el filtro grayscale no tiene forma de
  // sacarse con :hover, así que un click/tap lo alterna a mano. En desktop
  // (hover: hover) no se agrega ningún listener y queda solo el CSS.
  if (window.matchMedia('(hover: none)').matches) {
    document.querySelectorAll<HTMLImageElement>('img.grayscale').forEach((img) => {
      img.addEventListener('click', () => img.classList.toggle('grayscale'));
    });
  }
</script>
