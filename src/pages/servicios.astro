---
import Layout from '@/layouts/main.astro';
import GrillaLogos from '@/components/astro/GrillaLogos.astro';
import Boton from '@/components/astro/Boton.astro';
import Eyebrow from '@/components/astro/Eyebrow.astro';
import CabeceraPagina from '@/components/astro/CabeceraPagina.astro';
import HojaTecnica from '@/components/astro/HojaTecnica.astro';
import MarcoSeccion from '@/components/astro/MarcoSeccion.astro';
import FranjaRayado from '@/components/astro/FranjaRayado.astro';
import { getCollection, render } from 'astro:content';
import { site } from '@/data/site';

const entries = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const servicios = await Promise.all(
  entries.map(async (s) => ({ data: s.data, Content: (await render(s)).Content })),
);

const modalidades = [
  {
    titulo: 'Llave en mano',
    texto:
      'Precio único acordado, pliego de especificaciones técnicas detallado y certeza del tiempo de ejecución, costo y calidad final. Es la opción más tranquila: vos decidís, nosotros gestionamos todo.',
    ideal: 'Ideal para clientes que quieren despreocuparse del proceso y recibir la obra terminada.',
  },
  {
    titulo: 'Solo mano de obra',
    texto:
      'Nos ocupamos de la dirección y ejecución de la obra proveyendo todos los gremios necesarios. Vos gestionás la compra de materiales contando con nuestro asesoramiento y los descuentos que nuestros proveedores nos otorgan.',
    ideal: 'Ideal para clientes que quieren mayor control de los materiales y ya tienen experiencia en obra.',
  },
];

const serviciosLd = entries.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.data.nombre,
  serviceType: s.data.nombre,
  description: s.data.tagline,
  provider: { '@id': `${site.url}/#organizacion` },
  areaServed: site.areaServed,
}));
---

{/* Alineada al lenguaje de la Home (16/08/2026). Ver la nota extensa de
    nosotros.astro: mismo criterio y mismas reglas de marco. Específico de esta
    página:

     - Las dos bandas navy (cabecera y clientes) y la tercera del CTA de cierre
       pasan a blanco. El navy queda para el footer, como en la Home.
     - No se monta <GrillaServicios> acá aunque sea el componente de servicios
       de la Home: sus tres tarjetas son un RESUMEN de esta página, y ponerlas
       arriba del detalle repetiría el mismo contenido dos veces en el mismo
       scroll. El lenguaje que sí se trae es el resto del sistema.
     - Las modalidades pasan de tarjetas planas navy-50 a la card GLASS del
       sitio: los cuatro valores salen tal cual del formulario de la Sección 9
       de la Home, que a su vez los tomó del header scrolleado (Nav.astro).
     - Los subrayados de 4px en arena bajan a la regla de 1px del sistema. */}
<Layout
  title="Servicios de construcción | NEST Zona Norte y CABA"
  description="Construcción llave en mano, refacciones, proyectos corporativos y dirección de obra. NEST cubre todo el proceso de principio a fin en Zona Norte y CABA."
  jsonLd={serviciosLd}
  evento={{ nombre: 'servicio_view' }}
>
  <HojaTecnica>
    {/* CON BLOQUE VISUAL AL 50% (22/08/2026, mismo pedido y misma solución que
        la cabecera de /nosotros: "añadir una imagen a la derecha del texto,
        full height y que llegue al marco en todos sus extremos, sin
        excederlo... que ocupe el 50% del width de la sección en escritorio").
        Geometría y clase `.cab-visual` copiadas tal cual de nosotros.astro
        (ver el <style> de esa página para el detalle de cada medida) — es la
        técnica de `.form-a-la-guia` de la Home/contacto aplicada a esta
        cabecera. PLACEHOLDER NAVY, imagen a definir: mismo criterio que
        /nosotros, se reemplaza por un <Image> sin tocar el layout. */}
    <MarcoSeccion cierra>
      <section class="bg-white py-20 md:py-[120px]">
        <div class="mx-auto grid max-w-6xl items-stretch gap-12 px-6 md:grid-cols-2">
          <CabeceraPagina
            sinContenedor
            eyebrow="Servicios"
            titulo="Servicios de construcción"
            bajada="Cubrimos todo el proceso de principio a fin: proyecto, permisos, ejecución y entrega. Con un solo responsable de la obra y un único punto de contacto."
          />
          <div class="cab-visual bg-navy" aria-hidden="true"></div>
        </div>
      </section>
    </MarcoSeccion>

    {/* Cierre del capítulo "qué hacemos": lo que sigue es el detalle. */}
    <FranjaRayado />

    {/* ÍNDICE TIPOGRÁFICO (16/08/2026, pedido directo: "aplicá el mismo criterio
        tipográfico"). Mismo recurso que el proceso de /nosotros: renglones a
        todo el ancho separados por la regla de 1px del sistema, y el contraste
        de escala haciendo el trabajo en vez de una caja. La cifra sube a
        `text-stat` en peso 300 —el par tamaño/peso del dato editorial de
        BarraEstadisticas— y queda colgada en su propia columna, como la
        numeración al margen de un pliego.

        Reemplaza al eyebrow "SERVICIO 01" a 11px, que decía lo mismo en el
        tamaño más chico del sistema: el número era información de índice
        tratada como nota al pie.

        `<ol>` y no `<ul>`: el orden es dato real de la colección (`orden` en el
        schema de `servicios`, por el que se ordena arriba), no una casualidad
        del markup.

        Tres ejes en desktop —cifra, bloque de texto, lista de `incluye`— con
        `items-baseline`, así las tres columnas arrancan en la misma línea. En
        md son dos (la lista baja bajo el texto) y en mobile una: a 375px una
        columna fija para el número deja el texto partiéndose cada dos palabras. */}
    <MarcoSeccion cierra>
      <section class="bg-white py-20 md:py-[120px]">
        <div class="mx-auto max-w-6xl px-6">
          <ol class="divide-y divide-arena border-y border-arena" data-reveal>
            {
              servicios.map((s, i) => (
                <li class="grid gap-x-10 gap-y-4 py-12 md:grid-cols-[6rem_1fr] lg:grid-cols-[7rem_1fr_16rem] lg:items-baseline">
                  <span class="text-stat font-light leading-none text-navy">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="md:col-start-2">
                    <h2 class="text-h2 font-normal text-navy">{s.data.nombre}</h2>
                    <p class="mt-2 text-h3 font-light text-navy-700">{s.data.tagline}</p>
                    <div class="mt-4 max-w-[64ch] font-light leading-relaxed text-navy-700 [&_p]:mt-0">
                      <s.Content />
                    </div>
                  </div>
                  <ul class="space-y-2 text-sm text-navy-700 md:col-start-2 lg:col-start-3">
                    {s.data.incluye.map((item) => (
                      <li class="flex gap-2.5">
                        <span aria-hidden="true" class="text-arena-800">
                          —
                        </span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
    </MarcoSeccion>

    {/* Cierre del capítulo: lo que sigue es cómo se contrata. */}
    <FranjaRayado />

    <MarcoSeccion>
      <section class="bg-white py-20 md:py-[120px]">
        <div class="mx-auto max-w-6xl px-6">
          <div data-reveal>
            <Eyebrow class="mb-2.5">Modalidades</Eyebrow>
            <h2 class="text-h2 font-normal text-navy">Cómo preferís trabajar con nosotros</h2>
          </div>
          {/* BENTO de 3 cards (22/08/2026, pedido directo: "replicame acá el
              bento grid que tenemos en nosotros pero con tres cards paralelas
              de izquierda a derecha, y la tercera es una imagen (placeholder)
              que ocupa el total width y height del contenedor"). Reemplaza al
              índice tipográfico de dos renglones que había acá.

              A diferencia de GrillaProceso.astro (asimétrico 3+3/2+2+2 sobre 6
              columnas, para 5 pasos), acá son tres columnas PARES: las dos
              modalidades de `modalidades` más una tercera celda de imagen,
              mismo ancho las tres. Mismo reticulado continuo sin gap —borde
              superior/izquierdo en la grilla, derecho/inferior en cada celda,
              escuadras en L solo en las cuatro esquinas externas— y misma
              sangría a las guías de página (`--sangria-guia`) que el resto del
              sistema. La celda de imagen no lleva padding: la foto (hoy
              placeholder navy) llena el 100% de ancho y alto de su celda. */}
          <div class="mod-bento relative mt-12" data-reveal>
            <ol class="mod-bento-grid">
              {
                modalidades.map((m, i) => (
                  <li class="mod-bento-celda">
                    <span class="block text-stat font-light leading-none text-navy">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <h3 class="mt-4 text-h3 font-medium uppercase tracking-[0.04em] text-navy">
                      {m.titulo}
                    </h3>
                    <p class="mt-3 max-w-[42ch] font-light leading-relaxed text-navy-700">
                      {m.texto}
                    </p>
                    <p class="mt-3 max-w-[42ch] text-sm italic text-navy-700">{m.ideal}</p>
                  </li>
                ))
              }
              {/* PLACEHOLDER NAVY, imagen a definir: mismo criterio que
                  `.cab-visual` más arriba en esta misma página. */}
              <li class="mod-bento-celda mod-bento-celda--img bg-navy" aria-hidden="true" />
            </ol>
            <span class="mod-bento-esq mod-bento-esq--si" aria-hidden="true" />
            <span class="mod-bento-esq mod-bento-esq--sd" aria-hidden="true" />
            <span class="mod-bento-esq mod-bento-esq--ii" aria-hidden="true" />
            <span class="mod-bento-esq mod-bento-esq--id" aria-hidden="true" />
          </div>
        </div>
      </section>
    </MarcoSeccion>

    {/* Clientes corporativos (tabla reubicada de la ex-página corporativa,
        §5.3 / p.14). Mismo tratamiento que la Sección 6 de la Home: centrado,
        fondo blanco, logos en escala de grises que vuelven a color en hover. */}
    <MarcoSeccion cierra>
      <section class="bg-white py-20 md:py-[120px]">
        <div class="mx-auto max-w-6xl px-6 text-center">
          <h2 class="text-h2 font-normal text-navy" data-reveal>Empresas que confiaron en NEST</h2>
          <div data-reveal>
            <GrillaLogos class="mt-10" />
          </div>
        </div>
      </section>
    </MarcoSeccion>

    {/* Cierre del capítulo: lo que sigue es la acción. */}
    <FranjaRayado />

    {/* CTA de cierre en blanco con `secundario`, por el mismo motivo que en
        /nosotros: `primario` es glass con texto blanco y solo funciona sobre
        navy, y una banda navy acá se apilaba con el footer. */}
    <MarcoSeccion cierra>
      <section class="bg-white py-20 md:py-[120px]">
        <div class="mx-auto max-w-6xl px-6" data-reveal>
          <Eyebrow class="mb-2.5">Contacto</Eyebrow>
          <h2 class="max-w-[640px] text-h2 font-normal text-navy">
            Consulta tu proyecto sin compromiso
          </h2>
          <p class="mt-3 max-w-[560px] text-navy-700">
            Respondemos en menos de 24 horas en días hábiles.
          </p>
          <div class="mt-6">
            <Boton href="/contacto" variante="secundario">Consulta tu proyecto →</Boton>
          </div>
        </div>
      </section>
    </MarcoSeccion>
  </HojaTecnica>
</Layout>

<style>
  /* Bloque visual de la cabecera (Sección 1). Copiado tal cual de
   * `.cab-visual` en nosotros.astro — ver el comentario extenso ahí para el
   * detalle de cada medida. Misma técnica que `.form-a-la-guia` en
   * index.astro y contacto.astro: cada `margin` negativo cancela un padding
   * que separa el bloque de una línea del marco, para que muera EXACTO sobre
   * ella y sin excederla. */
  .cab-visual {
    margin-inline: calc(-1 * var(--sangria-guia));
    margin-bottom: -5rem;
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 768px) {
    .cab-visual {
      aspect-ratio: auto;
      margin-top: -120px;
      margin-bottom: -120px;
      margin-inline-start: -1.5rem;
      margin-inline-end: calc(-1 * var(--sangria-guia));
    }
  }

  /* Bento de Modalidades (Sección 3). Mismo reticulado continuo de
   * GrillaProceso.astro (ver ese archivo para el detalle de la técnica: borde
   * superior/izquierdo en la grilla, derecho/inferior en cada celda, sin
   * `gap`, así ningún cruce apila dos líneas de 1px), pero con TRES columnas
   * PARES en vez del escalonado 3+3/2+2+2 — acá son siempre tres celdas del
   * mismo ancho. */
  .mod-bento {
    margin-inline: calc(-1 * var(--sangria-guia));
  }

  .mod-bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-rule);
    border-left: 1px solid var(--color-rule);
  }

  .mod-bento-celda {
    min-width: 0;
    padding: 1.25rem;
    border-right: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  /* Celda de imagen: sin padding y con altura mínima propia en mobile (ahí es
   * una fila más, apilada, y sin una fila de grilla que le dé alto se vería
   * de 0px). Desde `md:` el `stretch` por default de la grilla la iguala al
   * alto de las otras dos celdas, así llena "el total width y height del
   * contenedor" que pidió el usuario. */
  .mod-bento-celda--img {
    padding: 0;
    min-height: 16rem;
  }

  @media (min-width: 768px) {
    .mod-bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .mod-bento-celda {
      padding: 2rem;
    }
    .mod-bento-celda--img {
      padding: 0;
      min-height: 0;
    }
  }
  @media (min-width: 1024px) {
    .mod-bento-celda {
      padding: 3rem;
    }
  }

  /* Escuadras en L, idénticas a `.gp-esq` de GrillaProceso: ancladas al
   * 0/100% del rectángulo, que tras la sangría cae sobre las guías de
   * página. */
  .mod-bento-esq {
    position: absolute;
    z-index: 2;
    width: 9px;
    height: 9px;
    border-style: solid;
    border-width: 0;
    border-color: var(--color-navy);
    pointer-events: none;
  }
  .mod-bento-esq--si {
    top: 0;
    left: 0;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
  }
  .mod-bento-esq--sd {
    top: 0;
    right: 0;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
  }
  .mod-bento-esq--ii {
    bottom: 0;
    left: 0;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
  }
  .mod-bento-esq--id {
    bottom: 0;
    right: 0;
    border-bottom-width: 1.5px;
    border-right-width: 1.5px;
  }
</style>
