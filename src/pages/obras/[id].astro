---
import Layout from '@/layouts/main.astro';
import FichaProyecto from '@/components/astro/FichaProyecto.astro';
import Galeria from '@/components/astro/Galeria.astro';
import Boton from '@/components/astro/Boton.astro';
import Eyebrow from '@/components/astro/Eyebrow.astro';
import HojaTecnica from '@/components/astro/HojaTecnica.astro';
import MarcoSeccion from '@/components/astro/MarcoSeccion.astro';
import FranjaRayado from '@/components/astro/FranjaRayado.astro';
import { getCollection, render } from 'astro:content';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const obras = await getCollection('obras', (o) => o.data.paginaPropia);
  return obras.map((obra) => ({ params: { id: obra.data.slug! }, props: { obra } }));
}

const { obra } = Astro.props;
const d = obra.data;
const { Content } = await render(obra);

const tipoLabel: Record<string, string> = {
  vivienda: 'Vivienda',
  corporativo: 'Corporativo',
  refaccion: 'Refacción',
  gastronomia: 'Gastronomía',
  edificio: 'Edificio',
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Obras', item: `${site.url}/obras` },
    { '@type': 'ListItem', position: 3, name: d.nombre, item: `${site.url}/obras/${d.slug}` },
  ],
};
---

{/* Alineada al lenguaje de la Home (16/08/2026). Ver la nota extensa de
    nosotros.astro: mismo criterio y mismas reglas de marco.

    NO lleva hero de foto, aunque sea el candidato natural a replicar el hero de
    la Home: HOY TODAS LAS IMÁGENES DE LA COLECCIÓN `obras` SON PLACEHOLDERS —
    tarjetas navy con el texto "PLACEHOLDER — REEMPLAZAR CON FOTO REAL"
    impreso—, portadas y galerías incluidas (ver docs/DEUDA-TECNICA.md). A
    sangre y bajo un overlay, ese cartel se lee entero y a pantalla completa.
    Cuando lleguen las fotos reales, el bloque a montar acá es el mismo de la
    Sección 1 de la Home: <Image> a sangre + `bg-black/50` + eyebrow `sobreNavy`
    + `text-hero`, y esta cabecera pasa a ser su fallback.

    Mientras tanto usa exactamente la misma cabecera blanca que /nosotros,
    /servicios, /obras y /contacto, así las cinco páginas abren igual. */}
<Layout title={d.seo?.titulo} description={d.seo?.descripcion} jsonLd={[breadcrumb]}>
  <article>
    <HojaTecnica>
      <MarcoSeccion>
        <section class="bg-white py-20 md:py-[120px]">
          <div class="mx-auto max-w-6xl px-6" data-reveal>
            <nav class="text-xs uppercase tracking-[0.08em] text-navy-700" aria-label="Migas de pan">
              <a href="/obras" class="transition-colors hover:text-navy">Obras</a>
              <span class="mx-2" aria-hidden="true">/</span><span>{d.nombre}</span>
            </nav>
            <Eyebrow class="mt-6 mb-2.5">{tipoLabel[d.tipo]} · {d.zona}</Eyebrow>
            <h1 class="max-w-[900px] text-h1 font-medium text-navy">{d.headline}</h1>
            <div class="mt-4 h-0.5 w-32 bg-arena" aria-hidden="true"></div>
            {
              d.subtitulo && (
                <p class="mt-6 max-w-[680px] text-lg font-light leading-relaxed text-navy-700">
                  {d.subtitulo}
                </p>
              )
            }
          </div>
        </section>
      </MarcoSeccion>

      <MarcoSeccion cierra>
        <section class="bg-white py-20 md:py-[120px]">
          <div class="mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-[1fr_2fr]">
            <div data-reveal>
              <Eyebrow class="mb-4">Ficha técnica</Eyebrow>
              <FichaProyecto ficha={d.ficha ?? []} />
            </div>
            <div
              class="max-w-none space-y-4 [&_h2]:mt-10 [&_h2]:text-h2 [&_h2]:font-medium [&_h2]:text-navy [&_h2:first-child]:mt-0 [&_p]:font-light [&_p]:leading-relaxed [&_p]:text-navy-700"
              data-reveal
            >
              <Content />
            </div>
          </div>

          {
            d.galeria && (
              <div class="mx-auto mt-16 max-w-6xl px-6" data-reveal>
                <Eyebrow class="mb-2.5">Galería</Eyebrow>
                <h2 class="mb-8 text-h2 font-medium text-navy">La obra terminada</h2>
                <Galeria galeria={d.galeria} />
              </div>
            )
          }
        </section>
      </MarcoSeccion>

      {/* Cierre del capítulo: lo que sigue es la acción. */}
      <FranjaRayado />

      {/* CTA de cierre en blanco con `secundario`, por el mismo motivo que en el
          resto de las páginas: `primario` es glass con texto blanco y solo
          funciona sobre navy, y una banda navy acá se apilaba con el footer. */}
      <MarcoSeccion cierra>
        <section class="bg-white py-20 md:py-[120px]">
          <div class="mx-auto max-w-6xl px-6" data-reveal>
            <Eyebrow class="mb-2.5">Contacto</Eyebrow>
            <h2 class="max-w-[640px] text-h2 font-medium text-navy">¿Tenés un proyecto así?</h2>
            <p class="mt-3 max-w-[560px] text-navy-700">
              Contanos y te respondemos en menos de 24 horas hábiles.
            </p>
            <div class="mt-6">
              <Boton href="/contacto" variante="secundario">Consulta tu proyecto →</Boton>
            </div>
          </div>
        </section>
      </MarcoSeccion>
    </HojaTecnica>
  </article>
</Layout>
