---
import Layout from '@/layouts/main.astro';
import FichaProyecto from '@/components/astro/FichaProyecto.astro';
import Galeria from '@/components/astro/Galeria.astro';
import Boton from '@/components/astro/Boton.astro';
import Eyebrow from '@/components/astro/Eyebrow.astro';
import CabeceraPagina from '@/components/astro/CabeceraPagina.astro';
import HojaTecnica from '@/components/astro/HojaTecnica.astro';
import MarcoSeccion from '@/components/astro/MarcoSeccion.astro';
import FranjaRayado from '@/components/astro/FranjaRayado.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { site } from '@/data/site';
import { tipoLabel } from '@/data/obras';
import pruneAntes from '@/assets/obras/prune-antes.jpg';
import elAromoAntes from '@/assets/obras/el-aromo-antes-real.jpg';
import tacuari1050Antes from '@/assets/obras/tacuari-1050-antes.jpg';
import elAromoDespues from '@/assets/obras/el-aromo-5.png';

/* Placeholder TEMPORAL del lado "antes" del slider (25/08/2026, pedido
 * directo): "prune" y "tacuari-1051" todavía no tienen foto real del estado
 * previo a la intervención, así que su "antes" muestra esta imagen navy
 * genérica (generada por scripts/gen-placeholders.mjs, mismo criterio que las
 * galerías placeholder). "el-aromo" ya usa una foto real de obra en proceso.
 * REEMPLAZAR el resto por la foto real de cada obra en cuanto esté disponible
 * — cambiar el import correspondiente, no hace falta tocar el resto de esta
 * página. */
const antesPorSlug: Record<string, ImageMetadata> = {
  prune: pruneAntes,
  'el-aromo': elAromoAntes,
  'tacuari-1051': tacuari1050Antes,
};

/* Alt del lado "antes": para "el-aromo" describe la foto real de obra en
 * proceso; para el resto, todavía en placeholder navy, avisa que es
 * provisorio (ver comentario de `antesPorSlug` arriba). */
const antesAltPorSlug: Record<string, string> = {
  'el-aromo': 'Obra en proceso, previa a la intervención',
};

/* Override puntual del lado "después" (25/08/2026, pedido directo): para
 * "el-aromo" se pidió otra foto en vez de `d.portada` (la genérica de la
 * obra). "prune" y "tacuari-1051" siguen usando su portada normal, sin
 * cambios. */
const despuesPorSlug: Partial<Record<string, ImageMetadata>> = {
  'el-aromo': elAromoDespues,
};

const despuesAltPorSlug: Record<string, string> = {
  'el-aromo': 'El Aromo, vista de la obra terminada',
};

export async function getStaticPaths() {
  const obras = await getCollection('obras', (o) => o.data.paginaPropia);
  return obras.map((obra) => ({ params: { id: obra.data.slug! }, props: { obra } }));
}

const { obra } = Astro.props;
const d = obra.data;
const { Content } = await render(obra);

/* `headline` y `slug` son opcionales en el schema porque las obras sin página
 * propia no los llevan, pero el `superRefine` de content.config.ts los exige
 * cuando `paginaPropia: true` y esta ruta solo se genera para esas. El build
 * falla en la validación de la colección mucho antes de llegar acá, así que la
 * aserción es la invariante que Zod ya garantiza y TS no puede inferir. */
const headline = d.headline!;
const antesImg = antesPorSlug[d.slug!];
const despuesImg = despuesPorSlug[d.slug!] ?? d.portada;
const despuesAlt = despuesAltPorSlug[d.slug!] ?? d.portadaAlt;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Obras', item: `${site.url}/obras` },
    { '@type': 'ListItem', position: 3, name: d.nombre, item: `${site.url}/obras/${d.slug}` },
  ],
};
---

{/* Alineada al lenguaje de la Home (16/08/2026). Ver la nota extensa de
    nosotros.astro: mismo criterio y mismas reglas de marco.

    CON BLOQUE VISUAL AL 50% (25/08/2026, mismo patrón que las cabeceras de
    /nosotros, /servicios y /obras: la portada de cada obra a sangre contra el
    marco, 50% del ancho de la sección en escritorio). A diferencia de esas
    tres, acá la fila del grid tiene una altura FIJA de 450px en escritorio
    (`md:grid-rows-[450px]`, no depende del texto de cada obra) para que la
    imagen siempre llene esos 450px y siempre bleedee contra el marco arriba y
    abajo — ver el <style> de esta página para el detalle. Usa
    `d.portada`/`d.portadaAlt` de la obra — ya todas tienen foto real, no
    placeholder. */}
<Layout
  title={d.seo?.titulo}
  description={d.seo?.descripcion}
  jsonLd={[breadcrumb]}
  evento={{ nombre: 'obra_view', params: { obra: d.nombre, tipo: d.tipo } }}
>
  <article>
    <HojaTecnica>
      <MarcoSeccion cierra>
        <section class="bg-white py-20 md:py-[120px]">
          <div class="mx-auto grid max-w-6xl gap-12 px-6 md:grid-cols-2 md:grid-rows-[300px]">
            <CabeceraPagina
              sinContenedor
              escalonado
              eyebrow={`${tipoLabel[d.tipo]} · ${d.zona}`}
              titulo={headline}
              bajada={d.subtitulo}
            >
              <nav
                slot="migas"
                class="text-xs uppercase tracking-[0.08em] text-navy-700"
                aria-label="Migas de pan"
              >
                <a href="/obras" class="transition-colors hover:text-navy">Obras</a>
                <span class="mx-2" aria-hidden="true">/</span><span>{d.nombre}</span>
              </nav>
            </CabeceraPagina>

            {/* SLIDER ANTES/DESPUÉS (25/08/2026, pedido directo): mismo patrón
                que el bento de Modalidades en servicios.astro — dos capas
                superpuestas, la de "antes" recortada con `clip-path` según el
                divisor arrastrable (Pointer Events, cubre mouse y touch) con
                soporte de flechas de teclado (rol `slider`). Ver el <script>
                de más abajo. El "antes" es una foto real para "el-aromo" y el
                placeholder navy TEMPORAL para el resto de las obras (ver el
                comentario del import de `antesPorSlug` más arriba); el
                "después" es `d.portada`, la foto real de la obra, salvo para
                "el-aromo" que usa otra foto pedida puntualmente (ver
                `despuesPorSlug` más arriba).

                ENTRADA ESCALONADA (25/08/2026): último elemento de la cadena
                que arranca en CabeceraPagina (eyebrow 0s → h1 0.25s → bajada
                0.5s) — este bloque cierra en 0.75s, mismo incremento de 0.25s
                por paso que usa el hero de la Home. CSS-only (`reveal-up`
                declarado, no `data-reveal`) por el mismo motivo que
                CabeceraPagina: el "después" de acá adentro es la LCP de la
                ruta y con `data-reveal` (opacity vía JS/IntersectionObserver)
                deja de ser candidato hasta que corre el observer. */}
            <div
              class="cab-visual overflow-hidden bg-navy opacity-0 motion-safe:animate-[reveal-up_0.7s_0.75s_cubic-bezier(0.22,1,0.36,1)_forwards] motion-reduce:opacity-100"
              data-obra-slider
            >
              <div class="obra-slider-despues">
                {/* eager + fetchpriority alta: mismo motivo que en nosotros.astro,
                    servicios.astro y obras/index.astro — este bloque es la LCP de
                    la ruta. */}
                <Image
                  src={despuesImg}
                  alt={despuesAlt}
                  loading="eager"
                  fetchpriority="high"
                  decoding="sync"
                  widths={[400, 640, 960, 1280]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="obra-slider-antes">
                <Image
                  src={antesImg}
                  alt={`${d.nombre}: ${antesAltPorSlug[d.slug!] ?? 'imagen provisoria, pendiente de reemplazo por una foto real del estado previo a la obra'}`}
                  widths={[400, 640, 960, 1280]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  class="h-full w-full object-cover obra-slider-imagen-antes"
                />
              </div>
              <span class="obra-slider-etiqueta obra-slider-etiqueta--antes" aria-hidden="true">
                Antes
              </span>
              <span class="obra-slider-etiqueta obra-slider-etiqueta--despues" aria-hidden="true">
                Después
              </span>
              <div
                class="obra-slider-divisor"
                role="slider"
                tabindex="0"
                aria-label="Comparar antes y después de la obra"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="50"
              >
                <span class="obra-slider-agarre" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </section>
      </MarcoSeccion>

      {/* Cierre del capítulo: lo que sigue es la ficha técnica. */}
      <FranjaRayado />

      <MarcoSeccion cierra>
        <section class="bg-white py-20 md:py-[120px]">
          <div class="mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-[1fr_2fr]">
            <div data-reveal>
              <Eyebrow class="mb-4">Ficha técnica</Eyebrow>
              <FichaProyecto ficha={d.ficha ?? []} />
            </div>
            <div
              class="max-w-none space-y-4 [&_h2]:mt-10 [&_h2]:text-h2 [&_h2]:font-normal [&_h2]:text-navy [&_h2:first-child]:mt-0 [&_p]:font-light [&_p]:leading-relaxed [&_p]:text-navy-700"
              data-reveal
            >
              <Content />
            </div>
          </div>

          {
            d.galeria && (
              <div class="mx-auto mt-16 max-w-6xl px-6" data-reveal>
                <Eyebrow class="mb-2.5">Galería</Eyebrow>
                <h2 class="mb-8 text-h2 font-normal text-navy">La obra terminada</h2>
                <Galeria galeria={d.galeria} />
              </div>
            )
          }
        </section>
      </MarcoSeccion>

      {/* Cierre del capítulo: lo que sigue es la acción. */}
      <FranjaRayado />

      {/* CTA de cierre en blanco con `secundario`, por el mismo motivo que en el
          resto de las páginas: `primario` es glass con texto blanco y solo
          funciona sobre navy, y una banda navy acá se apilaba con el footer. */}
      <MarcoSeccion cierra>
        <section class="bg-white py-20 md:py-[120px]">
          <div class="mx-auto max-w-6xl px-6" data-reveal>
            <Eyebrow class="mb-2.5">Contacto</Eyebrow>
            <h2 class="max-w-[640px] text-h2 font-normal text-navy">¿Tenés un proyecto así?</h2>
            <p class="mt-3 max-w-[560px] text-navy-700">
              Contanos y te respondemos en menos de 24 horas hábiles.
            </p>
            <div class="mt-6">
              <Boton href="/contacto" variante="secundario">Consulta tu proyecto →</Boton>
            </div>
          </div>
        </section>
      </MarcoSeccion>
    </HojaTecnica>
  </article>

  <script>
    // Slider antes/después del bloque visual de la cabecera. Copiado tal cual
    // del bento de Modalidades en servicios.astro (ver ese archivo para el
    // detalle de la técnica) — mismo criterio, otro selector porque acá
    // convive con el resto del layout de la cabecera, no con un bento.
    function initObraSlider() {
      const slider = document.querySelector<HTMLElement>('[data-obra-slider]');
      const antes = slider?.querySelector<HTMLElement>('.obra-slider-antes');
      const divisor = slider?.querySelector<HTMLElement>('.obra-slider-divisor');
      if (!slider || !antes || !divisor) return;

      let arrastrando = false;

      function fijarPosicion(porcentaje: number) {
        const pct = Math.min(100, Math.max(0, porcentaje));
        antes!.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
        divisor!.style.left = `${pct}%`;
        divisor!.setAttribute('aria-valuenow', String(Math.round(pct)));
      }

      function porcentajeDesdeEvento(clientX: number) {
        const rect = slider!.getBoundingClientRect();
        return ((clientX - rect.left) / rect.width) * 100;
      }

      divisor.addEventListener('pointerdown', (e) => {
        arrastrando = true;
        divisor.setPointerCapture(e.pointerId);
      });
      slider.addEventListener('pointermove', (e) => {
        if (!arrastrando) return;
        fijarPosicion(porcentajeDesdeEvento(e.clientX));
      });
      divisor.addEventListener('pointerup', () => {
        arrastrando = false;
      });
      divisor.addEventListener('keydown', (e) => {
        const actual = parseFloat(divisor.style.left) || 50;
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          fijarPosicion(actual - 5);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          fijarPosicion(actual + 5);
        }
      });

      fijarPosicion(50);
    }

    initObraSlider();
  </script>

  <style>
    /* Bloque visual de la cabecera (Sección 1). Variante "fila fija"
     * (25/08/2026, corrección sobre la variante "hug" anterior): a pedido,
     * en escritorio la fila del grid tiene una altura FIJA de 450px
     * (`md:grid-rows-[450px]` en el div de la página) que no depende del
     * texto de cada obra — a diferencia de `.cab-visual` en nosotros.astro,
     * donde la fila se estira al alto natural de la columna de texto.
     *
     * Con `align-items: stretch` (el default de grid, ya no se pisa con
     * `items-start`), `.cab-visual` llena esos 450px exactos de alto. El
     * sangrado (márgenes negativos) es EXACTAMENTE el mismo cálculo que en
     * nosotros.astro/servicios.astro: cada margen niega el `py-[120px]` de
     * la sección para que la imagen muera sobre las líneas del marco. Como
     * la fila mide 450px fijos y no la altura de la columna de texto, la
     * imagen siempre bleedea arriba y abajo sin importar cuánto texto tenga
     * la bajada. Si la columna de texto es más alta que 450px, se desborda
     * dentro de su propia columna (nunca la imagen, que queda anclada al
     * tamaño fijo de la fila). */
    .cab-visual {
      margin-inline: calc(-1 * var(--sangria-guia));
      margin-bottom: -5rem;
      aspect-ratio: 3 / 2;
    }

    @media (min-width: 768px) {
      .cab-visual {
        aspect-ratio: auto;
        margin-top: -120px;
        margin-bottom: -120px;
        margin-inline-start: -1.5rem;
        margin-inline-end: calc(-1 * var(--sangria-guia));
      }
    }

    /* Slider antes/después dentro de `.cab-visual`. Mismas reglas que
     * `.mod-bento-slider` en servicios.astro (ver ese archivo para el detalle
     * de cada una) — acá con el prefijo `.obra-slider` porque conviven con el
     * resto del layout de la cabecera. `position: relative` va sobre el mismo
     * elemento que ya tiene `overflow-hidden` (Tailwind) en el markup. */
    .cab-visual {
      position: relative;
      touch-action: none;
    }
    .obra-slider-despues,
    .obra-slider-antes {
      position: absolute;
      inset: 0;
    }
    .obra-slider-antes {
      clip-path: inset(0 50% 0 0);
    }

    /* La foto de "antes" (placeholder navy o, para "el-aromo", la foto real de
     * obra en proceso) siempre va en blanco y negro, sin hover ni
     * tap-to-color (por eso NO usa la clase Tailwind `grayscale` — el script
     * de tap-to-color en main.astro selecciona genéricamente `img.grayscale`
     * y la excluiría de este comportamiento fijo). */
    .obra-slider-imagen-antes {
      filter: grayscale(1);
    }

    .obra-slider-etiqueta {
      position: absolute;
      z-index: 3;
      bottom: 1rem;
      border-radius: 2px;
      background-color: color-mix(in srgb, var(--color-arena) 55%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid color-mix(in srgb, var(--color-arena) 85%, transparent);
      padding: 0.3rem 0.6rem;
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #fff;
      pointer-events: none;
    }
    .obra-slider-etiqueta--antes {
      left: 1rem;
    }
    .obra-slider-etiqueta--despues {
      right: 1rem;
    }

    .obra-slider-divisor {
      position: absolute;
      top: 0;
      left: 50%;
      z-index: 4;
      width: 2px;
      height: 100%;
      background-color: #fff;
      transform: translateX(-50%);
      cursor: ew-resize;
    }
    .obra-slider-divisor:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .obra-slider-agarre {
      position: absolute;
      top: 50%;
      left: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      background-color: #fff;
      transform: translate(-50%, -50%);
    }
    .obra-slider-agarre::before,
    .obra-slider-agarre::after {
      content: '';
      width: 0;
      height: 0;
      border-top: 5px solid transparent;
      border-bottom: 5px solid transparent;
    }
    .obra-slider-agarre::before {
      margin-right: 3px;
      border-right: 6px solid var(--color-navy);
    }
    .obra-slider-agarre::after {
      margin-left: 3px;
      border-left: 6px solid var(--color-navy);
    }
  </style>
</Layout>
