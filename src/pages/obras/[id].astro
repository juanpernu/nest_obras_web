---
import Layout from '@/layouts/main.astro';
import FichaProyecto from '@/components/astro/FichaProyecto.astro';
import Galeria from '@/components/astro/Galeria.astro';
import Boton from '@/components/astro/Boton.astro';
import { getCollection, render } from 'astro:content';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const obras = await getCollection('obras', (o) => o.data.paginaPropia);
  return obras.map((obra) => ({ params: { id: obra.data.slug! }, props: { obra } }));
}

const { obra } = Astro.props;
const d = obra.data;
const { Content } = await render(obra);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Obras', item: `${site.url}/obras` },
    { '@type': 'ListItem', position: 3, name: d.nombre, item: `${site.url}/obras/${d.slug}` },
  ],
};
---

<Layout title={d.seo?.titulo} description={d.seo?.descripcion} jsonLd={[breadcrumb]}>
  <article>
    <section class="bg-navy py-16 text-white md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <nav class="text-xs uppercase tracking-[0.08em] text-navy-200" aria-label="Migas de pan">
          <a href="/obras" class="hover:text-arena">Obras</a>
          <span class="mx-2">/</span><span>{d.nombre}</span>
        </nav>
        <h1 class="mt-6 text-hero font-light">{d.headline}</h1>
        {d.subtitulo && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-navy-100">{d.subtitulo}</p>}
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-[1fr_2fr]">
        <FichaProyecto ficha={d.ficha ?? []} />
        <div
          class="max-w-none space-y-4 [&_h2]:mt-10 [&_h2]:text-h2 [&_h2]:font-normal [&_h2]:text-navy [&_h2:first-child]:mt-0 [&_p]:leading-relaxed [&_p]:text-navy"
        >
          <Content />
        </div>
      </div>

      {
        d.galeria && (
          <div class="mx-auto mt-14 max-w-6xl px-6">
            <h2 class="mb-6 text-h2 font-normal text-navy">Galería</h2>
            <Galeria galeria={d.galeria} />
          </div>
        )
      }
    </section>

    {/* Estandarizada a navy (10/08/2026): era la única de las 4 páginas con
        este mismo bloque de cierre que usaba bg-navy-50 en vez de bg-navy. El
        botón "primario" ahora es glass con texto blanco, pensado para fondo
        navy — sobre navy-50 el texto blanco no pasaría contraste. */}
    <section class="bg-navy py-16 text-center text-white md:py-20">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="text-h2 font-normal">¿Tenés un proyecto así?</h2>
        <p class="mt-3 text-navy-100">Contanos y te respondemos en menos de 24 horas hábiles.</p>
        <div class="mt-6"><Boton href="/contacto" variante="primario">Consulta tu proyecto</Boton></div>
      </div>
    </section>
  </article>
</Layout>
