---
import Layout from '@/layouts/main.astro';
import FormularioConsulta from '@/components/astro/FormularioConsulta.astro';
import TimelineContacto from '@/components/astro/TimelineContacto.astro';
import Boton from '@/components/astro/Boton.astro';
import CabeceraPagina from '@/components/astro/CabeceraPagina.astro';
import HojaTecnica from '@/components/astro/HojaTecnica.astro';
import MarcoSeccion from '@/components/astro/MarcoSeccion.astro';
import { Image } from 'astro:assets';
import { whatsappUrl } from '@/data/site';
import hormigonSombra from '@/assets/contacto/hormigon-sombra.png';

// Bloques de confianza PROVISIONALES — reemplazar por el copy del PDF pp.15-17
// (§5.6: separar título y párrafo, que en el PDF vienen pegados).
const bloques = [
  { titulo: 'Respuesta en el día', texto: 'En horario hábil respondemos tu consulta en el momento; siempre en menos de 24 horas hábiles.' },
  { titulo: 'Sin costo ni compromiso', texto: 'La primera consulta y el asesoramiento inicial no tienen costo. Nos contás tu proyecto y te orientamos.' },
  { titulo: '+30 años de obra', texto: 'Ingeniería de nivel corporativo y arquitectura, con clientes como WeWork y PRÜNE.' },
];
---

{/* Alineada al lenguaje de la Home (16/08/2026). Ver la nota extensa de
    nosotros.astro: mismo criterio y mismas reglas de marco. Específico de esta
    página: pasa a ser la MISMA composición que la Sección 9 de la Home —
    columna editorial con <TimelineContacto> a la izquierda y el formulario como
    card glass protagonista a la derecha.

    Con eso se eliminó BloqueContacto.astro, que era la caja navy del NAP:
    <TimelineContacto> ya publica los mismos tres datos (teléfono, email,
    dirección) desde site.ts, con las píldoras de ícono del sistema, así que
    mantener las dos era mostrar el NAP dos veces en la misma pantalla. También
    sale la caja navy-50 del CTA de WhatsApp: el botón queda debajo del
    timeline, con la variante `secundario` (subrayado navy).

    Dos secciones y no una sola como en la Home: acá el título de la página es un
    <h1>, y meterlo en la columna izquierda dejaría los <h3> del timeline
    colgando de un h1 sin h2 en el medio (salto de jerarquía, §6.2). */}
<Layout
  title="Contacto | NEST Constructora Zona Norte y CABA"
  description="Contanos tu proyecto de vivienda, refacción u obra corporativa. Respondemos en menos de 24 horas hábiles. Zona Norte y CABA."
>
  <HojaTecnica>
    <MarcoSeccion>
      <section class="bg-white py-20 md:py-[120px]">
        <CabeceraPagina
          eyebrow="Contacto"
          titulo="Contanos tu proyecto"
          bajada="Respondemos en menos de 24 horas en días hábiles. La primera consulta no tiene costo ni compromiso, y hablás directamente con uno de los socios."
        />
      </section>
    </MarcoSeccion>

    <MarcoSeccion cierra>
      <section id="contacto" class="relative bg-white pt-20 pb-6 md:pt-[120px] md:pb-10">
        {/* Divisor vertical entre las dos columnas, igual que la Sección 9 de
            la Home: cierra las líneas de `TimelineContacto` y va al 50% exacto
            de la sección (mitad del `gap-12`). Solo desde `md:`. */}
        <span
          class="pointer-events-none absolute inset-y-0 left-1/2 hidden w-px bg-(--color-rule) md:block"
          aria-hidden="true"></span>
        <div class="mx-auto grid max-w-6xl items-stretch gap-12 px-6 md:grid-cols-2">
          {/* Exactamente el mismo componente que la Sección 9 de la Home
              (20/08/2026, pedido directo): antes esta página duplicaba a mano
              los tres bloques en un <ul> propio (check y líneas aparte) y
              montaba <TimelineContacto> solo por el NAP con `atributos={[]}`.
              Ahora es una única instancia con `atributos={bloques}`: el check
              en arena y las líneas horizontales sangradas a la guía ("el
              marco") salen del componente, igual que en la Home. */}
          <div data-reveal>
            <h2 class="text-h2 font-normal text-navy">Cómo trabajamos la primera consulta</h2>
            <TimelineContacto class="mt-8" atributos={bloques} />
            <div class="mt-8">
              <Boton
                href={whatsappUrl}
                variante="secundario"
                data-evento="whatsapp_click"
                data-evento-lugar="contacto_cta"
              >
                Escribinos por WhatsApp →
              </Boton>
            </div>
          </div>

          {/* Card NAVY con foto de fondo, mismo patrón que la Sección 9 de la
              Home (18/08/2026 ahí, portado acá para unificar la firma visual
              de "formulario de consulta" en todo el sitio): la caja llega
              hasta las líneas del marco, sin aire entre medio. Toda la
              geometría vive en `.form-a-la-guia` (ver <style> de esta
              página), con los mismos márgenes/paddings negativos dependientes
              de `--sangria-guia` que usa index.astro — el token es global
              (`:root` en global.css), así que el cálculo es idéntico acá.

              Imagen: `hormigon-sombra.png`, la misma que la Home
              (22/08/2026, reemplaza a `tacuari-san-telmo.png`, que se borró
              del repo). Compartirla entre las dos páginas es a propósito: es
              la firma visual del bloque "formulario de consulta" en todo el
              sitio, y repetirla refuerza la asociación en vez de diluirla.
              El encuadre —un detalle abstracto de hormigón cortado en
              diagonal por una sombra— está pensado para este recorte vertical
              con overlay de texto encima: no compite con el formulario como
              lo haría una foto de obra reconocible.

              `FormularioConsulta` pasa a `sobreNavy` porque el fondo ahora es
              oscuro (foto + velo `bg-black/50`, mismo valor que el overlay del
              hero) — el componente ya resuelve el contraste de labels,
              bordes y placeholders para esta variante (ver su comentario). */}
          <div class="form-a-la-guia relative isolate overflow-hidden bg-navy" data-reveal>
            {/* quality 45 + widths 480/720 (05/09/2026, auditoría de performance):
                es un fondo decorativo bajo un velo `bg-black/50`, no hace falta
                fidelidad — a 640/960 y calidad default pesaba 128/297 KB. La
                columna mide como mucho 576px desde md:, de ahí el `sizes` en px
                y el `width` para que el `src` de fallback no sea el original. */}
            <Image
              src={hormigonSombra}
              alt=""
              width={720}
              widths={[480, 720]}
              quality={45}
              sizes="(min-width: 768px) 576px, 100vw"
              class="absolute inset-0 -z-20 h-full w-full object-cover"
            />
            <div class="absolute inset-0 -z-10 bg-black/50" aria-hidden="true"></div>
            <h2 class="sr-only">Formulario de consulta</h2>
            <FormularioConsulta sobreNavy />
          </div>
        </div>
      </section>
    </MarcoSeccion>
  </HojaTecnica>
</Layout>

<style>
  /* Geometría del bloque del formulario, portada tal cual de index.astro
   * (Sección 9, 18/08/2026): tiene que morir EXACTO sobre las líneas del
   * marco, sin aire. Cada `margin` negativo cancela un padding que lo separa
   * de una línea, y el `padding` propio lo repone hacia adentro para que los
   * campos no se peguen al borde. Depende de `--sangria-guia`, que es un
   * token en `:root` de global.css (no algo que aporte HojaTecnica/MarcoSeccion),
   * así que el cálculo es idéntico en esta página aunque el <style> esté
   * scopeado acá y no se pueda compartir literalmente con index.astro.
   *
   * MOBILE (una sola columna: el formulario es una fila más, debajo de la
   * columna "Cómo trabajamos"): en X, a las dos guías vía `--sangria-guia`;
   * en Y, solo abajo (`pb-6` de la sección) — arriba no hay línea del marco
   * que cerrar. */
  .form-a-la-guia {
    margin-inline: calc(-1 * var(--sangria-guia));
    padding-inline: calc(1.5rem + var(--sangria-guia));
    padding-top: 1.5rem;
    margin-bottom: -1.5rem;
    padding-bottom: 3rem;
  }

  /* DESDE `md:` el grid pasa a dos columnas y el bloque llena su rectángulo
   * completo del marco:
   *  - Izquierda: mitad del `gap-12` → cae en el 50% de la sección, donde
   *    está el divisor vertical.
   *  - Derecha: `--sangria-guia` → la guía derecha de página.
   *  - Arriba y abajo: el `pt`/`pb` de la sección → las dos reglas de
   *    `MarcoSeccion`. */
  @media (min-width: 768px) {
    .form-a-la-guia {
      margin-top: -120px;
      padding-top: calc(120px + 2.5rem);
      margin-inline-start: -1.5rem;
      padding-inline-start: 2.5rem;
      margin-inline-end: calc(-1 * var(--sangria-guia));
      padding-inline-end: calc(2.5rem + var(--sangria-guia));
      margin-bottom: -2.5rem;
      padding-bottom: 5rem;
    }
  }
</style>
