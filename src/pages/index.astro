<style>
  /* Subrayado que se dibuja bajo el cierre del <h1> (07/08/2026). Va en un
   * ::after y no en el `background-size` del texto (la técnica de Boton.astro)
   * porque acá el trazo no responde a hover: se anima al cargar, reusando el
   * keyframe `hero-rule` que ya dibuja la línea de abajo. El delay pasó de
   * 0.7s a 1.15s (18/08/2026) para seguir cayendo DESPUÉS del reveal del h1.
   * Desde el 05/09/2026 el h1 arranca a los 0s (ver `lcp-up`) y dura 1.1s,
   * así que 1.15s sigue cayendo después de que termina; se deja igual para
   * no mover el resto de la cadena. */
  .subrayado-hero {
    position: relative;
  }

  .subrayado-hero::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    /* Debajo de los descendentes de "principio": la line-height del hero es
     * 1.1, así que el trazo se apoya afuera de la caja del texto. */
    bottom: -0.14em;
    height: 3px;
    background-color: var(--color-arena);
    transform: scaleX(0);
    transform-origin: left;
    animation: hero-rule 1s 1.15s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .subrayado-hero::after {
      animation: none;
      transform: scaleX(1);
    }
  }

  /* Máscara del isotipo en el overlay del hero (decisión del 06/08/2026,
   * replica el proto): dos capas de mask compuestas con "exclude" — la
   * primera es un degradé sólido que cubre todo el overlay, la segunda es el
   * isotipo de NEST (mismos 3 paths de public/logo-nest.svg) posicionado a la
   * derecha. Donde ambas capas se solapan (la silueta de la "N"), "exclude"
   * las cancela: el overlay no pinta ahí y se ve el video a pleno dentro del
   * isotipo. mask-composite no tiene shorthand en Tailwind, por eso va en un
   * <style> scoped en vez de utilities.
   *
   * BUG DE SINTAXIS corregido el 18/08/2026 (reportado: "la N se posiciona
   * rara en resoluciones de más de 1500px"). La posición nunca se aplicó, en
   * NINGÚN ancho: `right max(6vw, calc(...)) center` es la sintaxis de 3
   * valores de CSS Backgrounds L4 ("edge offset"), que Chromium soporta en
   * `background-position` pero NO en `mask-position` — la declaración entera
   * se descartaba como inválida y el navegador caía al default `0% 0%` en
   * las dos capas, dejando el isotipo siempre pegado arriba a la izquierda,
   * tapado por el header. Confirmado con `getComputedStyle`: devolvía
   * "0% 0%, 0% 0%" en todos los anchos probados.
   *
   * El arreglo es la sintaxis de 2 valores (universalmente soportada, sin la
   * palabra clave `right`): `calc(100% - X)` como componente horizontal
   * equivale exactamente a `right X` — el 100% de un `background/mask-position`
   * de 2 valores resuelve como (contenedor - imagen), así que
   * `calc(100% - X)` dpsición = (contenedor - imagen) - X, y el borde derecho
   * de la imagen queda a X del borde derecho del contenedor. Mismo resultado,
   * sintaxis que sí se parsea.
   *
   * `X` (la distancia al borde derecho) se recalibró de paso: la fórmula
   * vieja (`50% - 540px`) estaba pensada para el contenedor fijo de 1152px
   * que existía antes de que `--container-6xl` se volviera un `clamp()` hasta
   * 1536px (ver global.css) — con el contenedor más ancho en pantallas
   * grandes, esa cuenta ya no correspondía a nada real. Ahora usa
   * `var(--guia-margen)` más el mismo cálculo de `(100% - --container-6xl)/2`
   * que usan las guías de página del resto del sistema de marco (ver
   * `--marco-x` en MarcoSeccion/HojaTecnica/FranjaRayado): el isotipo queda
   * anclado a la MISMA guía vertical derecha que el resto de la página, en
   * vez de a un número mágico propio. */
  .hero-overlay {
    --iso: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="180 215 745 815"><path fill="%23fff" d="M204.164 494.511C209.186 498.107 230.479 520.19 236.231 525.952L306.802 596.632L571.809 861.605L642.51 790.904V933.292C620.092 955.33 594.332 983.06 571.521 1003.72L204.164 632.966V494.511Z"/><path fill="%23fff" d="M896.61 536.809C897.59 540.188 897.25 571.013 897.25 577.143L897.17 678.634L847.409 728.177C819.159 726.665 788.537 723.688 760.185 721.472L557.15 705.736L475.5 624.086L403.014 551.6C452.349 554.401 505.191 559.491 554.66 563.345L846.936 586.262L896.61 536.809Z"/><path fill="%23fff" d="M458.861 239.706C538.564 317.219 619.614 400.418 698.459 479.256C682.544 478.716 662.419 476.611 646.23 475.343L547.054 467.665L458.832 378.634L458.861 239.706Z"/></svg>');
    --iso-borde-der: max(var(--guia-margen), calc((100% - var(--container-6xl)) / 2 + 1.5rem));

    -webkit-mask-image: linear-gradient(#000, #000), var(--iso);
    mask-image: linear-gradient(#000, #000), var(--iso);
    -webkit-mask-position: 0 0, calc(100% - var(--iso-borde-der)) center;
    mask-position: 0 0, calc(100% - var(--iso-borde-der)) center;
    -webkit-mask-size: 100% 100%, auto 40%;
    mask-size: 100% 100%, auto 40%;
    -webkit-mask-repeat: no-repeat, no-repeat;
    mask-repeat: no-repeat, no-repeat;
    -webkit-mask-composite: xor; /* Safari/WebKit */
    mask-composite: exclude; /* estándar */
  }

  /* La ventana del isotipo solo se ve en desktop (decisión del 06/08/2026):
   * en mobile/tablet el hero es más angosto y la "N" recortada a la derecha
   * queda encima del texto o casi invisible, así que directamente se apaga y
   * el overlay vuelve a ser un tono plano de navy/50. Subido de 1023 a 1279px
   * (18/08/2026): con el h1 en `max-w-3xl` (768px), en el rango 1024-1279px
   * no queda aire suficiente para el isotipo sin invadir el texto. */
  @media (max-width: 1279px) {
    .hero-overlay {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* Geometría del bloque del formulario (18/08/2026): tiene que morir EXACTO
   * sobre las líneas del marco, sin aire. Cada `margin` negativo cancela un
   * padding que lo separa de una línea, y el `padding` propio lo repone hacia
   * adentro para que los campos no se peguen al borde ni se muevan de donde
   * estaban. Va todo acá y no en utilidades porque los valores dependen de
   * `--sangria-guia`, que cambia por media query (ver `global.css`).
   *
   * MOBILE (una sola columna: el formulario es una fila más, debajo de los
   * datos de contacto):
   *  - En X, a las dos guías. La distancia del contenido a la guía NO es el
   *    `px-6` del contenedor: en pantallas donde el contenedor ocupa todo el
   *    ancho, la guía queda ADENTRO de ese borde. De ahí `--sangria-guia`.
   *  - En Y, solo abajo (`pb-6` de la sección): arriba está el contenido de
   *    contacto, no una línea del marco, así que ahí no hay nada que cerrar. */
  .form-a-la-guia {
    margin-inline: calc(-1 * var(--sangria-guia));
    padding-inline: calc(1.5rem + var(--sangria-guia));
    padding-top: 1.5rem;
    margin-bottom: -1.5rem;
    padding-bottom: 3rem;
  }

  /* DESDE `md:` el grid pasa a dos columnas y el bloque llena su rectángulo
   * completo del marco — el que en el boceto va rayado:
   *  - Izquierda: mitad del `gap-12` → cae en el 50% de la sección, donde está
   *    el divisor vertical. Es geometría del grid, constante.
   *  - Derecha: `--sangria-guia` → la guía derecha de página.
   *  - Arriba y abajo: el `pt`/`pb` de la sección → las dos reglas de
   *    `MarcoSeccion`. */
  @media (min-width: 768px) {
    .form-a-la-guia {
      margin-top: -120px;
      padding-top: calc(120px + 2.5rem);
      margin-inline-start: -1.5rem;
      padding-inline-start: 2.5rem;
      margin-inline-end: calc(-1 * var(--sangria-guia));
      padding-inline-end: calc(2.5rem + var(--sangria-guia));
      margin-bottom: -2.5rem;
      padding-bottom: 5rem;
    }
  }

  /* Reveal palabra por palabra, #qs-titulo (16/08/2026, pedido explícito de
   * replicar un efecto de referencia en React/framer-motion). Mismo criterio
   * que `.w-anim` en CarruselTestimonios.astro: cada palabra en su propio
   * <span>, animando por transition (no por JS), y un `transitionDelay`
   * escalonado que arma el JS de abajo.
   *
   * Sin blur (05/09/2026, auditoría de performance): el `filter: blur(6px)`
   * por palabra, en ~60 spans a la vez, obligaba a repintar cada uno en cada
   * frame. Ahora solo opacity + translateY —propiedades que compositan—, con
   * el mismo escalonado y la misma duración. */
  #qs-titulo :global(.w-anim-qs) {
    display: inline-block;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #qs-titulo.is-in :global(.w-anim-qs) {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    #qs-titulo :global(.w-anim-qs) {
      transition: none;
    }
  }
</style>

<script>
  /* Reveal palabra por palabra de #qs-titulo, sin React/framer-motion — ver
   * el comentario en el markup del <h2>. Mismo patrón que el script de
   * CarruselTestimonios.astro (split en palabras, span por palabra,
   * transitionDelay escalonado), pero disparado por IntersectionObserver en
   * vez de por cambio de slide. */
  const qsTitulo = document.getElementById('qs-titulo');

  if (qsTitulo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const palabras = (qsTitulo.textContent ?? '').trim().split(/\s+/);
    qsTitulo.textContent = '';
    palabras.forEach((palabra, i) => {
      const span = document.createElement('span');
      span.className = 'w-anim-qs';
      span.textContent = palabra;
      span.style.transitionDelay = `${i * 0.05}s`;
      qsTitulo.append(span);
      if (i < palabras.length - 1) qsTitulo.append(document.createTextNode(' '));
    });

    if ('IntersectionObserver' in window) {
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (!entrada.isIntersecting) continue;
            qsTitulo.classList.add('is-in');
            observador.unobserve(entrada.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      observador.observe(qsTitulo);
    } else {
      qsTitulo.classList.add('is-in');
    }
  }
</script>
