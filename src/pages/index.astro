---
import Layout from '@/layouts/main.astro';
import HeroVideo from '@/components/astro/HeroVideo.astro';
import Boton from '@/components/astro/Boton.astro';
import Eyebrow from '@/components/astro/Eyebrow.astro';
import BarraEstadisticas from '@/components/astro/BarraEstadisticas.astro';
import TarjetaObraHover from '@/components/astro/TarjetaObraHover.astro';
import CarruselTestimonios from '@/components/astro/CarruselTestimonios.astro';
import GrillaLogos from '@/components/astro/GrillaLogos.astro';
import GrillaServicios from '@/components/astro/GrillaServicios.astro';
import HojaTecnica from '@/components/astro/HojaTecnica.astro';
import MarcoSeccion from '@/components/astro/MarcoSeccion.astro';
import FranjaRayado from '@/components/astro/FranjaRayado.astro';
import type { Servicio } from '@/components/astro/GrillaServicios.astro';
import elAromo5 from '@/assets/obras/el-aromo-5.png';
import tacuari1 from '@/assets/obras/tacuari-1050-1.jpg';
import pruneHome from '@/assets/obras/prune-home.jpeg';
import FormularioConsulta from '@/components/astro/FormularioConsulta.astro';
import TimelineContacto from '@/components/astro/TimelineContacto.astro';
/* Compartida con la cabecera de /nosotros (23/08/2026): antes existía dos
 * veces en el repo, byte por byte igual, como `intro/servicios.webp` acá y
 * `paginas/nosotros-cabecera.webp` allá. Se unificó bajo un nombre que
 * describe la foto y no el lugar donde se usa. El `alt` sí es distinto en
 * cada página, porque el contexto de lectura es distinto. */
import quienesSomosImg from '@/assets/paginas/obra-corporativa.webp';
import hormigonSombra from '@/assets/contacto/hormigon-sombra.png';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';

const destacadas = (await getCollection('obras', (o) => o.data.destacadaEnHome)).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);

// El texto del testimonio es el cuerpo del .md, así que hay que renderizarlo acá.
// La colección está vacía a propósito (§6.3): la Sección 7 no se renderiza hasta
// que haya testimonios reales cargados.
const testimoniosEntries = (await getCollection('testimonios')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const testimonios = await Promise.all(
  testimoniosEntries.map(async (t) => ({ entry: t, Contenido: (await render(t)).Content })),
);

/* Imágenes de fondo propias de algunas destacadas del Home: fotos horizontales
 * que funcionan mejor en el recorte 4:3 de la tarjeta con hover que la `portada`
 * de la colección (que se sigue usando en /obras). Es un override opcional —
 * las obras que no estén acá caen en su propia `portada`, así que agregar una
 * destacada en el contenido no rompe el build. */
const fondoDestacada: Record<string, { imagen: ImageMetadata; alt: string }> = {
  'el-aromo': {
    imagen: elAromo5,
    alt: 'Fachada y pileta de El Aromo, Escobar, donde NEST construyó una vivienda premium',
  },
  'tacuari-1051': {
    imagen: tacuari1,
    alt: 'Edificio Tacuarí 1050, obra de NEST en CABA',
  },
  prune: {
    imagen: pruneHome,
    alt: 'Local de PRÜNE terminado por NEST, una de las 10 sucursales de la expansión',
  },
};

/* OJO CON LAS CLAVES: son el `id` de la entrada, y el glob loader de Astro usa
 * como `id` el `slug` del frontmatter cuando existe, NO el nombre del archivo.
 * `tacuari-1050.md` declara `slug: tacuari-1051`, así que su id es
 * `tacuari-1051`. Una clave que no matchea no rompe nada: cae al `??` de abajo
 * y la tarjeta muestra la `portada` de la colección, en silencio. Ya pasó una
 * vez (23/08/2026, al publicar la página propia de Tacuarí). Esta guarda lo
 * convierte en error de build en vez de un cambio de foto que nadie nota. */
const idsDestacadas = new Set(destacadas.map((o) => o.id));
const clavesHuerfanas = Object.keys(fondoDestacada).filter((k) => !idsDestacadas.has(k));
if (clavesHuerfanas.length) {
  throw new Error(
    `fondoDestacada tiene claves que no son id de ninguna obra destacada: ` +
      `${clavesHuerfanas.join(', ')}. Los ids actuales son: ${[...idsDestacadas].join(', ')}. ` +
      `Recordá que el id sale del \`slug\` del frontmatter si está definido.`,
  );
}

const tipoLabel: Record<string, string> = {
  vivienda: 'Vivienda',
  corporativo: 'Corporativo',
  refaccion: 'Refacción',
  gastronomia: 'Gastronomía',
  edificio: 'Edificio',
};

const tarjetasDestacadas = destacadas.map((o) => {
  const fondo = fondoDestacada[o.id];
  return {
    nombre: o.data.nombre,
    tipoLabel: tipoLabel[o.data.tipo],
    zona: o.data.zona,
    href: o.data.paginaPropia && o.data.slug ? `/obras/${o.data.slug}` : '/obras',
    imagen: fondo?.imagen ?? o.data.portada,
    imagenAlt: fondo?.alt ?? o.data.portadaAlt,
  };
});

/* `icono` se agregó con las tarjetas del proto (07/08/2026). Sin `href`: las
 * tarjetas ya no llevan CTA propio (08/08/2026). */
const serviciosHome: Servicio[] = [
  {
    titulo: 'Viviendas y Refacciones',
    texto:
      'Casas llave en mano, ampliaciones y refacciones en barrios cerrados y zonas premium. De principio a fin, con un solo responsable.',
    icono: 'vivienda',
  },
  {
    titulo: 'Proyectos Corporativos',
    texto:
      'Oficinas y locales comerciales. Cumplimos plazos ajustados sin interrumpir tu operación. 10 sucursales PRÜNE en 40 días.',
    icono: 'corporativo',
  },
  {
    titulo: 'Dirección de Obra',
    texto:
      'Asesoramiento técnico, control de presupuesto y gestión integral. Nos hacemos cargo de supervisar, coordinar y controlar la ejecución de tu proyecto.',
    icono: 'direccion',
  },
];

const bloquesDeConfianza = [
  {
    titulo: 'Respuesta en el día',
    texto:
      'En horario hábil respondemos en menos de 24 horas. Sin bots, sin formularios interminables.',
  },
  {
    titulo: 'Sin compromiso',
    texto: 'La primera consulta es sin costo. Nos contás, nosotros escuchamos y te orientamos.',
  },
  {
    titulo: 'Atención personalizada',
    texto: 'Hablás directamente con uno de los socios, no con un vendedor.',
  },
];

const seo = {
  title: 'NEST | Constructora premium en Zona Norte y CABA | Viviendas y proyectos',
  description:
    'Constructora con +30 años, +80 proyectos y clientes como WeWork y PRÜNE. Viviendas premium y proyectos corporativos en Zona Norte y CABA. Consulta sin compromiso.',
};
---

<Layout title={seo.title} description={seo.description}>
  {/* Sección 1 — Hero. El LCP es el <h1>. El video del fondo es un <video>
      nativo propio, con autoplay en todos los anchos desde el 18/08/2026
      (public/hero-video.mp4 desktop, public/hero-video-mobile.mp4 recortado
      9:16 y liviano para mobile) — solo se corta con `prefers-reduced-motion`.
      El porqué, incluida la historia de los dos intentos de embed de YouTube
      que se probaron y revirtieron, está en HeroVideo.astro y en
      docs/DEUDA-TECNICA.md §5.
      El overlay es negro/50 (feedback del cliente, 14/08/2026): antes era
      navy/50 para leer como una sola superficie con el header en reposo
      (Nav.astro también navy), pero el cliente pidió un velo neutro sobre el
      video en vez de un tinte de marca. `bg-black` en el fallback de la
      sección por la misma razón — es lo que se ve un instante antes de que
      cargue el primer frame del video. */}
  <section class="relative isolate flex min-h-dvh items-center overflow-hidden bg-black">
    <HeroVideo
      srcDesktop="/hero-video.mp4"
      srcMobile="/hero-video-mobile.mp4"
      poster="/hero-poster.jpg"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="hero-overlay absolute inset-0 -z-10 bg-black/50"></div>
    <div class="mx-auto w-full max-w-6xl px-6 py-20 md:py-[120px] text-white">
      {/* ESCALONADO DEL HERO (corregido el 18/08/2026). Antes estos cuatro
          bloques llevaban `delay-100`/`delay-200`/`delay-300`, que es
          `transition-delay` — y acá la entrada es una ANIMACIÓN
          (`animate-[reveal-up…]`), no una transición, así que ese delay no
          hacía nada: los cuatro entraban exactamente al mismo tiempo. De ahí
          que la entrada se leyera "muy rápida" aunque se subiera la duración.
          Ahora el delay va como segundo valor de tiempo del shorthand de
          `animation` (`reveal-up 1.1s 0.25s …`), que es donde el navegador lo
          lee — el mismo patrón que ya usaba la línea de arena de abajo.

          La cadena queda: eyebrow 0s → h1 0s → línea 0.6s → párrafo 0.5s →
          botones 0.75s, con 1.1s de duración cada uno.

          El <h1> es la LCP de la ruta y va aparte (05/09/2026, auditoría de
          performance): Chrome no cuenta como LCP un elemento con opacity 0 y
          corría el timestamp al primer frame visible (0.25s de delay + el
          fade). Por eso NO usa `reveal-up` (opacity+translate): anima solo
          `transform` con el keyframe `lcp-up` de global.css, sin
          delay y sin arrancar en `opacity-0`. El resto de los bloques mantiene
          su escalonado tal cual.

          0.8125rem = 13px, 2px más que el 11px del componente. El `!` es
          necesario porque el tamaño base de Eyebrow también es un valor
          arbitrario: sin él, cuál gana depende del orden del CSS generado. */}
      <Eyebrow
        sobreNavy
        class="mb-3 text-[0.8125rem]! opacity-0 motion-safe:animate-[reveal-up_1.1s_cubic-bezier(0.22,1,0.36,1)_forwards] motion-reduce:opacity-100"
        >Constructora premium · Zona Norte y CABA</Eyebrow
      >
      <h1
        class="max-w-3xl text-hero font-normal motion-safe:animate-[lcp-up_1.1s_cubic-bezier(0.22,1,0.36,1)_both]"
      >
        Tu obra en manos expertas <br class="hidden lg:block" />
        <span class="subrayado-hero inline-block whitespace-nowrap">de principio a fin.</span>
      </h1>
      <div
        class="mt-4 h-0.5 w-32 origin-left scale-x-0 bg-arena motion-safe:animate-[hero-rule_1s_0.6s_cubic-bezier(0.22,1,0.36,1)_forwards] motion-reduce:scale-x-100"
        aria-hidden="true"
      >
      </div>
      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-navy-100 opacity-0 motion-safe:animate-[reveal-up_1.1s_0.5s_cubic-bezier(0.22,1,0.36,1)_forwards] motion-reduce:opacity-100"
      >
        30 años construyendo casas y proyectos que cumplen plazo, presupuesto y los más altos
        estándares. Con un equipo que te acompaña desde el primer trazo.
      </p>
      <div
        class="mt-8 flex flex-wrap gap-4 opacity-0 motion-safe:animate-[reveal-up_1.1s_0.75s_cubic-bezier(0.22,1,0.36,1)_forwards] motion-reduce:opacity-100"
      >
        {/* backdrop-blur-md! pisa el backdrop-blur-2xl de la variante primario
            (Boton.astro): con el `!` de Tailwind, solo para este botón del
            Hero — el resto de los usos de "primario" quedan en 2xl. */}
        <Boton
          href="/contacto"
          variante="primario"
          class="backdrop-blur-md!"
          data-evento="cta_contacto"
          data-evento-lugar="home_hero"
        >
          Consulta tu proyecto
        </Boton>
        <Boton href="/obras" variante="sobreNavy">Ver obras</Boton>
      </div>
    </div>

    <a
      href="#stats"
      aria-label="Desplazate para ver más"
      class="group absolute inset-x-0 bottom-8 flex justify-center"
    >
      <span class="flex flex-col items-center justify-center gap-0.5 text-white transition-colors group-hover:text-arena">
        {
          [0, 1].map((i) => (
            <svg
              width="36"
              height="36"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="motion-safe:animate-[chevron-caida_1.6s_ease-in-out_infinite] motion-reduce:opacity-100"
              style={{ animationDelay: `${i * 0.3}s` }}
            >
              <path d="M6 9l6 6 6-6" />
            </svg>
          ))
        }
      </span>
    </a>
  </section>

  {/* Sistema de marco "hoja técnica" (15/08/2026, pedido de la usuaria).
      Todo el cuerpo del documento —de Estadísticas a Contacto— vive dentro de
      un único <HojaTecnica>, así las dos guías verticales son DOS ELEMENTOS
      ÚNICOS que miden el 100% del bloque: no se reinician ni se cortan en
      ninguna junta de sección. El hero queda afuera a propósito (ver
      HojaTecnica.astro: un trazo #EEEEEE sobre el video oscuro deja de ser una
      guía subliminal y pasa a ser una línea blanca de alto contraste, además de
      competir con la ventana del isotipo del overlay). El footer, navy sólido,
      queda afuera por el motivo simétrico.

      Cada sección va envuelta en <MarcoSeccion>. La regla horizontal es siempre
      la del borde SUPERIOR; `cierra` agrega la inferior solo donde la cadena de
      secciones se interrumpe (antes de una franja, o al final). Así cada junta
      tiene exactamente una línea de 1px y el contorno se lee parejo de punta a
      punta.

      Las <FranjaRayado> son tres y marcan cambio de capítulo, no separación de
      sección: quiénes somos → qué hacemos → con quiénes → contacto. */}
  <HojaTecnica>
    {/* Sección 2 — Estadísticas. id="stats" es el destino de la flecha del hero.
      Fondo blanco (14/08/2026, unificación de fondos de sección pedida por la
      usuaria): antes era una banda navy. `sobreBlanco` en BarraEstadisticas
      adapta su croma interna (el valor destacado pasa de arena a navy — arena
      sobre blanco falla WCAG, §1.2 — y la etiqueta de navy-200 a navy-700 para
      seguir siendo legible). `/nosotros` sigue usando el componente sin el
      prop, sobre su propia banda navy. */}
  <MarcoSeccion>
    <section id="stats" class="bg-white py-20 md:py-[120px]">
      <div class="mx-auto max-w-6xl px-6" data-reveal>
        <BarraEstadisticas sobreBlanco />
      </div>
    </section>
  </MarcoSeccion>

  {/* Sección 3 — Intro. El subheader vuelve a ser un eyebrow común (14/08/2026):
      antes el "Quiénes somos" se repetía gigante y a baja opacidad como fondo
      decorativo (mismo lenguaje que el número de CarruselTestimonios) y el
      eyebrow real quedaba sr-only. El cliente pidió sacar ese recurso y tratar
      el subheader como en el resto del sitio — mismo patrón que usa la
      Sección 7 (Testimonios): Eyebrow visible + h2 debajo.

      La foto es la protagonista visual de esta sección (spec del cliente,
      14/08/2026): el párrafo baja de `text-h3` (escala de heading) a `text-lg`,
      un cuerpo de texto de lectura, para no competirle tamaño a la imagen.

      Fondo blanco (14/08/2026, unificación de fondos): antes era banda navy,
      con Eyebrow/h2/párrafo en sus variantes claras (sobreNavy, blanco,
      navy-100). Pasan a las variantes de fondo claro del resto del sitio. */}
  <MarcoSeccion cierra>
  <section class="bg-white">
    {/* El padding derecho es justo lo que separa el borde del contenedor de la
        guía derecha de página, para que la imagen muera exactamente sobre la
        línea del marco (desktop desde el 16/08/2026, mobile desde el
        18/08/2026 por pedido explícito):

         - En desktop da 0: la guía YA cae sobre el borde del `max-w-6xl`.
         - En mobile da `--guia-margen`: ahí el contenedor ocupa todo el ancho
           y la guía queda adentro de su borde, así que sin este padding la
           imagen se pasaba hasta el borde del viewport.

        Sale de `1.5rem - var(--sangria-guia)`, que es exactamente esa
        distancia en los dos regímenes (ver `--sangria-guia` en `global.css`).
        El `pl-6` se queda: es el margen del texto, alineado con el resto de la
        página. */}
    <div
      class="mx-auto grid max-w-6xl items-stretch gap-12 pr-[calc(1.5rem-var(--sangria-guia))] pl-6 md:grid-cols-2"
    >
      {/* `self-center` (16/08/2026): con el grid en `items-stretch` la celda de
          texto mide lo mismo que la imagen (más alta que su propio contenido),
          y sin esto el bloque Eyebrow+h2+párrafo quedaba pegado arriba. Centra
          el CONTENIDO dentro de la celda sin tocar `items-stretch` del grid
          padre — eso volvería a achicar la imagen a la altura del texto.

          `pt-20` solo en mobile (18/08/2026, pedido explícito): ahí la sección
          no tiene padding vertical propio y el texto quedaba pegado a la regla
          superior del marco. En desktop no hace falta — el `self-center` ya lo
          separa, porque la celda es más alta que su contenido. */}
      <div class="self-center pt-20 md:pt-0" data-reveal>
        <Eyebrow class="mb-2.5">Quiénes somos</Eyebrow>
        {/* Un solo título, sin párrafo de descripción aparte (16/08/2026,
            pedido explícito): el texto que antes vivía en el <p> se suma
            adentro del propio <h2>, sin agregar copy nuevo. */}
        {/* `id="qs-titulo"` (16/08/2026, pedido explícito): reveal palabra por
            palabra (opacity + translateY; el blur original se sacó el
            05/09/2026 por costo de pintado), mismo criterio que `.w-anim` en
            CarruselTestimonios.astro pero sin React/framer-motion — el
            pedido original era un componente `"use client"` con
            framer-motion, imposible acá (§7.1 del plan: cero `client:*`,
            JS < 5KB/ruta, solo scripts inline). El script de abajo hace lo
            mismo con DOM plano. */}
        <h2 id="qs-titulo" class="max-w-[640px] text-[24px] font-normal text-navy">
          Más de 30 años construyendo lo que prometemos. NEST es una empresa constructora
          especializada en viviendas premium, refacciones y proyectos corporativos en Zona Norte de
          GBA y CABA. Combinamos ingeniería de primer nivel con acompañamiento personalizado para que
          tu obra sea una experiencia sin sorpresas, desde el primer trazo hasta la llave en la mano.
        </h2>
      </div>

      {/* Sin `aspect-[4/3]` (16/08/2026): antes la imagen tenía una relación de
          aspecto fija que, con `items-center` en el grid padre, la dejaba más
          baja que la columna de texto y centrada con aire arriba/abajo. Ahora
          el contenedor toma `h-full` y el grid pasa a `items-stretch` (default,
          pero explícito acá) para que ambas columnas compartan la altura real
          de la fila — `object-cover` en la imagen interna se encarga del
          recorte sin distorsión. */}
      {/* En mobile la imagen también se estira hasta la guía IZQUIERDA
          (18/08/2026, pedido explícito de que llegue al marco): el `pl-6` del
          grid es el margen del texto y ahí se queda, así que la imagen lo
          cancela con un margen negativo de `--sangria-guia` — la misma
          distancia contenido-a-guía que usan el formulario y las líneas del
          timeline. Desde `md:` se desactiva: ahí la imagen es la columna
          derecha y a su izquierda está el texto, no una línea del marco. */}
      {/* SIN `w-full` a propósito: con un ancho fijo al 100% del área, el
          margen negativo DESPLAZA la caja hacia la izquierda en vez de
          agrandarla, y el borde derecho se iba 12px adentro de la guía. Con
          ancho automático, el ítem del grid se estira para llenar su área y el
          margen negativo lo extiende. */}
      <div
        class="h-full overflow-hidden rounded-boton ml-[calc(-1*var(--sangria-guia))] md:ml-0"
        data-reveal
      >
        <Image
          src={quienesSomosImg}
          alt="Obra de NEST en desarrollo"
          widths={[400, 640, 960]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="h-full w-full object-cover grayscale transition-[filter] duration-300 hover:grayscale-0"
        />
      </div>
    </div>
  </section>
  </MarcoSeccion>

  {/* Cierre del capítulo "quiénes somos". */}
  <FranjaRayado />

  {/* Sección 4 — Servicios destacados (3). El marco de GrillaServicios se
      unificó (16/08/2026) con el sistema HojaTecnica/MarcoSeccion: reglas y
      escuadras en `--marco-x` (relativo a 100% de la sección, sin `100vw`),
      así que ya no sangra por fuera del contenedor y no hace falta
      `overflow-x-clip` — el bug de scroll horizontal que forzaba a recortar
      era del sistema viejo (`50vw`/`100vw` fijos).

      Subheader estándar (14/08/2026): antes tenía el mismo recurso
      tipográfico de fondo que la Sección 3, retirado en toda la Home — ver
      esa sección para el detalle de la decisión. Mismo patrón que el resto:
      Eyebrow visible + h2. */}
  <MarcoSeccion>
  <section class="bg-white pt-20 md:pt-[120px]">
    <div class="mx-auto max-w-6xl px-6">
      {/* Eyebrow y h2 comparten wrapper: `data-reveal` va en elementos del
          markup de esta página, y Eyebrow es un componente que solo acepta
          `class`. Entran juntos como un bloque de encabezado. */}
      <div data-reveal>
        <Eyebrow class="mb-2.5">Servicios</Eyebrow>
        <h2 class="text-h2 font-normal text-navy">Lo que construimos</h2>
      </div>
    </div>
    {/* GrillaServicios queda fuera del contenedor `max-w-6xl px-6`: su propio
        marco necesita medir 100% contra la sección (full-bleed) para que las
        escuadras caigan sobre las mismas guías que el resto de la página —
        el `max-w-6xl` interno para la grilla de tarjetas lo pone el propio
        componente. Ver comentario de `.bp-frame` en GrillaServicios.astro. */}
    <div class="mt-4" data-reveal>
      <GrillaServicios servicios={serviciosHome} />
    </div>
  </section>
  </MarcoSeccion>

  {/* Separación con Obras destacadas (16/08/2026, pedido explícito): sin
      padding inferior propio (arriba, `pt` solo), el corte con la siguiente
      sección lo marca esta franja de 80px en vez de aire en blanco — mismo
      recurso que las otras franjas de "cambio de capítulo", con la altura
      fija en `!h-20` en vez de la escala responsive por defecto del
      componente (32/48/68px), porque acá se pidió un tamaño concreto. */}
  <FranjaRayado class="!h-20" />

  {/* Sección 5 — Obras destacadas (3). Subheader estándar (14/08/2026): antes
      tenía el eyebrow "Portfolio" repetido en gran escala como fondo, retirado
      en toda la Home — ver Sección 3 para el detalle.

