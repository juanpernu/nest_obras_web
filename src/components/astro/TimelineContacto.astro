---
/**
 * Columna editorial de la Sección 9 — Contacto (10/08/2026, spec del cliente).
 * Timeline de 3 atributos con nodos sobre una línea vertical de referencia,
 * que interrumpen las líneas horizontales al superponerse (z-index), seguido de
 * un separador y los datos de contacto con ícono.
 *
 * Todas las líneas son sólidas desde el 15/08/2026 (antes eran dasheadas, por
 * `repeating-linear-gradient`): se sacó el dasheado de todo el sitio a favor
 * del sistema de marco "hoja técnica". Siguen enmascaradas para desvanecerse en
 * los extremos en vez de cortar en seco, igual que el reticulado de GrillaLogos
 * y el marco de GrillaServicios, pero acá puertas adentro de la columna en vez
 * de sangrando fuera de ella.
 *
 * Los dos niveles del sistema se ven bien acá: la vertical es ESTRUCTURA —une
 * los tres nodos, si no se lee el timeline deja de existir— y por eso va en
 * navy a baja opacidad; las horizontales son separadores y van en la regla
 * casi subliminal (`--color-rule`), como el resto del marco.
 *
 * El NAP (teléfono, email, dirección) sale de site.ts, nunca hardcodeado, para
 * ser idéntico carácter por carácter en todos lados (§6.7).
 */
import { site, telUrl } from '@/data/site';

interface Atributo {
  titulo: string;
  texto: string;
}

interface Props {
  atributos: Atributo[];
  class?: string;
}
const { atributos, class: className } = Astro.props as Props;
---

<div class:list={[className]}>
  {/* Sin línea vertical, sin líneas horizontales entre filas, sin nodos
      (16/08/2026, pedido explícito): antes cada fila tenía un separador
      horizontal con un punto de referencia y una línea vertical de fondo
      uniéndolos, todo el "timeline" visual. Ahora son bloques de texto
      apilados en flujo simple, sin ningún trazo decorativo.

      El contenedor solo existe si hay atributos: /contacto monta este
      componente con `atributos={[]}` —renderiza los suyos aparte y usa esto
      solo por el bloque de NAP— y sin el guard quedaba un <div> vacío en el
      HTML, además de sumarle su `mt-8` al margen del uso. */}
  {
    atributos.length > 0 && (
      <div class="tl-lista flex flex-col">
        {/* Líneas horizontales entre filas, no un marco con esquinas
            (18/08/2026, corregido contra boceto de la usuaria: franjas
            simples arriba de la primera fila, entre cada fila, y debajo de
            la última — sin escuadras). `--color-rule`, mismo trazo que el
            resto del marco de página, vía `border-top` en cada fila +
            `border-bottom` en el contenedor (el `border-top` de la primera
            fila hace de línea superior). */}
        {atributos.map((a) => (
          <div class="tl-fila flex items-center gap-3 py-4">
            {/* Check en arena a la izquierda de cada atributo (18/08/2026,
                pedido explícito), centrado con el bloque de texto
                (`items-center` en el flex padre). Mismo trazo (viewBox 24,
                stroke 1.5, puntas redondas) que el resto de los íconos del
                sitio. */}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5 flex-none text-arena"
              aria-hidden="true"
            >
              <path d="M4.5 12.75l5.25 5.25L19.5 6.75" />
            </svg>
            <div>
              <h3 class="font-medium text-navy">{a.titulo}</h3>
              <p class="mt-1 text-sm leading-relaxed text-navy-700">{a.texto}</p>
            </div>
          </div>
        ))}
      </div>
    )
  }

  <p
    class:list={[
      'text-sm font-medium uppercase tracking-[0.06em] text-navy-700',
      atributos.length > 0 && 'mt-8',
    ]}
  >
    También nos podés contactar por:
  </p>
  <address class="mt-4 flex flex-col gap-5 not-italic">
    <a href={telUrl} class="tl-dato flex items-center gap-3 text-navy">
      <span class="tl-icono" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6.5 4h3l1.5 4-2 1.5a11 11 0 0 0 5.5 5.5L16 13l4 1.5v3a2 2 0 0 1-2 2A15 15 0 0 1 4.5 6a2 2 0 0 1 2-2Z" />
        </svg>
      </span>
      <span class="text-sm">{site.whatsapp.display}</span>
    </a>
    <a href={`mailto:${site.email}`} class="tl-dato flex items-center gap-3 text-navy">
      <span class="tl-icono" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3.5 6.5 8.5 6 8.5-6" />
        </svg>
      </span>
      <span class="text-sm">{site.email}</span>
    </a>
    {
      site.direccion && (
        <div class="flex items-center gap-3 text-navy">
          <span class="tl-icono" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z" />
              <circle cx="12" cy="9.5" r="2.25" />
            </svg>
          </span>
          <span class="text-sm">{site.direccion.display}</span>
        </div>
      )
    }
  </address>
</div>

<style>
  /* Líneas entre filas de los atributos (18/08/2026, corregido contra el
   * boceto de la usuaria): franjas horizontales en `--color-rule`, una arriba
   * de cada fila más una abajo de la última — no un marco con esquinas.
   * `border-top` en cada `.tl-fila` + `border-bottom` en el contenedor: la
   * primera fila aporta la línea superior, cada fila siguiente aporta el
   * divisor con la anterior, y el contenedor cierra con la inferior.
   *
   * SANGRÍA A LOS DOS LADOS — es lo que hace que las líneas se "enganchen" al
   * marco de página en vez de flotar adentro de la columna, que era el error
   * de la primera versión. Los dos lados miden distinto porque terminan en
   * cosas distintas:
   *
   *  - A la IZQUIERDA, `--sangria-guia`: la línea tiene que morir sobre la
   *    guía de página. Ese valor NO es siempre el `px-6` del contenedor —
   *    abajo de 1192px la guía queda adentro de ese borde— y por eso sale de
   *    una variable con dos regímenes en vez de un `-1.5rem` fijo, que era el
   *    bug (20px de más en pantallas medianas). Ver `--sangria-guia` en
   *    `global.css`.
   *  - A la DERECHA, `1.5rem` fijo: acá no hay guía de por medio. Con
   *    `md:grid-cols-2` + `gap-12`, el borde derecho de esta columna cae en
   *    `50% - 1.5rem` de la sección (la mitad del gap de 3rem), así que
   *    sangrar exactamente la mitad del gap la lleva al 50%, donde va el
   *    divisor vertical entre columnas (ver `index.astro`). Es geometría del
   *    grid, no del marco, y por eso es constante.
   *
   * El `padding` compensa el `margin` negativo para que el texto no se mueva:
   * lo único que se extiende es la caja que dibuja el borde. */
  .tl-lista,
  .tl-fila {
    margin-inline-start: calc(-1 * var(--sangria-guia));
    padding-inline-start: var(--sangria-guia);
    margin-inline-end: -1.5rem;
    padding-inline-end: 1.5rem;
  }
  .tl-lista {
    border-bottom: 1px solid var(--color-rule);
  }
  .tl-fila {
    border-top: 1px solid var(--color-rule);
  }

  /* Contenedor arena para los íconos de contacto, mismo lenguaje que la
   * píldora de ícono de GrillaServicios — fondo arena-200, sin borde
   * (18/08/2026, pedido explícito: "quitar el stroke a estos contenedores").
   * Más chico porque acá conviven en una fila junto al texto, no como bloque
   * destacado. */
  .tl-icono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    border-radius: var(--radius-boton);
    background-color: var(--color-arena-200);
    color: var(--color-navy);
  }
  .tl-icono svg {
    width: 18px;
    height: 18px;
  }

  .tl-dato {
    transition: color 0.2s;
  }
  .tl-dato:hover {
    color: var(--color-arena-800);
  }
</style>
