---
/**
 * Variante de TarjetaObra SOLO para las destacadas del Home (§5.1 Sección 5).
 * El texto vive dentro del hover, por eso el título va en el HTML inicial igual
 * (opacity 0, no display:none) y sirve de nombre accesible del link. /obras
 * sigue usando TarjetaObra.astro sin cambios.
 *
 * Reemplaza al componente React `DirectionAwareHover` (framer-motion): el efecto
 * ahora es CSS puro, sin `client:*` ni JS. Se pierde el cálculo de dirección por
 * cuadrante del cursor —imposible sin JS— y queda la dirección `bottom` fija,
 * que era ya la que el original usaba para el foco de teclado y la que apunta a
 * donde vive el texto.
 *
 * `imagen` va por getImage() y no por <Picture>: necesitamos una sola URL final
 * para el recorte 4:3 hecho en build.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  nombre: string;
  tipoLabel: string;
  zona: string;
  href: string;
  imagen: ImageMetadata;
  imagenAlt: string;
}

const { nombre, tipoLabel, zona, href, imagen, imagenAlt } = Astro.props as Props;

/* Recorte a 4:3 en build, no con object-cover: hay fotos verticales y servirlas
 * enteras descartaba ~60% de los bytes descargados. 1216 = ancho de la tarjeta
 * en desktop (608px) a 2x. */
const optimizada = await getImage({
  src: imagen,
  format: 'webp',
  width: 1216,
  height: 912,
  fit: 'cover',
  position: 'center',
  quality: 72,
});
---

<article>
  <a href={href} class="tarjeta aspect-[4/3] sm:aspect-auto sm:h-[600px]">
    <div class="marco">
      <img
        src={optimizada.src}
        alt={imagenAlt}
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
      />
    </div>

    {/* Velo navy al 30% visible en reposo. En hover/foco cede al degradé. */}
    <div aria-hidden="true" class="velo-plano"></div>
    {/* Degradé navy/70 → transparente: deja ver la imagen arriba sin perder la
     * legibilidad del texto, que vive abajo. Peor caso (imagen blanca) da
     * 5.41:1 contra texto blanco. */}
    <div aria-hidden="true" class="velo-degrade"></div>

    <div class="texto">
      <h3 class="text-h3 font-medium">{nombre}</h3>
      <p class="mt-1 text-sm uppercase tracking-[0.06em]">{tipoLabel} · {zona}</p>
    </div>
  </a>
</article>

<style>
  .tarjeta {
    position: relative;
    display: block;
    overflow: hidden;
    background-color: var(--color-navy);
  }

  .tarjeta:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 2px;
  }

  .marco {
    position: relative;
    height: 100%;
    width: 100%;
  }

  /* scale(1.15) deja 15% de sobrante: el desplazamiento de 20px del hover nunca
   * descubre el borde de la imagen. */
  .marco img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    scale: 1.15;
  }

  .velo-plano,
  .velo-degrade {
    position: absolute;
    inset: 0;
    z-index: 10;
  }

  .velo-plano {
    background-color: color-mix(in srgb, var(--color-navy) 30%, transparent);
    opacity: 1;
  }

  .velo-degrade {
    background-image: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-navy) 70%, transparent),
      transparent
    );
    opacity: 0;
  }

  .texto {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    z-index: 20;
    color: #fff;
    opacity: 0;
  }

  .tarjeta:hover .velo-plano,
  .tarjeta:focus-visible .velo-plano {
    opacity: 0;
  }

  .tarjeta:hover .velo-degrade,
  .tarjeta:focus-visible .velo-degrade,
  .tarjeta:hover .texto,
  .tarjeta:focus-visible .texto {
    opacity: 1;
  }

  /* El fade informa el estado y va siempre; el desplazamiento es decorativo y
   * solo corre si no se pidió menos movimiento. */
  @media (prefers-reduced-motion: no-preference) {
    .marco {
      transition: translate 200ms ease-out;
    }

    .velo-plano,
    .velo-degrade {
      transition: opacity 300ms ease-out;
    }

    .texto {
      translate: 0 0.5rem;
      transition:
        opacity 500ms ease-out,
        translate 500ms ease-out;
    }

    .tarjeta:hover .marco,
    .tarjeta:focus-visible .marco {
      translate: 0 -20px;
    }

    .tarjeta:hover .texto,
    .tarjeta:focus-visible .texto {
      translate: 0 0;
    }
  }

  /* Sin hover (touch) el nombre de la obra jamás se revelaría: se muestra de
   * entrada, igual que hacía el <noscript> de la versión con JS. */
  @media (hover: none) {
    .velo-plano {
      opacity: 0;
    }

    .velo-degrade,
    .texto {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
