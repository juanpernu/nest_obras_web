---
/**
 * Variante de TarjetaObra SOLO para las 2 destacadas del Home (§5.1 Sección 5).
 * El texto vive dentro del hover direction-aware, por eso el título va en el
 * HTML inicial igual (opacity 0, no display:none) y sirve de nombre accesible
 * del link. /obras sigue usando TarjetaObra.astro sin cambios.
 *
 * `imagen` va por getImage() y no por <Picture>: el componente React recibe
 * `imageUrl` como string, así que optimizamos acá y le pasamos la URL final.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DirectionAwareHover from '@/components/react/DirectionAwareHover';

interface Props {
  nombre: string;
  tipoLabel: string;
  zona: string;
  href: string;
  imagen: ImageMetadata;
  imagenAlt: string;
}

const { nombre, tipoLabel, zona, href, imagen, imagenAlt } = Astro.props as Props;

/* Recorte a 4:3 en build, no con object-cover: la foto de PRUNE es vertical y
 * servirla entera descartaba ~60% de los bytes descargados. 1216 = ancho de la
 * tarjeta en desktop (608px) a 2x. */
const optimizada = await getImage({
  src: imagen,
  format: 'webp',
  width: 1216,
  height: 912,
  fit: 'cover',
  position: 'center',
  quality: 72,
});
---

<article>
  <DirectionAwareHover
    href={href}
    imageUrl={optimizada.src}
    imageAlt={imagenAlt}
    className="aspect-[4/3] sm:aspect-auto sm:h-[600px]"
    client:visible
  >
    <h3 class="text-h3 font-medium">{nombre}</h3>
    <p class="mt-1 text-sm uppercase tracking-[0.06em]">{tipoLabel} · {zona}</p>
  </DirectionAwareHover>
</article>

{/* Sin JS el hover no existe: el nombre de la obra queda visible de entrada. */}
<noscript>
  <style>
    [data-hover-texto],
    [data-hover-velo] {
      opacity: 1 !important;
    }
  </style>
</noscript>
