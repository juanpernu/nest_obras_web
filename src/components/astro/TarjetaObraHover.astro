---
/**
 * Variante de TarjetaObra SOLO para las destacadas del Home (§5.1 Sección 5).
 * El texto vive dentro del hover, por eso el título va en el HTML inicial igual
 * (opacity 0, no display:none) y sirve de nombre accesible del link. /obras
 * sigue usando TarjetaObra.astro sin cambios.
 *
 * Reemplaza al componente React `DirectionAwareHover` (framer-motion): el efecto
 * ahora es CSS puro, sin `client:*` ni JS. Se pierde el cálculo de dirección por
 * cuadrante del cursor —imposible sin JS— y queda la dirección `bottom` fija,
 * que era ya la que el original usaba para el foco de teclado y la que apunta a
 * donde vive el texto.
 *
 * La interacción de fila (16/08/2026) reemplaza otro componente React,
 * `FocusCards` (Aceternity): en vez de la expansión tipo galería que había
 * antes (la tarjeta apuntada crecía, las demás se encogían), ahora las
 * tarjetas no apuntadas se desenfocan con `:has()` — mismo criterio, cero JS.
 * Tamaño y blanco-y-negro/color por defecto no cambiaron, solo la animación
 * de la fila. Ver el bloque `@media (hover: hover)` en el <style>.
 *
 * `imagen` va por getImage() y no por <Picture>: necesitamos una sola URL final
 * para el recorte 4:3 hecho en build.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  nombre: string;
  tipoLabel: string;
  zona: string;
  href: string;
  imagen: ImageMetadata;
  imagenAlt: string;
}

const { nombre, tipoLabel, zona, href, imagen, imagenAlt } = Astro.props as Props;

/* Recorte a 4:3 en build, no con object-cover: hay fotos verticales y servirlas
 * enteras descartaba ~60% de los bytes descargados. 1216 = ancho de la tarjeta
 * en desktop (608px) a 2x.
 *
 * `widths` + `sizes` (05/09/2026, bug reportado: las tarjetas tardaban en
 * aparecer al scrollear en algunos teléfonos). Hasta acá se emitía UNA sola
 * variante de 1216px para todos los viewports: en un teléfono de 375px eso
 * son 95-150 KB por tarjeta (350 KB por las tres), que además recién empiezan
 * a bajar cuando `loading="lazy"` decide que la tarjeta está cerca — de ahí
 * el hueco visible en el scroll. Con srcset el teléfono pide la variante de
 * 400/800px (una fracción) y la imagen llega dentro de la ventana del lazy
 * loading. Cada variante conserva el recorte 4:3 porque getImage deriva la
 * altura de cada ancho a partir de width/height.
 *
 * `sizes`: abajo de 640px la tarjeta ocupa el ancho del viewport (menos el
 * marco). Desde 640px la fila es de tres con `height: 600px` fija, y con
 * `object-fit: cover` sobre un 4:3 el ancho que el navegador necesita para
 * llenar esos 600px es 800px (600 × 4/3) aunque la columna sea más angosta —
 * por eso el valor es 800px y no 33vw. Los 1216 cubren ese caso a 1.5x+ y el
 * escritorio ancho. */
const optimizada = await getImage({
  src: imagen,
  format: 'webp',
  width: 1216,
  height: 912,
  widths: [400, 800, 1216],
  fit: 'cover',
  position: 'center',
  quality: 72,
});
const sizes = '(min-width: 640px) 800px, 100vw';
---

<article>
  <a href={href} class="tarjeta group aspect-[4/3] sm:aspect-auto sm:h-[600px]">
    <div class="marco">
      <img
        src={optimizada.src}
        srcset={optimizada.srcSet.attribute}
        sizes={sizes}
        alt={imagenAlt}
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
        class="grayscale group-hover:grayscale-0 group-focus-visible:grayscale-0"
      />
    </div>

    {/* Degradé navy/70 → transparente, acotado al 20% inferior de la tarjeta
     * (16/08/2026, pedido explícito de la usuaria — excepción puntual a la
     * regla de "sin degradados en toda la Home" del 14/08/2026, que sigue
     * vigente para el resto del sitio). Antes era un velo PLANO que cubría el
     * 100% de la tarjeta (`inset: 0`); ahora es un gradiente de abajo hacia
     * arriba, más opaco donde vive el texto y transparente antes de llegar al
     * tope del bloque, para dejar ver la foto limpia arriba. Solo aparece en
     * hover/foco — en reposo la foto se ve entera. */}
    <div aria-hidden="true" class="velo-degrade"></div>

    <div class="texto flex items-end justify-between gap-4">
      <div>
        <h3 class="text-h3 font-medium">{nombre}</h3>
        <p class="mt-1 text-sm uppercase tracking-[0.06em]">{tipoLabel} · {zona}</p>
      </div>
      {/* "Ver más" (03/09/2026, pedido directo: "botón secundario de ver más
          con flecha en el hover, para navegar a su respectivo desglose").
          NO es un <Boton> ni un <a> propio: toda la tarjeta YA es un <a
          href> (más arriba) y anidar un segundo link adentro sería HTML
          inválido. Es un <span> con el mismo lenguaje visual que la
          variante `secundario` de Boton.astro —mayúsculas, subrayado de 3px
          que crece de izquierda a derecha en hover/foco—, reusando el
          `group` que ya tiene `.tarjeta` para que el subrayado responda al
          mismo hover/foco que revela el resto de `.texto`, sin JS ni estado
          propio. `aria-hidden`: no es información nueva para el lector de
          pantalla, el `<a>` ya anuncia el destino por su nombre accesible
          (el <h3>) — repetir "ver más" sería ruido. */}
      <span
        aria-hidden="true"
        class="ver-mas shrink-0 pb-1 text-[15px] font-medium tracking-[0.02em] uppercase"
      >
        Ver más →
      </span>
    </div>
  </a>
</article>

<style>
  /* El `border-radius: 8px` que rompía el radio cero de §3.3 se sacó el
   * 14/08/2026 (pedido directo de la usuaria de esquinas rectas en todo el
   * sitio, sin excepciones). Sin margin (16/08/2026, pedido explícito de la
   * usuaria): el margen vertical del 10/08/2026 se saca por completo. El
   * espaciado entre tarjetas apiladas en mobile ya no es responsabilidad de
   * la tarjeta individual — lo da `gap-y-8` en `.obras-fila` (index.astro),
   * así que en desktop (fila) siguen pegadas entre sí sin ningún gap. */
  .tarjeta {
    position: relative;
    display: block;
    overflow: hidden;
    background-color: var(--color-navy);
    margin: 0;
  }

  .tarjeta:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 2px;
  }

  .marco {
    position: relative;
    height: 100%;
    width: 100%;
  }

  /* scale(1.15) deja 15% de sobrante: el desplazamiento de 20px del hover nunca
   * descubre el borde de la imagen. Blanco y negro por default, color en hover
   * (14/08/2026, unificado 25/08/2026): mismo mecanismo que el resto del
   * sitio (clase `grayscale` + `group-hover:grayscale-0`, más el script
   * global de tap-to-color en main.astro para touch) — ya no un filtro CSS
   * propio de este componente. La transición de `filter` va siempre (no solo
   * con `prefers-reduced-motion: no-preference`): es un cambio de color, no de
   * movimiento. */
  .marco img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    scale: 1.15;
    transition: filter 0.3s ease-out;
  }

  /* Gradiente acotado al 20% inferior (16/08/2026): vuelve el degradado que se
   * había sacado el 14/08/2026 por pedido del cliente ("sin degradados en toda
   * la Home") — acá es una excepción puntual pedida explícitamente por la
   * usuaria para esta tarjeta, no una regresión de aquella decisión.
   *
   * NEGRO al 70%, no navy (18/08/2026, pedido explícito): tinta neutra sobre
   * la foto en vez de un tinte de marca, mismo criterio que el overlay del
   * hero (que pasó de navy a negro el 14/08/2026 por el mismo motivo). De
   * paso mejora el contraste contra el texto blanco en el peor caso —foto
   * blanca— de 5.41 a 8.5, porque el negro puro es más oscuro que el navy.
   * Hacia arriba baja a transparente: como el texto vive pegado a la base
   * (`.texto`, `bottom: 1.25rem`), queda siempre sobre la franja más opaca del
   * degradé. */
  .velo-degrade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 20%;
    z-index: 10;
    background-image: linear-gradient(to top, rgb(0 0 0 / 0.7) 0%, transparent 100%);
    opacity: 0;
  }

  .texto {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    z-index: 20;
    color: #fff;
    opacity: 0;
  }

  /* Subrayado de "Ver más" (03/09/2026): mismo mecanismo que la variante
   * `secundario` de Boton.astro (gradiente en `currentColor`, animado por
   * `background-size` en vez de `width` — no dispara layout ni necesita
   * pseudo-elemento ni JS), copiado acá porque este <span> no puede ser un
   * <Boton> (ver el comentario del markup). Arranca en 0% y crece a 100%
   * con el mismo `group-hover`/`group-focus-visible` que ya tiene `.tarjeta`. */
  .ver-mas {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 3px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s ease-out;
  }

  .tarjeta:hover .ver-mas,
  .tarjeta:focus-visible .ver-mas {
    background-size: 100% 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ver-mas {
      transition: none;
    }
  }

  .tarjeta:hover .velo-degrade,
  .tarjeta:focus-visible .velo-degrade,
  .tarjeta:hover .texto,
  .tarjeta:focus-visible .texto {
    opacity: 1;
  }

  /* El fade informa el estado y va siempre; el desplazamiento es decorativo y
   * solo corre si no se pidió menos movimiento. */
  @media (prefers-reduced-motion: no-preference) {
    .marco {
      transition: translate 200ms ease-out;
    }

    .velo-degrade {
      transition: opacity 300ms ease-out;
    }

    .texto {
      translate: 0 0.5rem;
      transition:
        opacity 500ms ease-out,
        translate 500ms ease-out;
    }

    .tarjeta:hover .marco,
    .tarjeta:focus-visible .marco {
      translate: 0 -20px;
    }

    .tarjeta:hover .texto,
    .tarjeta:focus-visible .texto {
      translate: 0 0;
    }
  }

  /* Sin hover (touch) el nombre de la obra jamás se revelaría: se muestra de
   * entrada, igual que hacía el <noscript> de la versión con JS. */
  @media (hover: none) {
    .velo-degrade,
    .texto {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* Tamaño fijo, sin la expansión tipo galería que había antes (16/08/2026,
   * pedido explícito: reemplazar SOLO la animación de hover, no el tamaño).
   * `.obras-fila` vive en index.astro, de ahí el :global. */
  article {
    min-width: 0;
  }

  @media (min-width: 640px) {
    article {
      flex: 1 1 0;
    }
  }

  /* Foco tipo "FocusCards" (16/08/2026, pedido explícito, referencia:
   * Aceternity `FocusCards`): en vez de que la tarjeta apuntada crezca y las
   * demás se encojan, ahora las OTRAS se desenfocan y la apuntada se queda
   * como está — mismo criterio de blanco y negro por defecto / color en el
   * propio hover, sin tocar eso. `:has()` en vez de JS: ya se usa el mismo
   * recurso en el filtro de /obras (`body:has(#f-...:checked)`), navegadores
   * sin soporte simplemente no aplican la regla y no pasa nada roto — la
   * tarjeta en foco siempre se ve bien, solo no se "sfuma" el resto.
   * Gateado a `(hover: hover)`: en touch no hay hover persistente y esto
   * podría dejar una tarjeta trabada "sfumada" después de un tap.
   *
   * Sin blur (05/09/2026, auditoría de performance): el `blur(4px)` sobre
   * las hermanas obligaba a repintar varias fotos grandes en cada frame de
   * la transición. El "desenfoque" ahora es grayscale + scale + una leve
   * bajada de opacity, que compositan sin repintar. */
  @media (hover: hover) {
    .marco img {
      transition:
        filter 0.3s ease-out,
        scale 0.3s ease-out,
        opacity 0.3s ease-out;
    }

    :global(.obras-fila:has(article:hover)) article:not(:hover) .marco img {
      filter: grayscale(1);
      scale: 1.1;
      opacity: 0.7;
    }
  }
</style>
