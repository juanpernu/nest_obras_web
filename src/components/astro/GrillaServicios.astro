---
/**
 * Tarjetas de servicios (§5.1 Sección 4).
 *
 * SIN LÍNEAS (15/08/2026, pedido directo: "elimina las líneas/bordes que tienen
 * los items de este contenedor"). Hasta acá el bloque llevaba el marco
 * "blueprint" portado del proto Glass (07/08/2026): dos reglas horizontales que
 * sangraban hasta el borde del viewport, cuatro verticales —las dos de los
 * extremos más un divisor de 1px entre tarjetas, como columna real de la grilla
 * y no como `gap`— y una marca de registro de 3px en cada intersección. Se fue
 * todo: reglas, verticales, divisores y marcas. Es el mismo pedido que vació de
 * líneas a GrillaLogos y a TimelineContacto el mismo día.
 *
 * Lo que SÍ se conserva es la distribución, que era la condición explícita: tres
 * columnas iguales en desktop, apiladas en mobile, y los 44px de aire arriba y
 * abajo que antes daba el sobresalir de las verticales (`--bp-over`).
 *
 * Con el marco se fue también el padding de la tarjeta (15/08/2026, segundo
 * pedido: "que ocupen, relativamente, todo el ancho del componente"). Esos 48px
 * existían para despegar el texto de los divisores verticales; sin líneas eran
 * ancho muerto y dejaban el contenido en 272px de una columna de 368px. Ahora la
 * separación la da el `gap` de la grilla y cada item ocupa su tercio completo.
 * Se fue con ellos el `background-color` blanco del hover, que además era letra
 * muerta desde que la Sección 4 pasó a fondo blanco (14/08/2026): pintaba blanco
 * sobre blanco.
 *
 * Como ya no hay divisores intercalados, las columnas se generan a partir de
 * `servicios.length` en vez del `1fr auto 1fr auto 1fr` fijo de antes, que
 * asumía exactamente tres items.
 *
 * Cromática: el acento sobre fondo claro es NAVY (§1.2, la arena sobre claro no
 * pasa WCAG); la arena queda para el fondo de la píldora del ícono, donde es
 * superficie y no trazo.
 *
 * Tipografía por tokens locales: el proto usa 22px/14px fijos y acá van
 * `text-h3` y `text-sm`, que escalan con el resto del sitio.
 *
 * Todo es CSS: sin JS y sin `client:*` (§7.1).
 */
export interface Servicio {
  titulo: string;
  texto: string;
  /** Cuál de los tres íconos del proto usar. */
  icono: 'vivienda' | 'corporativo' | 'direccion';
}

interface Props {
  servicios: Servicio[];
  class?: string;
}
const { servicios, class: className } = Astro.props as Props;
---

<div class:list={['bp-frame', className]}>
  <div class="srv-grid" style={{ '--srv-cols': String(servicios.length) }}>
    {
      servicios.map((s) => (
        <div class="srv-card">
          <span class="srv-ico" aria-hidden="true">
            {s.icono === 'vivienda' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 10.5 12 3l9 7.5" />
                <path d="M5.5 9.5V20a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V9.5" />
                <path d="M9.75 21v-6.25h4.5V21" />
              </svg>
            )}
            {s.icono === 'corporativo' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3.5 21h17" />
                <path d="M5.5 21V6.5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1V21" />
                <path d="M13.5 21V11h4.5a1 1 0 0 1 1 1v9" />
                <path d="M8 9h3M8 12.5h3M8 16h3M16 14.5h1" />
              </svg>
            )}
            {s.icono === 'direccion' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 4.5H7a1.5 1.5 0 0 0-1.5 1.5v13A1.5 1.5 0 0 0 7 20.5h10a1.5 1.5 0 0 0 1.5-1.5V6A1.5 1.5 0 0 0 17 4.5h-2" />
                <rect x="9" y="2.75" width="6" height="3.5" rx="1" />
                <path d="M8.75 11.5l1.5 1.5 3-3" />
                <path d="M14.75 16.25h1.5M8.75 16.25h3" />
              </svg>
            )}
          </span>

          <h3 class="text-h3 font-medium text-navy">{s.titulo}</h3>
          <p class="srv-desc text-sm leading-relaxed font-light text-navy-700">{s.texto}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .bp-frame {
    /* Lo que antes sobresalían las verticales por fuera de las horizontales.
     * Las líneas ya no están (15/08/2026) pero el aire sí: es el respiro que el
     * bloque tenía arriba y abajo, y sacarlo cambiaría la distribución, que era
     * justamente lo que había que conservar. */
    --bp-over: 44px;

    position: relative;
    padding: var(--bp-over) 0;
  }

  /* La separación entre items la hace el `gap`, no el padding de la tarjeta
   * (15/08/2026, pedido: "los 3 items separalos en 3 columnas que ocupen,
   * relativamente, todo el ancho del componente"). Antes era `gap: 0` y cada
   * `.srv-card` traía 48px de padding en desktop: la columna medía 368px pero el
   * contenido solo 272px, con 48px muertos contra cada borde del contenedor y 96
   * entre items. Ahora el contenido de cada columna arranca en el borde de su
   * tercio y el bloque llega de punta a punta de los 1104px. */
  .srv-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .srv-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Cuadrado con radio del botón y trazo navy de 1px (09/08/2026): antes era
   * una píldora.
   *
   * NAVY TRANSLÚCIDO (15/08/2026, pedido directo: "bg sólido azul, con
   * transparencia como el navbar"). Reemplaza al rayado diagonal que había
   * durado unas horas, y antes de eso al arena-200 plano. Es la misma receta
   * glass del header scrolleado —fill translúcido + blur + borde— pero en navy
   * en vez de blanco: `bg-white/70` allá, navy al 70% acá, y el mismo
   * `blur(12px)` del `backdrop-blur-md` de Tailwind.
   *
   * El ícono TIENE que pasar a blanco. Navy al 70% sobre el blanco de la sección
   * compone #4D6E89, y el trazo navy que había antes da 2.53 contra eso: se
   * borraba. En blanco da 5.37, holgado para un gráfico (WCAG 1.4.11 pide 3:1).
   * El borde se queda en navy sólido: contra el fill al 70% se lee como un
   * escalón de tono y es lo que le sigue dando canto al cuadrado.
   *
   * El `backdrop-filter` es, hoy, decorativo: la Sección 4 es blanco liso y no
   * hay nada detrás que difuminar. Va igual porque el pedido fue replicar el
   * tratamiento del navbar, y porque el día que atrás haya una foto o una
   * textura el efecto aparece solo. Si se busca ahorrar la capa de composición
   * (3 chips), sacarlo no cambia nada de lo que se ve. */
  .srv-ico {
    width: 56px;
    height: 56px;
    flex: 0 0 auto;
    border-radius: var(--radius-boton);
    border: 1px solid var(--color-navy);
    background-color: color-mix(in srgb, var(--color-navy) 70%, transparent);
    backdrop-filter: blur(12px);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.375rem;
  }
  .srv-ico svg {
    width: 26px;
    height: 26px;
  }

  .srv-desc {
    margin-top: 1.125rem;
  }

  @media (min-width: 1024px) {
    /* Una columna por servicio. Antes era `1fr auto 1fr auto 1fr`: los `auto`
     * eran los divisores de 1px, que ya no existen (15/08/2026), y el valor
     * fijo daba por sentado que los servicios eran exactamente tres. */
    .srv-grid {
      grid-template-columns: repeat(var(--srv-cols, 3), minmax(0, 1fr));
      gap: 3rem;
    }
  }
</style>
