---
/**
 * Footer con NAP (§6.7) desde site.ts. Links externos con rel="noopener noreferrer"
 * (code review PR #1).
 *
 * Estructura adaptada del footer minimal de referencia (09/08/2026): grilla de 6
 * columnas con el bloque de marca a la izquierda (logo + descripción + botones
 * de contacto), dos columnas de links, y el copyright centrado bajo una línea.
 * La referencia venía como componente React con lucide-react; acá es Astro puro
 * y los íconos son SVG inline en el mismo trazo que el resto del sitio (24×24,
 * stroke 1.5, puntas redondeadas), sin sumar dependencias ni JS (§7.1).
 *
 * Croma y tipografía locales: FONDO NAVY (15/08/2026, pedido directo — "que el
 * footer use de bg el navy declarado como color principal, la tipografía
 * blanca"). Revierte el fondo blanco del 14/08/2026 y devuelve al footer el rol
 * de cierre sólido del documento, que es además lo que HojaTecnica ya daba por
 * sentado al dejarlo fuera del sistema de marco.
 *
 * Al invertir el fondo se invierte toda la croma, porque sobre navy los tonos
 * que servían sobre blanco fallan: arena-800 (#865C46) sobre navy da 2.53 y
 * navy-700 da 2.51 — ilegibles. Ratios de la paleta nueva sobre navy #003057:
 * blanco 13.46 (AAA), navy-100 #E6EAEE 11.24 (AAA, cuerpo y links), arena de
 * marca #D9C2B6 7.99 (AAA, títulos de columna). Acá SÍ se puede usar la arena
 * de marca como texto: la regla de §1.2 prohíbe arena sobre CLARO (1.70), no
 * sobre navy. Los pesos siguen siendo los que el sitio carga (300/400/500).
 *
 * Los botones son 44×44 y no los ~28px de la referencia: es el tap target mínimo
 * (§7.3). Solo hay tres porque son los canales que NEST realmente tiene — no se
 * inventan perfiles de redes que no existen. Sus íconos van en blanco puro con
 * borde blanco/30 y hover a arena: sobre navy el trazo navy-700 anterior
 * directamente desaparecía.
 *
 * Logo (15/08/2026): vuelve a /logo-nest.svg —el mismo del hero, hoy blanco
 * entero— porque /logo-nest-oscuro.svg tiene el wordmark en navy y sobre este
 * fondo se pierde.
 */
import { site, whatsappUrl } from '@/data/site';

const year = new Date().getFullYear();

const navegacion = [
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/obras', label: 'Obras' },
  { href: '/contacto', label: 'Contacto' },
];

const contacto = [
  { href: `mailto:${site.email}`, label: site.email, externo: false },
  { href: whatsappUrl, label: `WhatsApp ${site.whatsapp.display}`, externo: true },
  { href: site.instagram, label: '@nest.obras', externo: true },
];

/** Botones de la referencia, con los canales reales de NEST. */
const botones = [
  { href: site.instagram, etiqueta: 'Instagram de NEST', icono: 'instagram' as const },
  { href: whatsappUrl, etiqueta: 'Escribinos por WhatsApp', icono: 'whatsapp' as const },
  { href: `mailto:${site.email}`, etiqueta: 'Escribinos por email', icono: 'email' as const },
];

const tituloColumna = 'block text-[0.625rem] font-medium uppercase tracking-[0.24em] text-arena';
const link =
  'flex min-h-[44px] items-center text-sm text-navy-100 transition-colors hover:text-white';
---

<footer class="border-t border-white/15 bg-navy text-white">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid grid-cols-6 gap-8 md:gap-10">
      {/* Bloque de marca: logo, descripción y botones. */}
      <div class="col-span-6 flex flex-col gap-5 md:col-span-4">
        <a href="/" class="w-max">
          <img src="/logo-nest.svg" alt="NEST" class="h-[2.7rem] w-auto" />
        </a>

        <p class="max-w-sm text-sm leading-relaxed text-navy-100">{site.descripcion}</p>

        <div class="flex gap-2">
          {
            botones.map((b) => (
              <a
                href={b.href}
                aria-label={b.etiqueta}
                {...(b.icono !== 'email'
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
                class="flex h-11 w-11 items-center justify-center border border-white/30 text-white transition-colors hover:border-arena hover:text-arena"
              >
                {b.icono === 'instagram' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                    aria-hidden="true"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17" cy="7" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {b.icono === 'whatsapp' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                    aria-hidden="true"
                  >
                    <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3.5 20l1.2-4.7A8.5 8.5 0 1 1 21 11.5Z" />
                    <path d="M8.8 9.2c0 3 2.2 5.2 5.2 5.2l1-1.3-1.7-.8-.8.7c-.9-.4-1.6-1.1-2-2l.7-.8-.8-1.7-1.3 1Z" />
                  </svg>
                )}
                {b.icono === 'email' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3.5 6.5 8.5 6 8.5-6" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <nav class="col-span-3 md:col-span-1" aria-label="Pie de página">
        <span class={tituloColumna}>Navegación</span>
        <div class="mt-1 flex flex-col">
          {navegacion.map((l) => <a href={l.href} class={link}>{l.label}</a>)}
        </div>
      </nav>

      <address class="col-span-3 not-italic md:col-span-1">
        <span class={tituloColumna}>Contacto</span>
        <div class="mt-1 flex flex-col">
          {
            contacto.map((c) => (
              <a
                href={c.href}
                class={link}
                {...(c.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {c.label}
              </a>
            ))
          }
          {site.direccion && <p class="mt-3 text-sm leading-relaxed text-navy-100">{site.direccion.display}</p>}
        </div>
      </address>
    </div>

    <p class="mt-12 border-t border-white/15 pt-6 text-center text-xs font-light text-navy-100">
      © {year} {site.nombre}. Todos los derechos reservados.
    </p>
  </div>
</footer>
