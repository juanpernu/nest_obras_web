---
/**
 * Footer con NAP (§6.7) desde site.ts. Links externos con rel="noopener noreferrer"
 * (code review PR #1).
 *
 * Estructura adaptada del footer minimal de referencia (09/08/2026): grilla de 6
 * columnas con el bloque de marca a la izquierda (logo + descripción + botones
 * de contacto), dos columnas de links, y el copyright centrado bajo una línea.
 * La referencia venía como componente React con lucide-react; acá es Astro puro
 * y los íconos son SVG inline en el mismo trazo que el resto del sitio (24×24,
 * stroke 1.5, puntas redondeadas), sin sumar dependencias ni JS (§7.1).
 *
 * Croma y tipografía locales: fondo blanco (14/08/2026, mismo criterio ya
 * aplicado en las secciones de Home que pasaron de navy a blanco). Títulos de
 * columna en arena-800 (única variante de arena legible como texto sobre claro,
 * §1.2/Eyebrow), links en navy-700 con hover a navy (el arena NUNCA es texto
 * ni borde sobre blanco — da 1.70, falla WCAG), y los pesos que el sitio carga
 * (300/400/500) — nada de `font-thin` ni `font-mono`, que no existen acá.
 * Ratios verificados: navy-700 sobre blanco 5.37 (AA), navy sobre blanco 13.46
 * (AAA), navy-200 (borde) es decorativo, no necesita ratio de texto.
 *
 * Los botones son 44×44 y no los ~28px de la referencia: es el tap target mínimo
 * (§7.3). Solo hay tres porque son los canales que NEST realmente tiene — no se
 * inventan perfiles de redes que no existen.
 *
 * Logo (14/08/2026): usa /logo-nest-oscuro.svg, no el /logo-nest.svg del hero.
 * Ese archivo es todo blanco (pensado para el video oscuro del hero de Home) e
 * invisible sobre este fondo blanco. La variante oscura es el mismo logo en
 * navy sólido.
 *
 * Monocromo (16/08/2026, pedido del cliente): las dos variantes son de un solo
 * tono — blanco o navy según el fondo. Antes el isotipo iba en arena; se
 * unificó para que el logo no mezcle dos colores.
 */
import { site, whatsappUrl } from '@/data/site';

const year = new Date().getFullYear();

const navegacion = [
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/obras', label: 'Obras' },
  { href: '/contacto', label: 'Contacto' },
  { href: '/privacidad', label: 'Privacidad' },
];

const contacto = [
  {
    href: `mailto:${site.email}`,
    label: site.email,
    externo: false,
    evento: 'email_click',
  },
  {
    href: whatsappUrl,
    label: `WhatsApp ${site.whatsapp.display}`,
    externo: true,
    evento: 'whatsapp_click',
  },
  { href: site.instagram, label: '@nest.obras', externo: true },
];

/** Botones de la referencia, con los canales reales de NEST. */
const botones = [
  { href: site.instagram, etiqueta: 'Instagram de NEST', icono: 'instagram' as const },
  { href: whatsappUrl, etiqueta: 'Escribinos por WhatsApp', icono: 'whatsapp' as const },
  { href: `mailto:${site.email}`, etiqueta: 'Escribinos por email', icono: 'email' as const },
];

const tituloColumna = 'block text-[0.625rem] font-medium uppercase tracking-[0.24em] text-arena-800';
const link =
  'flex min-h-[44px] items-center text-sm text-navy-700 transition-colors hover:text-navy';
---

<footer class="border-t border-navy-200 bg-white text-navy">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid grid-cols-6 gap-8 md:gap-10">
      {/* Bloque de marca: logo, descripción y botones. */}
      <div class="col-span-6 flex flex-col gap-5 md:col-span-4">
        <a href="/" class="w-max">
          <img src="/logo-nest-oscuro.svg" alt="NEST" class="h-[2.7rem] w-auto" />
        </a>

        <p class="max-w-sm text-sm leading-relaxed text-navy-700">{site.descripcion}</p>

        <div class="flex gap-2">
          {
            botones.map((b) => (
              <a
                href={b.href}
                aria-label={b.etiqueta}
                {...(b.icono !== 'email'
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
                class="flex h-11 w-11 items-center justify-center border border-navy-200 text-navy-700 transition-colors hover:border-navy hover:text-navy"
              >
                {b.icono === 'instagram' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                    aria-hidden="true"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17" cy="7" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {b.icono === 'whatsapp' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                    aria-hidden="true"
                  >
                    <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3.5 20l1.2-4.7A8.5 8.5 0 1 1 21 11.5Z" />
                    <path d="M8.8 9.2c0 3 2.2 5.2 5.2 5.2l1-1.3-1.7-.8-.8.7c-.9-.4-1.6-1.1-2-2l.7-.8-.8-1.7-1.3 1Z" />
                  </svg>
                )}
                {b.icono === 'email' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3.5 6.5 8.5 6 8.5-6" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <nav class="col-span-3 md:col-span-1" aria-label="Pie de página">
        <span class={tituloColumna}>Navegación</span>
        <div class="mt-1 flex flex-col">
          {navegacion.map((l) => <a href={l.href} class={link}>{l.label}</a>)}
        </div>
      </nav>

      <address class="col-span-3 not-italic md:col-span-1">
        <span class={tituloColumna}>Contacto</span>
        <div class="mt-1 flex flex-col">
          {
            contacto.map((c) => (
              <a
                href={c.href}
                class={link}
                {...(c.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                {...(c.evento ? { 'data-evento': c.evento, 'data-evento-lugar': 'footer' } : {})}
              >
                {c.label}
              </a>
            ))
          }
          {site.direccion && <p class="mt-3 text-sm leading-relaxed text-navy-700">{site.direccion.display}</p>}
        </div>
      </address>
    </div>

    <p class="mt-12 border-t border-navy-200 pt-6 text-center text-xs font-light text-navy-700">
      © {year} {site.nombre}. Todos los derechos reservados.
    </p>
  </div>
</footer>
