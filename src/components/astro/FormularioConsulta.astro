---
/**
 * Formulario de consulta (§5.1 Sección 9, §8.2).
 *
 * Envío por mail (01/10/2026): el <form> postea nativo a /api/consulta, que
 * manda la consulta por mail y redirige a /contacto/gracias (o /contacto/error).
 * Antes un script interceptaba el submit y abría WhatsApp con el mensaje
 * armado; el canal de WhatsApp sigue existiendo, pero como link aparte
 * (/contacto, FAB), no como destino del formulario.
 *
 * Funciona sin JS. El único script es JS plano en un <script> de Astro, no una
 * isla (cero directivas client:*, §7.1): bloquea el doble envío y evita que un
 * bot que llena el honeypot cuente como Lead.
 *
 * Inputs con font-size ≥16px para no disparar zoom en iOS (§7.3); honeypot
 * antispam (§8.1); <select> nativo (§3.4).
 *
 * Dos crománicas (10/08/2026): la de fondo claro (bordes navy, nunca arena
 * §1.2) es la que usa /contacto; `sobreNavy` es la variante glass para la
 * card semitransparente de la home, con blur medio para que el fondo
 * fotográfico se siga percibiendo detrás de los campos.
 */
import { site } from '@/data/site';
import { tiposDeProyecto } from '@/data/consulta';

interface Props {
  class?: string;
  /** Card glass sobre navy (home) en vez de fondo claro (/contacto). */
  sobreNavy?: boolean;
}
const { class: className, sobreNavy = false } = Astro.props as Props;

const label = sobreNavy
  ? 'block text-sm font-medium uppercase tracking-[0.06em] text-white'
  : 'block text-sm font-medium uppercase tracking-[0.06em] text-navy';

/* Campos con el lenguaje de shadcn/ui (08/08/2026): radio suave, sombra
 * mínima, y en foco el borde pasa al color de anillo más un ring de 3px al 50%
 * — su firma visual, en vez del ring-1 anterior.
 *
 * Tres desvíos deliberados del componente original de shadcn, por criterios que
 * este proyecto ya tiene documentados:
 *
 * 1. Borde en navy-600 (claro) / white/25 (glass), no en el `--input`
 *    (#B3C1CD ≈ navy-300) del mapeo de §3.2: ese tono da ~2.2:1 sobre blanco y
 *    el borde de un campo es un límite de control, que WCAG 1.4.11 exige
 *    ≥3:1. navy-600 da 3.4:1.
 * 2. `min-h-[44px]` en lugar del `h-9` (36px) de shadcn: tap target mínimo
 *    (§7.3).
 * 3. `text-base` fijo, sin el `md:text-sm` de shadcn: 16px es el umbral que
 *    evita el zoom automático de iOS al enfocar un campo (§7.3).
 *
 * En la variante clara el placeholder va en navy-700 (5.48:1) y no en el
 * `--muted-foreground` del mapeo: navy-500 da 3.00:1 y Lighthouse audita el
 * contraste del placeholder (a11y 100). En la glass, blanco/60 da 4.6:1 sobre
 * el navy/40 + blur del fondo en su punto más oscuro.
 *
 * `appearance-none` (14/08/2026): sin esto los dos <select> del formulario
 * (tipo de proyecto, zona) se renderizan con el widget nativo del navegador
 * —altura y padding propios, ajenos al `min-h-[44px]`/`px-3` que sí respetan
 * `<input>` y `<textarea>`— y quedan desalineados del resto de los campos.
 * Con el apariencia nativa apagada los tres tipos de control comparten
 * exactamente la misma caja; el chevron se repone a mano en el markup (ver
 * `.campo-select` más abajo), reemplazando la flecha del sistema. */
const field = sobreNavy
  ? 'mt-2 flex min-h-[44px] w-full appearance-none border border-white/25 bg-white/10 px-3 py-2 text-base text-white shadow-xs outline-none backdrop-blur-sm transition-[color,box-shadow,background-color] placeholder:text-white/60 focus-visible:border-arena focus-visible:bg-white/15 focus-visible:ring-[3px] focus-visible:ring-arena/40 disabled:cursor-not-allowed disabled:opacity-50'
  : 'mt-2 flex min-h-[44px] w-full appearance-none border border-navy-600 bg-white px-3 py-2 text-base text-navy shadow-xs outline-none transition-[color,box-shadow] placeholder:text-navy-700 focus-visible:border-navy focus-visible:ring-[3px] focus-visible:ring-navy/50 disabled:cursor-not-allowed disabled:opacity-50';

/* Clase extra solo para los <select>: espacio a la derecha para el chevron
 * propio y `bg-no-repeat` no hace falta porque el ícono ya no va por
 * `background-image` sino como SVG posicionado en el markup. */
const fieldSelect = `${field} pr-9`;
const chevronColor = sobreNavy ? 'text-white/70' : 'text-navy-600';

---

<form
  method="POST"
  action="/api/consulta"
  data-consulta
  data-glass={sobreNavy ? '' : undefined}
  data-evento="form_submit"
  class:list={['space-y-5', className]}
>
  {/* Honeypot: los bots lo completan; humanos no lo ven. */}
  <div class="hidden" aria-hidden="true">
    <label>No completar<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div>
    <label for="nombre" class={label}>Nombre completo *</label>
    <input
      id="nombre"
      name="nombre"
      type="text"
      autocomplete="name"
      placeholder="Ej: María González"
      required
      class={field}
    />
  </div>

  <div>
    <label for="whatsapp" class={label}>WhatsApp *</label>
    <input
      id="whatsapp"
      name="whatsapp"
      type="tel"
      autocomplete="tel"
      inputmode="tel"
      placeholder="Ej: 11 5555-0000"
      required
      class={field}
    />
  </div>

  <div>
    <label for="tipo" class={label}>Tipo de proyecto *</label>
    <div class="campo-select relative mt-2">
      <select id="tipo" name="tipo" required class={fieldSelect + ' mt-0'}>
        <option value="">Seleccioná una opción</option>
        {tiposDeProyecto.map((t) => <option value={t}>{t}</option>)}
      </select>
      <svg
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
        class:list={['pointer-events-none absolute top-1/2 right-3 h-[14px] w-[14px] -translate-y-1/2', chevronColor]}
      >
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  </div>

  {/* Spec del 10/08/2026: pasa de input libre a select con las zonas reales
   * de `site.areaServed` — mismo dato que ya alimenta el JSON-LD del layout,
   * no una lista nueva inventada para este campo. El `name="zona"` se
   * mantiene: /api/consulta lo lee con ese nombre. */}
  <div>
    <label for="zona" class={label}>¿Desde dónde nos contactás?</label>
    <div class="campo-select relative mt-2">
      <select id="zona" name="zona" class={fieldSelect + ' mt-0'}>
        <option value="">Seleccioná una opción</option>
        {site.areaServed.map((z) => <option value={z}>{z}</option>)}
        <option value="Otra zona">Otra zona</option>
      </select>
      <svg
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
        class:list={['pointer-events-none absolute top-1/2 right-3 h-[14px] w-[14px] -translate-y-1/2', chevronColor]}
      >
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  </div>

  <div>
    <label for="mensaje" class={label}>Contanos tu proyecto (opcional)</label>
    <textarea
      id="mensaje"
      name="mensaje"
      rows="5"
      placeholder="Ej: Quiero construir una casa de 300m² en Nordelta. Tengo el lote."
      class={field}></textarea>
  </div>

  <div>
    {/* Mismo tratamiento "primario" que Boton.astro (10/08/2026), solo en la
     * variante glass: border-arena + glass + texto blanco, invierte a arena
     * sólido + navy en hover. En la variante clara (/contacto, fondo blanco)
     * se mantiene el arena sólido de siempre — texto blanco sobre transparente
     * ahí sería ilegible.
     *
     * RELLENO PROGRESIVO en hover (18/08/2026, pedido explícito): el mismo
     * `::before` que entra de izquierda a derecha que tiene `primario` en
     * `Boton.astro`, en vez del cambio de color instantáneo. La clase
     * `boton-relleno-*` la define este componente en su propio <style> —
     * `Boton.astro` tiene su copia scopeada y los dos apuntan al mismo
     * criterio; el pendiente de fondo sigue siendo que este submit deje de
     * duplicar las clases del primario (ver bitácora 05, resolverlo con un
     * prop `como="button"` en Boton). `relative overflow-hidden` para que el
     * relleno quede acotado a la caja, y el texto en un <span> con
     * `relative z-10` para que quede por encima. */}
    <button
      type="submit"
      class:list={[
        'relative flex min-h-[44px] w-full items-center justify-center overflow-hidden rounded-boton px-6 py-3 text-base font-medium uppercase tracking-[0.02em] transition-colors',
        sobreNavy
          ? 'boton-relleno-arena border border-arena bg-white/10 text-white backdrop-blur-2xl hover:text-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-arena'
          : 'bg-arena text-navy hover:bg-arena-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy',
      ]}
    >
      <span class="relative z-10">Enviar consulta →</span>
    </button>
  </div>
</form>

<style>
  /* Los <option> de un <select> los pinta el navegador en su propia capa — no
   * heredan `bg-white/10` del control. Sin esto, el desplegable de la variante
   * glass abriría en el fondo por defecto del sistema (blanco) con texto
   * blanco encima. Va detrás de `[data-glass]` para no afectar la variante
   * clara, donde el <select> ya es legible con los colores del sistema. */
  form[data-glass] select option {
    background-color: #00263f;
    color: #fff;
  }

  /* Relleno de hover que entra de izquierda a derecha en el submit
   * (18/08/2026) — misma técnica y mismo timing que `.boton-relleno-arena` en
   * `Boton.astro` y que `.tst-btn` en `CarruselTestimonios.astro`: si cambia
   * el easing o la duración en uno, sincronizar los tres. */
  .boton-relleno-arena::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--color-arena);
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .boton-relleno-arena:hover::before,
  .boton-relleno-arena:focus-visible::before {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .boton-relleno-arena::before {
      transition: none;
    }
  }
</style>

<script>
  // Si este script no corre, el POST nativo a /api/consulta funciona igual.
  // Va justo: la home queda pegada al presupuesto de 5 KB de JS por ruta.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-consulta]')) {
    const boton = form.querySelector('button')!;
    const texto = boton.firstElementChild!;
    const original = texto.textContent;
    // Con el botón deshabilitado ni el click ni Enter vuelven a enviar: sin
    // esto, un doble click manda el mail dos veces.
    const enviando = (si: boolean) => {
      boton.disabled = si;
      texto.textContent = si ? 'Enviando…' : original;
    };

    form.addEventListener('submit', (evento) => {
      // Honeypot lleno ⇒ bot: el POST sigue (el server lo descarta), pero
      // `stopPropagation` evita que el listener delegado de analítica
      // (Analytics.astro, escucha 'submit' en document) cuente un Lead falso.
      if ((form.elements.namedItem('_gotcha') as HTMLInputElement).value) evento.stopPropagation();
      enviando(true);
    });

    // Volver con "atrás" desde /contacto/gracias restaura la página del bfcache
    // con el botón todavía deshabilitado.
    addEventListener('pageshow', (evento) => evento.persisted && enviando(false));
  }
</script>
