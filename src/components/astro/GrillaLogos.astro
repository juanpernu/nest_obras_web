---
/**
 * Clientes corporativos como logos (§5.1 Sección 6). Marco "blueprint": el
 * reticulado completo de la grilla dibujado con líneas finas continuas —una
 * por cada límite de columna y de fila, incluidos los exteriores— rodeando
 * cada logo, de punta a punta y sin cortes en las uniones (16/08/2026: antes
 * las líneas se interrumpían para dejarle lugar a un punto en cada cruce;
 * al sacar los puntos, se sacó también el corte, que quedaba como un hueco
 * vacío sin nada que lo justifique).
 *
 * Se renderiza dos veces con distinta geometría (2 columnas en mobile, 4 en
 * desktop) porque el reticulado cambia con el breakpoint: mismas celdas, otra
 * cantidad de filas y columnas.
 *
 * Esquinas exteriores en L (16/08/2026, unificación con el marco de página):
 * las 4 intersecciones exteriores del reticulado (0%/0%, 100%/0%, 0%/100%,
 * 100%/100%) llevan la misma escuadra en L de 9px con borde 1.5px navy que
 * usan `.bp-esq` (GrillaServicios) y `.marco-esq` (MarcoSeccion) — mismo
 * estilo de líneas y esquinas que el marco general de la página. El resto de
 * las intersecciones (internas, y las de borde-pero-no-esquina) no lleva
 * ninguna marca: el sistema general tampoco marca cruces que no son una
 * esquina real, solo los 4 extremos de un rectángulo.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props as Props;

/** Logos que no se muestran, por número de archivo (decisión del 07/08/2026).
 * El asset sigue en /public/logos: se oculta, no se borra. `08` vuelto a
 * mostrar (18/08/2026, pedido explícito: "añademe... el logo_08"). */
const ocultos = new Set<string>([]);

/* Google salió del sitio (22/08/2026, pedido del cliente): antes se insertaba
 * `/logos/logo_google.svg` en la posición 6 con un splice. A diferencia de
 * `ocultos`, acá el asset se borró: el pedido fue sacar la marca, no ocultarla.
 *
 * Quedan pendientes los logos de Perramus y SPI Astilleros; con esos dos la
 * grilla pasaría a 14 celdas. Hoy son 12 (10 numeradas + Subway + Fabric
 * Sushi), que cierran filas exactas en los dos breakpoints: 6 × 2 en mobile,
 * 3 × 4 en desktop. */

const logosReales = Array.from({ length: 10 }, (_, i) => String(i + 1).padStart(2, '0'))
  .filter((n) => !ocultos.has(n))
  .map((n) => ({
    src: `/logos/logo_${n}.svg`,
    alt: `Logo de cliente corporativo de NEST (${n})`,
  }));
/* Subway (18/08/2026, pedido explícito). Ocupa la posición que hasta el
 * 22/08/2026 tenía Google, que iba justo antes con otro splice. */
logosReales.splice(5, 0, { src: '/logos/logo_subway.svg', alt: 'Logo de Subway' });

/* Fabric Sushi (23/08/2026, pedido explícito). Único logo en PNG y no SVG: es
 * el archivo que publica la marca. Venía blanco puro sobre transparente
 * —invisible contra el fondo blanco de esta sección—, así que se recoloreó a
 * #5A636E, un gris frío cuya luminancia (98) es la media de los otros logos ya
 * pasados por el `grayscale` de la grilla, medida sobre el render real.
 * OJO con el hover: la clase es la misma que en el resto, pero al ser un arte
 * monocromo no hay color de marca que restituir, así que el efecto no se ve.
 * Si aparece una versión a color del logo, reemplazar el archivo alcanza. */
logosReales.splice(6, 0, { src: '/logos/logo_fabric-sushi.png', alt: 'Logo de Fabric Sushi' });

/* Sin celdas de relleno: antes se completaba a un múltiplo de 4 y en mobile
 * (2 columnas) eso dejaba una fila entera vacía. Una fila sin ninguna imagen
 * mide solo su padding, así que las filas dejaban de ser uniformes y el
 * reticulado —que reparte porcentajes iguales— se desalineaba de los logos.
 * Con las celdas justas, mobile da ⌈n/2⌉ filas y desktop ⌈n/4⌉ sobre el total
 * real de logos, y `auto-rows-fr` garantiza que todas midan igual. */
const celdas = logosReales;

/* Las dos extensiones que salen de la grilla se difuminan hacia el borde del
 * viewport: arrancan opacas contra la grilla y llegan 100% transparentes justo
 * al llegar al margen, en vez de cortarse en seco.
 *
 * MARGEN (16/08/2026, fix de scroll horizontal + alineación con el marco de
 * página): en `index.astro`, `GrillaLogos` ya no vive dentro de su propio
 * `px-6` — el contenedor que la envuelve usa `padding-inline: var(--marco-x)`
 * directo (mismo margen que las escuadras de `MarcoSeccion`), así que el
 * borde 0%/100% de esta grilla YA ES el borde del marco de la sección. La
 * distancia de ahí al borde real de pantalla es, entonces, exactamente
 * `--marco-x` — sin sumarle nada, a diferencia de una versión anterior de
 * este cálculo que compensaba un nivel de `px-6` que ya no existe.
 *
 * El fallback dentro de `var()` sólo corre si NO hay un `<MarcoSeccion>`
 * ancestro que defina `--marco-x` — es el caso de `servicios.astro`, que usa
 * `GrillaLogos` dentro de una `<section class="bg-navy">` simple con su
 * propio `px-6` sin tocar (fuera del alcance de este fix). Ahí el fallback
 * reproduce la fórmula vieja tal cual, `(100vw - 100%) / 2` — mismo anti-
 * patrón ya corregido en HojaTecnica/MarcoSeccion/GrillaServicios (`100vw`
 * cuenta el ancho de la scrollbar y `100%` no), pero `servicios.astro` sigue
 * con ese bug de scroll conocido, sin cambios, pendiente si se decide
 * envolver esa sección en `<MarcoSeccion>` también.
 *
 * El fundido va por `mask-image` y no por un degradé de color: la máscara es
 * independiente del pintado del trazo, así que el mismo recurso sirvió cuando
 * la línea era dasheada y sigue sirviendo ahora que es sólida. */
const MARGEN = 'var(--marco-x, calc((100vw - 100%) / 2))';

const reticulados = [
  { cols: 2, visibilidad: 'md:hidden' },
  { cols: 4, visibilidad: 'hidden md:block' },
].map(({ cols, visibilidad }) => {
  const filas = Math.ceil(celdas.length / cols);
  const anchoCol = 100 / cols;
  const altoFila = 100 / filas;

  return {
    visibilidad,
    /** Una vertical continua por cada límite de columna, sin cortes por fila
     * (16/08/2026): sin los puntos en los cruces, el corte por GAP dejaba un
     * hueco visible en cada intersección. */
    /* La ÚLTIMA vertical se ancla con `right: 0` y no con `left: 100%`
     * (18/08/2026). Con `left: 100%` su píxel cae justo AFUERA del borde
     * derecho de la grilla, y como ese borde coincide con la guía derecha de
     * página —cuyo píxel cae adentro— las dos líneas quedaban adyacentes en vez
     * de superpuestas: 2px de banda que se leían como una línea extra del
     * marco. Medido: reticulado en [1224,1225] contra guía en [1223,1224].
     * Con `right: 0` ocupa el mismo píxel que la guía y se lee una sola línea,
     * que es lo que ya pasaba del lado izquierdo (ahí `left: 0%` cae adentro y
     * coincidía por casualidad). */
    segmentosV: Array.from({ length: cols + 1 }, (_, c) =>
      c === cols
        ? { right: '0', top: '0%', height: '100%' }
        : { left: `${c * anchoCol}%`, top: '0%', height: '100%' },
    ),
    /** Una horizontal continua por fila, de punta a punta (con sus dos
     * extensiones que se funden hacia el borde real de pantalla), sin cortes
     * por columna. */
    segmentosH: Array.from({ length: filas + 1 }, (_, f) => {
      const top = `${f * altoFila}%`;
      return [
        { estilo: { top, left: `calc(-1 * ${MARGEN})`, width: MARGEN }, clase: 'funde-izq' },
        { estilo: { top, left: '0%', width: '100%' }, clase: '' },
        { estilo: { top, left: '100%', width: MARGEN }, clase: 'funde-der' },
      ];
    }).flat(),
  };
});
---

<div class:list={['relative', className]}>
  <div class="relative grid auto-rows-fr grid-cols-2 md:grid-cols-4">
    {
      celdas.map((logo) => (
        <div class="flex items-center justify-center py-6">
          <img
            src={logo.src}
            alt={logo.alt}
            loading="lazy"
            decoding="async"
            class="h-12 w-auto max-w-[140px] object-contain grayscale transition-[filter] duration-300 hover:grayscale-0"
          />
        </div>
      ))
    }
  </div>

  {
    reticulados.map(({ visibilidad, segmentosV, segmentosH }) => (
      <div class:list={['pointer-events-none absolute inset-0', visibilidad]} aria-hidden="true">
        {segmentosV.map((s) => (
          <span class="linea-v absolute w-px" style={s} />
        ))}
        {segmentosH.map((s) => (
          <span class:list={['linea-h absolute h-px', s.clase]} style={s.estilo} />
        ))}

        {/* Sin puntos en las intersecciones internas (16/08/2026, pedido
            explícito): solo quedan las líneas y las 4 escuadras exteriores,
            mismo criterio que `.bp-esq`/`.marco-esq`. */}
        <span class="esq esq--si" aria-hidden="true" />
        <span class="esq esq--sd" aria-hidden="true" />
        <span class="esq esq--ii" aria-hidden="true" />
        <span class="esq esq--id" aria-hidden="true" />
      </div>
    ))
  }
</div>

<style>
  /* Trazo sólido en --color-rule (15/08/2026). Antes era dasheado en
   * arena-200, vía repeating-linear-gradient. Se sacaron todas las líneas
   * dasheadas del sitio: el reticulado ahora habla el mismo idioma que las
   * guías de página y el marco de sección (HojaTecnica / MarcoSeccion), que son
   * reglas continuas casi subliminales con marcas navy en los cruces. Acá esas
   * marcas ya existían: los puntos de 3px del markup. */
  .linea-h,
  .linea-v {
    background-color: var(--color-rule);
  }

  /* El fundido de las extensiones va por máscara y no por un degradé de color,
   * para no depender de cómo esté pintado el trazo. */
  .funde-izq {
    -webkit-mask-image: linear-gradient(to right, transparent, #000);
    mask-image: linear-gradient(to right, transparent, #000);
  }
  .funde-der {
    -webkit-mask-image: linear-gradient(to left, transparent, #000);
    mask-image: linear-gradient(to left, transparent, #000);
  }

  /* Escuadras exteriores (16/08/2026) — mismo criterio que `.bp-esq`
   * (GrillaServicios) / `.marco-esq` (MarcoSeccion): cuadrado de 9px con dos
   * lados en navy de 1.5px, ancladas al 0%/100% exacto del reticulado (no a
   * `--marco-x`: esta grilla no es full-bleed, así que sus esquinas van sobre
   * su propio borde, no sobre las guías de página). */
  .esq {
    position: absolute;
    z-index: 2;
    width: 9px;
    height: 9px;
    border-style: solid;
    border-width: 0;
    border-color: var(--color-navy);
    pointer-events: none;
  }
  .esq--si {
    top: 0;
    left: 0;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
  }
  .esq--sd {
    top: 0;
    right: 0;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
  }
  .esq--ii {
    bottom: 0;
    left: 0;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
  }
  .esq--id {
    bottom: 0;
    right: 0;
    border-bottom-width: 1.5px;
    border-right-width: 1.5px;
  }
</style>
