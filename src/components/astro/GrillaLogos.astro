---
/**
 * Clientes corporativos como logos (§5.1 Sección 6).
 *
 * SIN RETICULADO (15/08/2026, pedido directo: "mantené la distribución de la
 * grilla pero que no tengan líneas", mismo recurso que se sacó de
 * GrillaServicios). Hasta acá el bloque llevaba el marco "blueprint" del proto
 * Glass (07/08/2026): un overlay absoluto que dibujaba el reticulado completo
 * —una línea por cada límite de columna y de fila, exteriores incluidos, cortada
 * en segmentos que dejaban aire antes de cada cruce— con un punto navy de 3px en
 * cada intersección y dos extensiones que se difuminaban hacia los bordes del
 * viewport. Se fue entero, líneas y puntos: sin líneas los puntos quedaban como
 * marcas de registro de un marco que ya no existe.
 *
 * La grilla en sí sobrevivió a ese cambio: 2 columnas en mobile, `auto-rows-fr`
 * para que todas las filas midan igual. Lo único que se perdió fue el trazo.
 *
 * A TODO EL ANCHO (15/08/2026, pedido: "que ocupe todo el ancho que pueda del
 * componente padre"). Ojo con la premisa: la grilla YA medía el 100% del
 * contenedor (1104px en desktop). El que no llegaba a los bordes era su
 * contenido. Dos cambios, por dos causas distintas:
 *
 * 1. Los logos venían topeados por ALTO (`h-12`) y encima con `max-w-[140px]`,
 *    dentro de celdas de 276px. Ahora la caja de cada `<img>` es `h-16 w-full`
 *    con `object-contain` —que nunca estira— y el padding lateral de celda baja
 *    de 24px a 16px.
 * 2. De 4 a 5 columnas en desktop. Con 4, diez logos daban 3 filas y la última
 *    usaba 2 celdas de 4: media hilera vacía a la derecha. Con 5 dan DOS FILAS
 *    EXACTAS y no queda hueco. Mobile sigue en 2 columnas, que también divide
 *    justo (5 filas).
 *
 * Techo real, por si vuelve el pedido: los 10 SVG tienen ratios de 1.11 a 2.96 y
 * la celda es más ancha que alta, así que TODOS quedan limitados por el alto de
 * 64px. Ensanchar la celda no los agranda — el que manda es `h-16`.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props as Props;

/** Logos que no se muestran, por número de archivo (decisión del 07/08/2026).
 * El asset sigue en /public/logos: se oculta, no se borra. */
const ocultos = new Set(['08']);

const logosReales = Array.from({ length: 10 }, (_, i) => String(i + 1).padStart(2, '0'))
  .filter((n) => !ocultos.has(n))
  .map((n) => ({
    src: `/logos/logo_${n}.svg`,
    alt: `Logo de cliente corporativo de NEST (${n})`,
  }));
logosReales.splice(5, 0, { src: '/logos/logo_google.svg', alt: 'Logo de Google' });

/* Sin celdas de relleno: antes se completaba a un múltiplo de 4 y en mobile
 * (2 columnas) eso dejaba una fila entera vacía, con lo cual las filas dejaban
 * de medir todas lo mismo. Con las celdas justas y las columnas de hoy, los dos
 * breakpoints dividen exacto: mobile 5 filas (10/2) y desktop 2 (10/5), sin
 * celdas sobrantes. `auto-rows-fr` garantiza que midan igual. */
const celdas = logosReales;
---

<div class:list={['relative', className]}>
  <div class="grid auto-rows-fr grid-cols-2 md:grid-cols-5">
    {
      celdas.map((logo) => (
        <div class="flex items-center justify-center px-4 py-6">
          <img
            src={logo.src}
            alt={logo.alt}
            loading="lazy"
            decoding="async"
            class="h-16 w-full object-contain grayscale transition-[filter] duration-300 hover:grayscale-0"
          />
        </div>
      ))
    }
  </div>
</div>
