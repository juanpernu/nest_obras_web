---
/**
 * Imagen de obra optimizada (docs/PLAN-EJECUCION.md §7.4).
 * AVIF+WebP con fallback, `sizes` real por breakpoint, width/height inferidos
 * por astro:assets del ImageMetadata importado (por eso `src` es SIEMPRE el
 * resultado de `image()` de la colección, nunca un string suelto).
 * `prioridad` = true SOLO en la imagen LCP de la página (una vez por ruta).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Requerido: layout real por breakpoint. §7.4 prohíbe `100vw` por defecto —
   * un default silencioso enviaría srcset de viewport completo en tarjetas. */
  sizes: string;
  prioridad?: boolean;
  class?: string;
}

const { src, alt, sizes, prioridad = false, class: className } = Astro.props as Props;
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  sizes={sizes}
  loading={prioridad ? 'eager' : 'lazy'}
  fetchpriority={prioridad ? 'high' : 'auto'}
  decoding={prioridad ? 'sync' : 'async'}
  class={className}
/>
