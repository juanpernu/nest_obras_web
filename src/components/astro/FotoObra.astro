---
/**
 * Imagen de obra optimizada (docs/PLAN-EJECUCION.md §7.4).
 * AVIF+WebP con fallback, `sizes` real por breakpoint, width/height inferidos
 * por astro:assets del ImageMetadata importado (por eso `src` es SIEMPRE el
 * resultado de `image()` de la colección, nunca un string suelto).
 * `prioridad` = true SOLO en la imagen LCP de la página (una vez por ruta).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Requerido: layout real por breakpoint. §7.4 prohíbe `100vw` por defecto —
   * un default silencioso enviaría srcset de viewport completo en tarjetas. */
  sizes: string;
  prioridad?: boolean;
  class?: string;
}

const { src, alt, sizes, prioridad = false, class: className } = Astro.props as Props;
---

{/* `widths` es obligatorio para que `sizes` sirva de algo (16/08/2026, auditoría
    de performance). Sin él, <Picture> emite UNA sola variante por formato y la
    escribe sin descriptor de ancho; un srcset de un candidato sin descriptor se
    trata como `1x` y el navegador ignora `sizes` por completo: mandaba el
    archivo de 1200px a cualquier viewport. Hoy cuesta poco porque las portadas
    de la colección son placeholders planos de 5-9 KB, pero con las fotos reales
    un laptop DPR 1 —donde la celda de la grilla mide 475px— se comía 2,5x de
    más. Se arregla ahora para no rehacer la caché de Sharp dos veces.

    Los tres anchos cubren la grilla de /obras en sus tres breakpoints: 100vw en
    mobile, 50vw en sm y 33vw en lg. Galeria.astro ya lo hacía bien. */}
<Picture
  src={src}
  alt={alt}
  widths={[400, 800, 1200]}
  formats={['avif', 'webp']}
  sizes={sizes}
  loading={prioridad ? 'eager' : 'lazy'}
  fetchpriority={prioridad ? 'high' : 'auto'}
  decoding={prioridad ? 'sync' : 'async'}
  class={className}
/>
