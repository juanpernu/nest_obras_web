---
/**
 * Botón/CTA como <a>. Mayúsculas por CSS (identidad §2.2), tap target ≥44px (§7.3).
 * Variantes según el fondo: arena+navy = 7.91 (AAA), navy sobre blanco = 13.46;
 * el arena NUNCA como texto sobre blanco (§1.2).
 *
 * Geometría por variante (decisiones del 06/08/2026, primario rediseñado el
 * 10/08/2026):
 * - primario: 4px de radio (`--radius-boton`), es la única excepción al radio
 *   cero. Glass sobre navy (10/08/2026): antes era arena sólido; ahora es
 *   transparente con blur y solo un stroke arena de 2px, texto blanco, y en
 *   hover se invierte a arena sólido + texto navy (7.91:1, AAA — mismo ratio
 *   documentado arriba). Al llevar texto blanco en reposo, ESTANDARIZADO para
 *   usarse solo sobre fondo navy — no sobre navy-50 ni blanco, donde el texto
 *   blanco no pasaría contraste.
 * - primarioClaro (14/08/2026): mismo lenguaje de caja con borde que primario,
 *   pero para fondo claro — se necesitó cuando el header sacó el navy y el CTA
 *   "Consultá tu proyecto" del Nav empezó a mostrarse siempre sobre glass
 *   blanco. Borde y texto navy (13.46, AAA), hover invierte a navy sólido +
 *   texto blanco (mismo 13.46). Nunca arena: sobre blanco da 1.70 (§1.2).
 * - secundario y sobreNavy: sin borde ni caja. El stroke se convierte en un
 *   subrayado de 3px que crece de izquierda a derecha en hover/foco. Sin padding
 *   horizontal para que el texto alinee con el párrafo que lo precede; el min-h
 *   de 44px sostiene el tap target.
 *
 * El subrayado se dibuja con un gradiente en `currentColor` y se anima por
 * `background-size`, no por `width`: no dispara layout y no necesita pseudo-elemento
 * ni JS. Va en un <span> interno para medir el texto y no el ancho de la caja.
 *
 * Relleno de primario/primarioClaro (16/08/2026, pedido explícito): en vez del
 * `hover:bg-*` instantáneo, el relleno del hover entra de izquierda a derecha,
 * mismo criterio que `.tst-btn` (los botones de flecha de CarruselTestimonios):
 * un `::before` en `position: absolute; inset: 0`, arrancando en
 * `translateX(-100%)` (fuera de la caja, a la izquierda) y animando a
 * `translateX(0)` en hover/foco. El texto necesita quedar POR ENCIMA de ese
 * `::before` — por eso el <span> interno lleva `relative z-10` siempre, no solo
 * en estas dos variantes: es inocuo en `secundario`/`sobreNavy`, que no tienen
 * ningún `::before` con el que competir.
 */
interface Props {
  href: string;
  variante?: 'primario' | 'primarioClaro' | 'secundario' | 'sobreNavy';
  class?: string;
  /**
   * Los `data-*` (en particular `data-evento*`) se pasan tal cual al <a>, para
   * que una página pueda instrumentar un CTA sin tocar este componente.
   */
  [dato: `data-${string}`]: string | undefined;
}
const { href, variante = 'primario', class: className, ...rest } = Astro.props as Props;

const base =
  'group inline-flex items-center justify-center min-h-[44px] text-[15px] font-medium uppercase tracking-[0.02em]';
const variantes = {
  primario:
    'relative overflow-hidden rounded-boton border border-arena bg-white/10 px-2 py-2 text-white backdrop-blur-2xl transition-colors hover:text-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-arena boton-relleno-arena',
  primarioClaro:
    'relative overflow-hidden rounded-boton border border-navy bg-transparent px-2 py-2 text-navy transition-colors hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy boton-relleno-navy',
  secundario: 'py-3 text-navy',
  sobreNavy: 'py-3 text-arena',
};

// Subrayado animado: 0% → 100% del ancho del texto, 3px, en currentColor.
const subrayado =
  'bg-[image:linear-gradient(currentColor,currentColor)] bg-[length:0%_3px] bg-[position:0_100%] bg-no-repeat pb-1 transition-[background-size] duration-300 ease-out group-hover:bg-[length:100%_3px] group-focus-visible:bg-[length:100%_3px] motion-reduce:transition-none';
const internas = {
  primario: '',
  primarioClaro: '',
  secundario: subrayado,
  sobreNavy: subrayado,
};
---

<a href={href} class:list={[base, variantes[variante], className]} {...rest}
  ><span class:list={['relative z-10', internas[variante]]}><slot /></span></a
>

<style>
  /* Relleno de hover que entra de izquierda a derecha (16/08/2026) — mismo
   * criterio que `.tst-btn` en CarruselTestimonios.astro: mantenerlos
   * sincronizados si cambia el timing o el easing de uno de los dos. */
  .boton-relleno-arena::before,
  .boton-relleno-navy::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .boton-relleno-arena::before {
    background-color: var(--color-arena);
  }
  .boton-relleno-navy::before {
    background-color: var(--color-navy);
  }
  .boton-relleno-arena:hover::before,
  .boton-relleno-arena:focus-visible::before,
  .boton-relleno-navy:hover::before,
  .boton-relleno-navy:focus-visible::before {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .boton-relleno-arena::before,
    .boton-relleno-navy::before {
      transition: none;
    }
  }
</style>
