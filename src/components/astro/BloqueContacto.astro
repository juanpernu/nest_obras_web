---
/**
 * Bloque de contacto directo sobre navy (§5.1 Sección 9). Es el NAP visible del
 * sitio: teléfono, email y dirección salen de site.ts, nunca hardcodeados, para
 * que sean idénticos carácter por carácter acá, en el footer y en el JSON-LD (§6.7).
 */
import Eyebrow from '@/components/astro/Eyebrow.astro';
import { site, telUrl } from '@/data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props as Props;

const enlace = 'flex min-h-[44px] items-center transition-colors hover:text-arena';
---

<div class:list={['bg-navy p-6 text-white md:p-8', className]}>
  <Eyebrow sobreNavy>También podés escribirnos directo</Eyebrow>

  <address class="mt-4 not-italic">
    <a href={telUrl} class={`${enlace} text-lg`}>{site.whatsapp.display}</a>
    <a href={`mailto:${site.email}`} class={`${enlace} text-navy-100`}>{site.email}</a>
    {
      site.direccion && (
        <p class="mt-2 text-sm leading-relaxed text-navy-100">{site.direccion.display}</p>
      )
    }
  </address>
</div>
