---
/**
 * Tarjeta de obra (§5.4). Comportamiento de link según §5.1/§5.4:
 *  - paginaPropia → link al caso
 *  - destacada sin página propia → link a /obras
 *  - resto → no clickeable
 *
 * Desde el 23/08/2026 la rama del medio no tiene ningún caso: las tres
 * destacadas de la Home (PRÜNE, El Aromo y Tacuarí 1051) tienen página propia.
 * Se deja igual porque sigue siendo el fallback si se marca una destacada
 * nueva antes de tener el contenido de su caso.
 */
import FotoObra from '@/components/astro/FotoObra.astro';
import { tipoLabel } from '@/data/obras';
import type { CollectionEntry } from 'astro:content';

interface Props {
  obra: CollectionEntry<'obras'>;
  /** `sizes` según el layout real donde se usa la tarjeta (§7.4). Default: grilla de 3. */
  sizes?: string;
}
const { obra, sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' } =
  Astro.props as Props;
const d = obra.data;

const href = d.paginaPropia && d.slug ? `/obras/${d.slug}` : d.destacadaEnHome ? '/obras' : null;
const Tag = href ? 'a' : 'div';
---

<article>
  <Tag
    href={href}
    data-evento={href ? 'obra_card_click' : undefined}
    data-evento-obra={href ? d.nombre : undefined}
    data-evento-tipo={href ? d.tipo : undefined}
    class:list={['block', href && 'group focus:outline-none']}
  >
    <div class="aspect-[4/3] overflow-hidden bg-navy">
      <FotoObra
        src={d.portada}
        alt={d.portadaAlt}
        sizes={sizes}
        class={`h-full w-full object-cover transition-transform duration-500 ${href ? 'group-hover:scale-[1.03]' : ''}`}
      />
    </div>
    <div class="mt-4">
      <h3 class="text-h3 font-medium text-navy">{d.nombre}</h3>
      <p class="mt-1 text-sm uppercase tracking-[0.06em] text-navy-700">
        {tipoLabel[d.tipo]} · {d.zona}
      </p>
    </div>
  </Tag>
</article>
