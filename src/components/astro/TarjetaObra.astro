---
/**
 * Tarjeta de obra de /obras (§5.4). Sin link (22/08/2026, pedido explícito):
 * ninguna tarjeta de esta grilla navega, todas hacen zoom-in en hover por
 * igual. Antes algunas eran <a> (paginaPropia o destacada) y solo esas tenían
 * zoom; ahora es siempre <div> y el zoom corre parejo en todas. Esto es
 * específico de esta vista — TarjetaObraHover.astro (Home) no cambia.
 */
import FotoObra from '@/components/astro/FotoObra.astro';
import { tipoLabel } from '@/data/obras';
import type { CollectionEntry } from 'astro:content';

interface Props {
  obra: CollectionEntry<'obras'>;
  /** `sizes` según el layout real donde se usa la tarjeta (§7.4). Default: grilla de 3. */
  sizes?: string;
}
const { obra, sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' } =
  Astro.props as Props;
const d = obra.data;
---

<article>
  <div class="group block">
    <div class="aspect-[4/3] overflow-hidden bg-navy">
      <FotoObra
        src={d.portada}
        alt={d.portadaAlt}
        sizes={sizes}
        class="h-full w-full object-cover grayscale transition-[filter,transform] duration-500 hover:grayscale-0 group-hover:scale-[1.03]"
      />
    </div>
    <div class="mt-4">
      <h3 class="text-h3 font-medium text-navy">{d.nombre}</h3>
      <p class="mt-1 text-sm uppercase tracking-[0.06em] text-navy-700">
        {tipoLabel[d.tipo]} · {d.zona}
      </p>
    </div>
  </div>
</article>
