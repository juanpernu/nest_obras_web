---
/**
 * Cabecera de página: Eyebrow + h1 + regla de arena + bajada.
 *
 * Las cinco páginas internas abren exactamente igual (16/08/2026). Estaba
 * copiada textual en las cinco, incluido el string de la animación de entrada,
 * que es la parte que no se puede desincronizar sin romper el LCP:
 *
 * ENTRADA CSS-ONLY, NO `data-reveal`. Este bloque contiene el <h1>, que es el
 * LCP de todas estas rutas. Con `data-reveal` arrancaba en `opacity: 0` y solo
 * se hacía visible cuando corría el script del layout; Chrome no considera
 * candidato a LCP a un elemento con opacidad cero, así que el LCP dejaba de
 * coincidir con el FCP y pasaba a depender de la ejecución del módulo más la
 * primera entrega del IntersectionObserver — medido entre +140 ms y +424 ms
 * según la ruta. Declarada en CSS, la animación arranca en el primer frame y
 * el elemento es candidato desde el vamos. Es el mismo recurso que el hero de
 * la Home usa para su <h1>, por el mismo motivo.
 *
 * El <h1> va en `text-h1` y no en el `text-hero` de la Home: allá el hero ocupa
 * la ventana entera sobre video, acá el título vive dentro de la hoja técnica y
 * `text-hero` lo dejaría fuera de escala respecto de los <h2> que siguen.
 */
import Eyebrow from '@/components/astro/Eyebrow.astro';

interface Props {
  /** Texto del Eyebrow: la sección del sitio a la que pertenece la página. */
  eyebrow: string;
  /** Contenido del <h1>. Uno solo por ruta. */
  titulo: string;
  /** Bajada opcional. `/obras/[id]` la toma de `subtitulo`, que no es requerido. */
  bajada?: string;
  /**
   * Saca el contenedor propio (`mx-auto max-w-6xl px-6`) y deja solo el bloque
   * animado con el contenido (20/08/2026). Es para el único caso en que la
   * cabecera NO es el ancho completo de la página: `/nosotros`, donde vive
   * dentro de una grilla de dos columnas y el contenedor lo aporta la página.
   *
   * OPT-IN a propósito, no un cambio de default: `/servicios`, `/contacto` y
   * `/obras` (y `/obras/[id]`, que además usa el slot `migas`) siguen montando
   * el componente sin esta prop y renderizan exactamente el mismo HTML que
   * antes. Si algún día son mayoría las que van en grilla, se invierte el
   * default y se toca una sola vez.
   *
   * Lo que NO se mueve es la animación de entrada: sigue en este mismo div,
   * porque es el que envuelve el <h1> y de eso depende el LCP (ver arriba).
   * Sacarla de acá o duplicar el string en la página es lo que rompe la métrica.
   */
  sinContenedor?: boolean;
  /**
   * Entrada escalonada (25/08/2026, pedido puntual de `/obras/[id]`): eyebrow,
   * h1 y bajada animan por separado con delay creciente en vez de moverse
   * juntos como un solo bloque — mismo mecanismo que el hero de la Home
   * (`reveal-up`, con el delay como SEGUNDO valor del shorthand de
   * `animation`, no `transition-delay`: acá no hay transición, ese delay no
   * haría nada — ver el comentario del hero en index.astro).
   *
   * OPT-IN a propósito, no cambio de default: `/nosotros`, `/servicios`,
   * `/contacto` y `/obras` siguen con el bloque único sin tocar.
   */
  escalonado?: boolean;
}

const { eyebrow, titulo, bajada, sinContenedor = false, escalonado = false } = Astro.props as Props;

/** `/obras/[id]` antepone migas de pan; el resto de las páginas no. */
const conMigas = Astro.slots.has('migas');
const claseEyebrow = conMigas ? 'mt-6 mb-2.5' : 'mb-2.5';
---

<div class:list={[!sinContenedor && 'mx-auto max-w-6xl px-6']}>
  {
    escalonado ? (
      <>
        <div class="opacity-0 motion-safe:animate-[reveal-up_0.7s_cubic-bezier(0.22,1,0.36,1)_forwards] motion-reduce:opacity-100">
          <slot name="migas" />
          <Eyebrow class={claseEyebrow}>{eyebrow}</Eyebrow>
        </div>
        <h1 class="max-w-[900px] text-h1 font-medium text-navy opacity-0 motion-safe:animate-[reveal-up_0.7s_0.25s_cubic-bezier(0.22,1,0.36,1)_forwards] motion-reduce:opacity-100">
          <span class="subrayado-hero subrayado-hero--escalonado inline-block">{titulo}</span>
        </h1>
        {bajada && (
          <p class="mt-6 max-w-[680px] text-lg font-light leading-relaxed text-navy-700 opacity-0 motion-safe:animate-[reveal-up_0.7s_0.5s_cubic-bezier(0.22,1,0.36,1)_forwards] motion-reduce:opacity-100">
            {bajada}
          </p>
        )}
      </>
    ) : (
      <div class="opacity-0 motion-safe:animate-[reveal-up_0.7s_cubic-bezier(0.22,1,0.36,1)_forwards] motion-reduce:opacity-100">
        <slot name="migas" />
        <Eyebrow class={claseEyebrow}>{eyebrow}</Eyebrow>
        <h1 class="max-w-[900px] text-h1 font-medium text-navy">
          <span class="subrayado-hero inline-block">{titulo}</span>
        </h1>
        {bajada && (
          <p class="mt-6 max-w-[680px] text-lg font-light leading-relaxed text-navy-700">
            {bajada}
          </p>
        )}
      </div>
    )
  }
</div>

<style>
  /* Subrayado que cubre el headline completo (25/08/2026): mismo mecanismo que
   * el hero de la Home (`.subrayado-hero` + keyframe `hero-rule` de
   * global.css), pero envolviendo todo el texto del h1 en vez de solo una
   * porción final — acá no hay un cierre a destacar, es el título entero.
   * Reemplaza a la línea estática que antes iba debajo del h1 en un div
   * aparte. El delay (0.7s) arranca justo cuando termina el reveal-up del
   * bloque completo (0.7s, sin delay propio), para que el trazo se dibuje
   * después de que el título ya es visible.
   *
   * Variante `--escalonado` (25/08/2026): en la entrada escalonada el propio
   * h1 ya lleva 0.25s de delay + 0.7s de duración (ver arriba), así que el
   * trazo tiene que arrancar 0.25s más tarde que en la versión de bloque
   * único: 0.95s en vez de 0.7s. */
  .subrayado-hero {
    position: relative;
  }

  .subrayado-hero::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -0.14em;
    height: 3px;
    background-color: var(--color-arena);
    transform: scaleX(0);
    transform-origin: left;
    animation: hero-rule 1s 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .subrayado-hero--escalonado::after {
    animation-delay: 0.95s;
  }

  @media (prefers-reduced-motion: reduce) {
    .subrayado-hero::after {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>
