---
/**
 * Header + navegación. Menú móvil con <details>/<summary> nativo: 0 JS (§3.4).
 * Mayúsculas por CSS (§2.2), tap targets ≥44px (§7.3).
 *
 * El header es sticky y suma sombra + glass (backdrop-blur) al scrollear
 * (decisión del 06/08/2026, rompe a propósito el "sin sombras, sin
 * degradados" de §3.3). El toggle es un <script> plano sin client:* (§7.1):
 * lee window.scrollY y escribe data-scrolled, que Tailwind lee vía variante
 * de atributo arbitraria (data-[scrolled=true]:…).
 *
 * En el Home el header es `fixed` (sale del flujo): al no ocupar espacio en
 * el flujo, el hero pasa a empezar en y=0 y el header queda flotando sobre el
 * video. En su punto inicial es 100% transparente (decisión del 06/08/2026)
 * para no competir con la máscara del isotipo del hero — recién al scrollear
 * se diferencia con el glass sólido. En el resto de las páginas (sin hero
 * full-bleed) el header sigue `sticky` y opaco como antes.
 *
 * Sin navy (14/08/2026, pedido directo): el header ya no usa navy en ningún
 * estado. Home arranca transparente con texto blanco (sigue teniendo sentido:
 * flota sobre el video oscuro del hero) y al scrollear pasa a glass blanco
 * (`bg-white/70` + blur) con texto navy — el mismo mecanismo `data-scrolled`
 * de siempre, ahora también condiciona el color de texto vía
 * `group-data-[scrolled=true]:`. En el resto de las páginas el header es
 * blanco sólido con texto navy desde el vamos. El activo/hover de los links
 * ya no usa arena sobre fondo claro (1.70, falla WCAG, §1.2): sobre blanco
 * el hover es navy-700 y el estado activo se marca con navy + peso 500
 * (font-medium), no con color. Arena como acento de hover solo sobrevive en
 * el tramo inicial del Home, sobre el video oscuro, donde sí pasa contraste.
 *
 * Logo (14/08/2026): /logo-nest.svg es todo blanco, pensado para el hero oscuro
 * de Home; invisible sobre el header blanco del resto de las páginas y sobre el
 * glass blanco al scrollear en Home. Ahí usamos /logo-nest-oscuro.svg, el mismo
 * logo en navy sólido. Monocromo desde el 16/08/2026 (pedido del cliente): un
 * solo tono por variante, blanco o navy según el fondo — antes el isotipo iba
 * en arena. En Home, como el
 * header pasa de transparente a glass blanco, se superponen las dos variantes
 * y se alternan con el mismo `data-scrolled` que ya condiciona el resto del
 * header, vía `group-data-[scrolled=true]:opacity-*` — sin JS nuevo.
 */
import Boton from '@/components/astro/Boton.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/obras', label: 'Obras' },
  { href: '/contacto', label: 'Contacto' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const activo = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const esHome = path === '/';
// 05/09/2026 (auditoría de performance): el header transiciona solo color,
// fondo y borde. Animar box-shadow y backdrop-filter repintaba el header
// completo durante los 300ms de cada cambio de estado; ahora el blur y la
// sombra entran de golpe con `data-scrolled` y solo el color se funde.
---

<header
  id="site-header"
  class:list={[
    'group z-50 border-b border-transparent py-3 transition-[background-color,border-color,color] duration-300',
    esHome
      ? 'fixed inset-x-0 top-0 bg-transparent text-white data-[scrolled=true]:text-navy'
      : 'sticky top-0 bg-white text-navy',
    'data-[scrolled=true]:border-navy-200 data-[scrolled=true]:bg-white/70 data-[scrolled=true]:shadow-[0_12px_40px_rgba(0,0,0,0.1)] data-[scrolled=true]:backdrop-blur-md',
  ]}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6">
    <a href="/" class="relative flex items-center">
      {/* 2.97rem = 47.52px: +10% sobre el 2.7rem anterior (14/08/2026, escala de navbar). */}
      {
        esHome ? (
          <>
            <img
              src="/logo-nest.svg"
              alt="NEST"
              class="h-[2.97rem] w-auto transition-opacity duration-300 group-data-[scrolled=true]:opacity-0"
            />
            <img
              src="/logo-nest-oscuro.svg"
              alt=""
              aria-hidden="true"
              class="absolute inset-0 h-[2.97rem] w-auto opacity-0 transition-opacity duration-300 group-data-[scrolled=true]:opacity-100"
            />
          </>
        ) : (
          <img src="/logo-nest-oscuro.svg" alt="NEST" class="h-[2.97rem] w-auto" />
        )
      }
    </a>

    <nav class="hidden items-center md:flex" aria-label="Principal">
      <div class="flex items-center gap-8">
        {
          links.map((l) => (
            <a
              href={l.href}
              aria-current={activo(l.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-[44px] items-center text-[17.6px] uppercase tracking-[0.08em] transition-colors',
                activo(l.href) && 'font-medium',
                esHome
                  ? activo(l.href)
                    ? 'text-arena group-data-[scrolled=true]:text-navy'
                    : 'hover:text-arena group-data-[scrolled=true]:hover:text-navy-700'
                  : activo(l.href)
                    ? 'text-navy'
                    : 'hover:text-navy-700',
              ]}
            >
              {l.label}
            </a>
          ))
        }
      </div>
      {/* Colapsado a 0fr/ml-0 en reposo: los tabs quedan pegados a la derecha,
          sin hueco reservado. Al scrollear crece a 1fr/ml-8 y "empuja" los tabs
          hacia la izquierda para dejarle lugar — grid-template-columns anima
          igual que un ancho, cosa que `width:auto` no permite. */}
      <div class="ml-0 grid grid-cols-[0fr] overflow-hidden transition-[grid-template-columns,margin-left] duration-700 group-data-[scrolled=true]:ml-8 group-data-[scrolled=true]:grid-cols-[1fr]">
        <div class="overflow-hidden">
          {/* primarioClaro (14/08/2026): este CTA solo se muestra scrolleado —
              el grid-cols-[0fr] de arriba lo mantiene en ancho 0 hasta ese
              punto, en Home y en el resto de las páginas por igual — así que
              siempre queda sobre el glass blanco, nunca sobre navy ni sobre el
              hero transparente. `primario` (glass sobre navy) ya no aplica acá.
              +10% de escala: el variante base es px-2 py-2 text-base; se pisa
              con !text-[1.1rem] !px-[0.55rem] !py-[0.55rem] solo en esta
              instancia. */}
          <Boton
            href="/contacto"
            variante="primarioClaro"
            class="!px-[0.55rem] !py-[0.55rem] whitespace-nowrap !text-[1.1rem]"
            >Consultá tu proyecto</Boton
          >
        </div>
      </div>
    </nav>

    <details class="group md:hidden">
      {/* Hamburguesa minimalista (18/08/2026, pedido explícito): antes eran las
          palabras "Menú"/"Cerrar". Son dos trazos de 1px que al abrir el
          <details> rotan y se cruzan en una X — la misma transformación que
          usa el resto del sitio para estados (transición de `transform`, sin
          JS, y anulada con `prefers-reduced-motion`). El `aria-label` viaja en
          el <summary> y los trazos son `aria-hidden`, así que para un lector
          de pantalla sigue siendo un solo control con nombre. `w-6` para que
          los dos trazos midan igual y la X quede centrada; el tap target lo
          sostiene el `min-h-[44px] min-w-[44px]`. */}
      <summary
        class="ham flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-end [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú"
      >
        <span class="relative block h-4 w-6" aria-hidden="true">
          <span class="ham-linea ham-linea--sup"></span>
          <span class="ham-linea ham-linea--inf"></span>
        </span>
      </summary>
      {/* Glass con blur, igual que el header scrolleado (18/08/2026, pedido
          explícito): antes era `bg-white` sólido. Toma del header su
          `bg-white/70`, el borde `navy-200` y la sombra, así que las dos
          superficies se leen como una sola.
          El blur SÍ se despega a propósito: `backdrop-blur-2xl` (40px) en vez
          del `md` (12px) del header (18/08/2026, pedido explícito de "más
          blureado"). Tiene sentido que sea más fuerte acá: el desplegable
          cubre contenido a pantalla completa y necesita separarse de él, no
          apenas insinuar la capa como hace la barra de 44px de alto. */}
      <nav
        class="absolute inset-x-0 top-full flex flex-col border-t border-navy-200 bg-white/70 px-6 pb-4 shadow-[0_12px_40px_rgba(0,0,0,0.1)] backdrop-blur-2xl"
        aria-label="Principal (móvil)"
      >
        {
          links.map((l) => (
            <a
              href={l.href}
              aria-current={activo(l.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-[44px] items-center text-[17.6px] uppercase tracking-[0.08em] text-navy transition-colors',
                activo(l.href) ? 'font-medium' : 'hover:text-navy-700',
              ]}
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<style>
  /* Hamburguesa minimalista (18/08/2026). Dos trazos de 1px en `currentColor`
   * —así heredan el color del header, que cambia entre blanco sobre el hero y
   * navy sobre el glass, sin tener que duplicar ninguna regla— que al abrir el
   * <details> se juntan al centro y rotan a una X. */
  .ham-linea {
    position: absolute;
    left: 0;
    height: 1px;
    width: 100%;
    background-color: currentColor;
    transition:
      top 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      bottom 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ham-linea--sup {
    top: 0.25rem;
  }
  .ham-linea--inf {
    bottom: 0.25rem;
  }

  /* Abierto: los dos trazos se mueven al centro y se cruzan. `details[open]`
   * es el estado nativo del elemento, así que esto no necesita JS. */
  details[open] .ham-linea--sup {
    top: calc(50% - 0.5px);
    transform: rotate(45deg);
  }
  details[open] .ham-linea--inf {
    bottom: calc(50% - 0.5px);
    transform: rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .ham-linea {
      transition: none;
    }
  }
</style>

<script>
  // Sin JS no pasa nada grave: el header queda fijo en su estado "no scrolleado"
  // (transparente con texto blanco en Home, blanco sólido con texto navy en el
  // resto), que ya es un header válido — no hay contenido que dependa de esto
  // para funcionar.
  const header = document.getElementById('site-header');
  // 05/09/2026 (auditoría de performance): se escribe el atributo solo cuando
  // el estado cambia. Antes se hacía setAttribute en cada evento de scroll,
  // aunque el valor fuera el mismo, y eso invalidaba estilos sin necesidad.
  let scrolleado: boolean | undefined;
  const actualizarScroll = () => {
    const ahora = window.scrollY > 8;
    if (ahora === scrolleado) return;
    scrolleado = ahora;
    header?.setAttribute('data-scrolled', String(ahora));
  };
  actualizarScroll();
  document.addEventListener('scroll', actualizarScroll, { passive: true });
</script>
