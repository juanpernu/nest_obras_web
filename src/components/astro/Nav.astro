---
/**
 * Header + navegación. Menú móvil con <details>/<summary> nativo: 0 JS (§3.4).
 * Mayúsculas por CSS (§2.2), tap targets ≥44px (§7.3).
 *
 * El header es sticky y suma sombra + glass (backdrop-blur) al scrollear
 * (decisión del 06/08/2026, rompe a propósito el "sin sombras, sin
 * degradados" de §3.3). El toggle es un <script> plano sin client:* (§7.1):
 * lee window.scrollY y escribe data-scrolled, que Tailwind lee vía variante
 * de atributo arbitraria (data-[scrolled=true]:…).
 *
 * En el Home el header es `fixed` (sale del flujo): al no ocupar espacio en
 * el flujo, el hero pasa a empezar en y=0 y el header queda flotando sobre el
 * video. En su punto inicial es 100% transparente (decisión del 06/08/2026)
 * para no competir con la máscara del isotipo del hero — recién al scrollear
 * se diferencia con el glass sólido. En el resto de las páginas (sin hero
 * full-bleed) el header sigue `sticky` y opaco como antes.
 *
 * Sin navy (14/08/2026, pedido directo): el header ya no usa navy en ningún
 * estado. Home arranca transparente con texto blanco (sigue teniendo sentido:
 * flota sobre el video oscuro del hero) y al scrollear pasa a glass blanco
 * (`bg-white/70` + blur) con texto navy — el mismo mecanismo `data-scrolled`
 * de siempre, ahora también condiciona el color de texto vía
 * `group-data-[scrolled=true]:`. En el resto de las páginas el header es
 * blanco sólido con texto navy desde el vamos. El activo/hover de los links
 * ya no usa arena sobre fondo claro (1.70, falla WCAG, §1.2): sobre blanco
 * el hover es navy-700 y el estado activo se marca con navy + peso 500
 * (font-medium), no con color. Arena como acento de hover solo sobrevive en
 * el tramo inicial del Home, sobre el video oscuro, donde sí pasa contraste.
 *
 * Logo (14/08/2026): /logo-nest.svg va sobre el hero oscuro de Home; es
 * invisible sobre el header blanco del resto de las páginas y sobre el glass
 * blanco al scrollear en Home. Ahí usamos /logo-nest-oscuro.svg (wordmark
 * navy, isotipo arena-800). En Home, como el header pasa de transparente a
 * glass blanco, se superponen las dos variantes y se alternan con el mismo
 * `data-scrolled` que ya condiciona el resto del header, vía
 * `group-data-[scrolled=true]:opacity-*` — sin JS nuevo.
 *
 * (15/08/2026) /logo-nest.svg pasó a ser BLANCO ENTERO —wordmark e isotipo—:
 * antes el isotipo iba en arena de marca (#D9C2B6) y el wordmark en blanco, y
 * el logo se leía en dos tintas sobre el video. Pedido directo: una sola
 * tinta. Ese mismo archivo es el que usa ahora el footer navy.
 */
import Boton from '@/components/astro/Boton.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/obras', label: 'Obras' },
  { href: '/contacto', label: 'Contacto' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const activo = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const esHome = path === '/';
---

<header
  id="site-header"
  class:list={[
    'group z-50 border-b border-transparent py-3 transition-[background-color,box-shadow,border-color,backdrop-filter,color] duration-300',
    esHome
      ? 'fixed inset-x-0 top-0 bg-transparent text-white data-[scrolled=true]:text-navy'
      : 'sticky top-0 bg-white text-navy',
    'data-[scrolled=true]:border-navy-200 data-[scrolled=true]:bg-white/70 data-[scrolled=true]:shadow-[0_12px_40px_rgba(0,0,0,0.1)] data-[scrolled=true]:backdrop-blur-md',
  ]}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6">
    <a href="/" class="relative flex items-center">
      {/* 2.97rem = 47.52px: +10% sobre el 2.7rem anterior (14/08/2026, escala de navbar). */}
      {
        esHome ? (
          <>
            <img
              src="/logo-nest.svg"
              alt="NEST"
              class="h-[2.97rem] w-auto transition-opacity duration-300 group-data-[scrolled=true]:opacity-0"
            />
            <img
              src="/logo-nest-oscuro.svg"
              alt=""
              aria-hidden="true"
              class="absolute inset-0 h-[2.97rem] w-auto opacity-0 transition-opacity duration-300 group-data-[scrolled=true]:opacity-100"
            />
          </>
        ) : (
          <img src="/logo-nest-oscuro.svg" alt="NEST" class="h-[2.97rem] w-auto" />
        )
      }
    </a>

    <nav class="hidden items-center md:flex" aria-label="Principal">
      <div class="flex items-center gap-8">
        {
          links.map((l) => (
            <a
              href={l.href}
              aria-current={activo(l.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-[44px] items-center text-[0.9625rem] uppercase tracking-[0.08em] transition-colors',
                activo(l.href) && 'font-medium',
                esHome
                  ? activo(l.href)
                    ? 'text-arena group-data-[scrolled=true]:text-navy'
                    : 'hover:text-arena group-data-[scrolled=true]:hover:text-navy-700'
                  : activo(l.href)
                    ? 'text-navy'
                    : 'hover:text-navy-700',
              ]}
            >
              {l.label}
            </a>
          ))
        }
      </div>
      {/* Colapsado a 0fr/ml-0 en reposo: los tabs quedan pegados a la derecha,
          sin hueco reservado. Al scrollear crece a 1fr/ml-8 y "empuja" los tabs
          hacia la izquierda para dejarle lugar — grid-template-columns anima
          igual que un ancho, cosa que `width:auto` no permite. */}
      <div class="ml-0 grid grid-cols-[0fr] overflow-hidden transition-[grid-template-columns,margin-left] duration-700 group-data-[scrolled=true]:ml-8 group-data-[scrolled=true]:grid-cols-[1fr]">
        <div class="overflow-hidden">
          {/* primarioClaro (14/08/2026): este CTA solo se muestra scrolleado —
              el grid-cols-[0fr] de arriba lo mantiene en ancho 0 hasta ese
              punto, en Home y en el resto de las páginas por igual — así que
              siempre queda sobre el glass blanco, nunca sobre navy ni sobre el
              hero transparente. `primario` (glass sobre navy) ya no aplica acá.
              El tamaño de texto se pisa para igualarlo al de los links del
              header (15/08/2026, pedido directo). Antes era `!text-[1.1rem]`,
              un +10% sobre el `text-base` del variante, y el CTA leía
              visiblemente más grande que "HOME / NOSOTROS / …". Ahora es el
              mismo 0.9625rem de los links, escrito como valor arbitrario y no
              como token porque el header entero está calibrado a esa escala. El
              padding sigue pisado para que la caja no quede apretada. */}
          <Boton
            href="/contacto"
            variante="primarioClaro"
            class="!px-[0.55rem] !py-[0.55rem] whitespace-nowrap !text-[0.9625rem]"
            >Consultá tu proyecto</Boton
          >
        </div>
      </div>
    </nav>

    <details class="group md:hidden">
      <summary
        class="flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-end text-sm uppercase tracking-[0.08em] [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú"
      >
        <span class="group-open:hidden">Menú</span>
        <span class="hidden group-open:inline">Cerrar</span>
      </summary>
      <nav
        class="absolute inset-x-0 top-full flex flex-col border-t border-navy-200 bg-white px-6 pb-4"
        aria-label="Principal (móvil)"
      >
        {
          links.map((l) => (
            <a
              href={l.href}
              aria-current={activo(l.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-[44px] items-center text-[0.9625rem] uppercase tracking-[0.08em] text-navy transition-colors',
                activo(l.href) ? 'font-medium' : 'hover:text-navy-700',
              ]}
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<script>
  // Sin JS no pasa nada grave: el header queda fijo en su estado "no scrolleado"
  // (transparente con texto blanco en Home, blanco sólido con texto navy en el
  // resto), que ya es un header válido — no hay contenido que dependa de esto
  // para funcionar.
  const header = document.getElementById('site-header');
  const actualizarScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 8));
  actualizarScroll();
  document.addEventListener('scroll', actualizarScroll, { passive: true });
</script>
