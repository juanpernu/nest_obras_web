---
/**
 * Video de fondo del hero (docs/PLAN-EJECUCION.md §7.2).
 *
 * EMBED DE YOUTUBE, tercera vez (06/09/2026, pedido explícito después del
 * reporte de que el <video> nativo "se sigue pausando" en iPhone). Historial
 * completo en docs/DEUDA-TECNICA.md §5: dos embeds previos (14 y 16/08/2026)
 * se revirtieron a <video> nativo el 17/08 porque el player mostraba su UI en
 * cada ciclo del loop y el handshake por postMessage "a mano" nunca contestaba,
 * así que no había forma confiable de saber en qué estado estaba el player.
 * El nativo, a su vez, quedaba en el poster o se pausaba en iPhone (Modo de
 * bajo consumo, WKWebView de Chrome iOS) aun con el reintento por gesto
 * corregido en el PR #15.
 *
 * Qué cambia respecto de los dos intentos anteriores:
 *
 *  - Se usa la IFrame Player API oficial (`youtube.com/iframe_api`) en vez del
 *    postMessage crudo. Eso da `onStateChange` confiable, y con eso se cubren
 *    las tres cosas que antes fallaban: ENDED → rebobinar y seguir (además de
 *    `loop=1&playlist=<id>`); PAUSED → volver a reproducir (el "se sigue
 *    pausando"); UNSTARTED/CUED → esperar el primer gesto y reproducir.
 *  - El iframe se dimensiona un 30 % más grande que la caja y el contenedor
 *    recorta el sobrante: la franja superior (título, "Ver en YouTube") y la
 *    inferior (barra de progreso, logo) del player quedan fuera del recorte
 *    aunque YouTube decida pintarlas. `controls=0` y `pointer-events: none`
 *    siguen como primera línea; el recorte es la red de seguridad.
 *  - El iframe se revela recién cuando el player reporta PLAYING. Si el
 *    autoplay está bloqueado se sigue viendo el poster, no un player negro con
 *    botón de play, y el primer toque en cualquier parte de la página arranca
 *    el video (touchend/click, que son los eventos que WebKit acepta como
 *    gesto — ver PR #15).
 *
 * PRESUPUESTO DE PERFORMANCE. El embed trae >1 MB de JS de terceros, así que
 * NO está en el HTML inicial: el LCP sigue siendo el <h1> y el poster (que ya
 * se precarga desde el layout). El API y el iframe se cargan recién en `load`.
 *
 * AUTOPLAY EN TODOS LOS DISPOSITIVOS (pedido explícito, 06/09/2026, reafirma
 * la decisión del 16/08/2026): se monta en todos los anchos y también con
 * `prefers-reduced-motion` (contra WCAG 2.2.2; lo asume el cliente). El único
 * recorte que queda es `saveData` / 2g, que es opt-in de la persona.
 *
 * Dominio `youtube-nocookie.com`: mismo player, sin cookies de tracking hasta
 * que hay interacción — y acá no puede haberla (`pointer-events: none`).
 *
 * NO LLEVA `data-evento="video_play"` A PROPÓSITO: es decorativo y autoplay;
 * medirlo sería un pageview disfrazado (ver src/data/analytics.ts).
 */
interface Props {
  /** ID del video (la `v=` de la URL de YouTube). */
  youtubeId: string;
  /** Imagen que se ve hasta que el player reporta que está reproduciendo. */
  poster: string;
  class?: string;
}
const { youtubeId, poster, class: className } = Astro.props as Props;
---

<div class:list={['hero-video', className]} aria-hidden="true" data-yt={youtubeId}>
  {/* Prioridad alta y no lazy: el poster ocupa el viewport entero arriba de
      todo y es el candidato a LCP de imagen de la ruta —el <h1> es texto sobre
      él—, así que retrasarlo empuja el LCP directamente.
      El archivo es la miniatura del propio video (i.ytimg.com/vi/<id>/
      maxresdefault.jpg, 1280×720, reencodeada a ~50 KB con sharp), servida
      desde public/ para no abrir una conexión más en el camino crítico. Así lo
      que se ve mientras el player carga es el mismo cuadro con el que arranca
      el video y no un placeholder distinto (pedido del 06/09/2026). Si se
      cambia el video hay que regenerar public/hero-poster.jpg. */}
  <img
    class="hero-video-poster"
    src={poster}
    alt=""
    width="1280"
    height="720"
    fetchpriority="high"
    decoding="async"
  />
  {/* La API reemplaza este div por el <iframe> (mismo lugar en el árbol). */}
  <div class="hero-video-player"></div>
</div>

<style>
  /* El componente es dueño de su geometría: se estira sobre el contenedor
     posicionado más cercano —el <section> del hero— y recorta lo que sobra del
     video. El consumidor solo decide el stacking (la `-z-20` de index.astro).
     `container-type: size` habilita las unidades cq* de abajo. */
  .hero-video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: #000;
    container-type: size;
  }

  .hero-video-poster {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  /* Cobertura de la caja para un video 16:9 —se toma el mayor entre "ancho
     completo" y "alto completo × 16/9", así nunca quedan bandas— multiplicada
     por 1.3: el 15 % que sobra arriba y abajo es donde YouTube pinta título y
     barra de controles, y queda fuera del recorte del contenedor. Primero en
     unidades de viewport (el hero mide min-h-dvh, así que las describen bien)
     y después, donde existen, en unidades de contenedor, que son exactas. */
  .hero-video :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 130vw;
    height: 73.125vw;
    min-width: 231.11vh;
    min-height: 130vh;
    border: 0;
    /* El chrome de YouTube se dispara al hover. Sin puntero no hay chrome, y
       además ningún click puede escaparse a youtube.com. */
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  @supports (width: 1cqw) {
    .hero-video :global(iframe) {
      width: 130cqw;
      height: 73.125cqw;
      min-width: 231.11cqh;
      min-height: 130cqh;
    }
  }

  /* La pone el script cuando el player reporta PLAYING. */
  .hero-video :global(iframe.visible) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video :global(iframe) {
      transition: none;
    }
  }
</style>

<script>
  /* Fachada del hero sobre la IFrame Player API de YouTube. Ver la nota
   * extensa del frontmatter. */
  interface YTPlayer {
    mute(): void;
    playVideo(): void;
    seekTo(segundos: number, permitirBuscar: boolean): void;
    getPlayerState(): number;
    getIframe(): HTMLIFrameElement;
  }
  interface YTEvento {
    target: YTPlayer;
    data: number;
  }
  interface YTNamespace {
    Player: new (
      host: HTMLElement,
      opciones: {
        videoId: string;
        host: string;
        playerVars: Record<string, string | number>;
        events: { onReady(e: YTEvento): void; onStateChange(e: YTEvento): void };
      },
    ) => YTPlayer;
  }
  declare global {
    interface Window {
      YT?: YTNamespace;
      onYouTubeIframeAPIReady?: () => void;
    }
  }

  // Estados de YT.PlayerState.
  const ENDED = 0;
  const PLAYING = 1;
  const PAUSED = 2;

  const contenedor = document.querySelector<HTMLElement>('.hero-video');
  const host = contenedor?.querySelector<HTMLElement>('.hero-video-player');
  const videoId = contenedor?.dataset.yt;

  if (contenedor && host && videoId) {
    let player: YTPlayer | undefined;

    const reproducir = () => {
      if (!player || player.getPlayerState() === PLAYING) return;
      player.mute();
      player.playVideo();
    };

    const crearPlayer = () => {
      if (!window.YT) return;
      player = new window.YT.Player(host, {
        videoId,
        host: 'https://www.youtube-nocookie.com',
        playerVars: {
          autoplay: 1,
          mute: 1,
          controls: 0,
          disablekb: 1,
          fs: 0,
          rel: 0,
          iv_load_policy: 3,
          playsinline: 1,
          // `playlist` con el propio id es lo que hace que `loop` funcione en
          // un video suelto; sin eso YouTube cae en la pantalla final.
          loop: 1,
          playlist: videoId,
          origin: window.location.origin,
        },
        events: {
          onReady: (e) => {
            const iframe = e.target.getIframe();
            iframe.title = 'Video institucional de NEST';
            iframe.setAttribute('tabindex', '-1');
            iframe.setAttribute('aria-hidden', 'true');
            e.target.mute();
            e.target.playVideo();
          },
          onStateChange: (e) => {
            if (e.data === PLAYING) {
              e.target.getIframe().classList.add('visible');
            } else if (e.data === ENDED) {
              e.target.seekTo(0, true);
              e.target.playVideo();
            } else if (e.data === PAUSED) {
              // Nadie puede pausarlo (pointer-events: none): si se pausó fue el
              // sistema (bloqueo de pantalla, cambio de app, ahorro de energía).
              e.target.playVideo();
            }
          },
        },
      });
    };

    const montar = () => {
      if (window.YT?.Player) {
        crearPlayer();
        return;
      }
      window.onYouTubeIframeAPIReady = crearPlayer;
      const script = document.createElement('script');
      script.src = 'https://www.youtube.com/iframe_api';
      script.async = true;
      document.head.appendChild(script);
    };

    /* Cuando el autoplay está bloqueado el player queda en UNSTARTED/CUED y el
     * iframe invisible (se ve el poster). El primer gesto real de la persona lo
     * arranca: touchend y click son los eventos que WebKit acepta como gesto
     * (pointerdown de tipo touch NO cuenta; ver PR #15). Quedan armados para
     * siempre: `reproducir` no hace nada si ya está sonando. */
    for (const gesto of ['touchend', 'click'] as const) {
      document.addEventListener(gesto, reproducir, { capture: true, passive: true });
    }
    // WebKit puede pausar el player al bloquear la pantalla o cambiar de app y
    // no retomarlo al volver.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) reproducir();
    });

    /* El video es decorativo: no vale un solo byte si la persona pidió ahorrar
     * datos o está en una conexión lenta. `connection` no existe en Safari ni
     * Firefox, y ahí simplemente no se aplica. */
    const conexion = (
      navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    const conexionPobre =
      conexion?.saveData === true ||
      (conexion?.effectiveType !== undefined && /^(slow-)?2g$/.test(conexion.effectiveType));

    /* En `load` y no en idle: el video tiene que arrancar sin espera perceptible.
     * Sigue después del LCP porque `load` ya implica que la ruta se pintó. */
    if (!conexionPobre) {
      if (document.readyState === 'complete') montar();
      else window.addEventListener('load', montar, { once: true });
    }
  }
</script>
