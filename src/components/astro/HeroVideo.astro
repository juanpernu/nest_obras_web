---
/**
 * Video de fondo del hero (docs/PLAN-EJECUCION.md §7.2).
 *
 * Vuelve a <video> nativo (revertido el embed de YouTube, 14/08/2026): el
 * embed mostraba su propia UI —título, controles, tarjeta "más videos"— en
 * cada ciclo del loop y no hay parámetro que la elimine, así que rompía el
 * efecto de fondo continuo. El archivo es propio (public/hero-video.mp4).
 *
 * El <source> matchea solo en ≥768px Y sin prefers-reduced-motion: en mobile o
 * con reduced-motion ningún source matchea → el navegador NUNCA pide bytes de
 * video, solo pinta el poster. Se resuelve en el media del <source>, no con CSS
 * (ocultar por CSS descarga igual). El LCP es el <h1>: `preload="none"` + poster.
 *
 * NO LLEVA `data-evento="video_play"` A PROPÓSITO. Es un video decorativo con
 * `autoplay muted` y `aria-hidden`: el evento `play` se dispara solo al cargar la
 * página, sin que nadie haya hecho nada. Medirlo daría una métrica que parece
 * engagement pero en realidad es "visita de desktop sin reduced-motion", o sea un
 * pageview disfrazado. El engagement real lo cubre Enhanced Measurement de GA4.
 * El mapeo `video_play` existe en src/data/analytics.ts para un video con
 * controles de verdad, que es donde el evento sí significa algo.
 */
interface Props {
  srcDesktop: string;
  poster: string;
  class?: string;
}
const { srcDesktop, poster, class: className } = Astro.props as Props;
---

<video
  poster={poster}
  preload="none"
  autoplay
  muted
  playsinline
  loop
  aria-hidden="true"
  class:list={['hero-video', className]}
>
  <source
    media="(min-width: 768px) and (prefers-reduced-motion: no-preference)"
    src={srcDesktop}
    type="video/mp4"
  />
</video>
