---
/**
 * Los tres valores como cards de servicios (§5.1 Sección 5 de /nosotros,
 * 20/08/2026, pedido directo: "replicame acá los estilos de la card de
 * servicios"). Es una copia deliberada de `GrillaServicios.astro`, no una
 * abstracción compartida entre las dos: mismo marco full-bleed unificado con
 * `MarcoSeccion` (dos reglas horizontales sólidas en `--color-rule` + cuatro
 * escuadras en L de 9px con 1.5px de borde navy sobre `--marco-x`, el mismo
 * cálculo que `HojaTecnica`/`MarcoSeccion`), mismos divisores verticales de
 * 1px entre celdas que en mobile pasan a `border-bottom`, misma escala de
 * padding (1.25rem / 2rem a 768 / 3rem a 1024) y misma píldora de ícono
 * (56×56, `--radius-boton` = 0, fondo `--color-arena-200`, sin borde, SVG de
 * 26×26 adentro). Si cambia una medida en `GrillaServicios` (grosor de
 * escuadra, color de regla, tamaño de píldora), replicarla acá — el propio
 * `GrillaServicios` ya duplica a su vez el marco de `MarcoSeccion` por el
 * mismo motivo: son ~30 líneas de CSS con selectores propios (`.val-*` vs
 * `.srv-*`), y duplicar con este comentario es más simple que forzar una
 * abstracción nueva para dos usos.
 *
 * SIN hover de superficie (a diferencia de `.srv-card`, que sí lo tiene):
 * corregido a pedido explícito el 20/08/2026. Los tres valores no son
 * candidatos a link como sí lo son los servicios (que apuntan a una página
 * propia en el roadmap del sitio); un cambio de fondo al pasar el mouse sobre
 * contenido de solo lectura sugiere una interactividad que no existe.
 *
 * Montaje: igual que `GrillaServicios` en la Home (`index.astro`, Sección 4)
 * — este componente queda FUERA del `mx-auto max-w-6xl px-6` de la sección
 * que lo monta, como hermano del bloque del encabezado, porque su marco
 * necesita medir 100% contra la SECCIÓN (full-bleed) para que las escuadras
 * caigan sobre las mismas guías que el resto de la página. El `max-w-6xl`
 * interno para la grilla de tarjetas lo pone este mismo componente.
 *
 * Cero `100vw`: `.val-frame` es ya un bloque de ancho completo (hijo directo
 * de la `<section>`), así que `left: 0; right: 0` alcanza para llegar al borde
 * de pantalla sin depender del ancho de la scrollbar.
 *
 * Cromática: fondo claro, trazo y escuadras en navy — arena sobre blanco no
 * pasa WCAG y el acento en claro es navy (§1.2). La arena queda para el fondo
 * de la píldora del ícono, donde es superficie y no trazo.
 *
 * Todo es CSS: sin JS y sin `client:*` (§7.1).
 */
export interface Valor {
  titulo: string;
  texto: string;
  /** Cuál de los tres íconos usar. */
  icono: 'transparencia' | 'cumplimiento' | 'calidad';
}

interface Props {
  valores: Valor[];
  class?: string;
}
const { valores, class: className } = Astro.props as Props;
---

<div class:list={['val-frame relative', className]}>
  {/* Marco: dos reglas horizontales sólidas + 4 escuadras en L, mismo criterio
      que MarcoSeccion / GrillaServicios. */}
  <span class="val-regla val-regla--sup" aria-hidden="true"></span>
  <span class="val-regla val-regla--inf" aria-hidden="true"></span>
  <span class="val-esq val-esq--si" aria-hidden="true"></span>
  <span class="val-esq val-esq--sd" aria-hidden="true"></span>
  <span class="val-esq val-esq--ii" aria-hidden="true"></span>
  <span class="val-esq val-esq--id" aria-hidden="true"></span>

  <div class="mx-auto max-w-6xl px-6">
    <div class="val-grid">
      {
        valores.map((v, i) => (
          <>
            {i > 0 && <div class="val-div" aria-hidden="true" />}
            <div class="val-celda">
              <span class="val-ico" aria-hidden="true">
                {v.icono === 'transparencia' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" />
                    <circle cx="12" cy="12" r="2.75" />
                  </svg>
                )}
                {v.icono === 'cumplimiento' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3.5" y="5" width="17" height="15" rx="2" />
                    <path d="M3.5 9.5h17" />
                    <path d="M8 3.5v3M16 3.5v3" />
                    <path d="m8.5 14 2.25 2.25L15.5 12" />
                  </svg>
                )}
                {v.icono === 'calidad' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 3.5l7 2.5v5.5c0 5-3 8-7 9-4-1-7-4-7-9V6l7-2.5Z" />
                    <path d="m9 12 2.25 2.25L15.5 9.5" />
                  </svg>
                )}
              </span>
              <h3 class="text-h3 font-medium text-navy">{v.titulo}</h3>
              <p class="val-desc font-light leading-relaxed text-navy-700">{v.texto}</p>
            </div>
          </>
        ))
      }
    </div>
  </div>
</div>

<style>
  .val-frame {
    /* Idéntico al `--marco-x` de MarcoSeccion / `--bp-frame` de
     * GrillaServicios: las escuadras caen sobre las mismas guías de página. */
    --marco-x: max(var(--guia-margen), calc((100% - var(--container-6xl)) / 2));
  }

  /* Reglas horizontales: sólidas en --color-rule, igual que .marco-regla /
   * .bp-regla. */
  .val-regla {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    height: 1px;
    background-color: var(--color-rule);
    pointer-events: none;
  }
  .val-regla--sup {
    top: 0;
  }
  .val-regla--inf {
    bottom: 0;
  }

  /* Escuadras: cuadrado de 9px con dos lados en navy — misma técnica que
   * .bp-esq / .marco-esq / .gp-esq. */
  .val-esq {
    position: absolute;
    z-index: 2;
    width: 9px;
    height: 9px;
    border-style: solid;
    border-width: 0;
    border-color: var(--color-navy);
    pointer-events: none;
  }
  .val-esq--si {
    top: 0;
    left: var(--marco-x);
    border-top-width: 1.5px;
    border-left-width: 1.5px;
  }
  .val-esq--sd {
    top: 0;
    right: var(--marco-x);
    border-top-width: 1.5px;
    border-right-width: 1.5px;
  }
  .val-esq--ii {
    bottom: 0;
    left: var(--marco-x);
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
  }
  .val-esq--id {
    bottom: 0;
    right: var(--marco-x);
    border-bottom-width: 1.5px;
    border-right-width: 1.5px;
  }

  .val-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  /* Divisor interno entre celdas (desktop): línea sólida en --color-rule, sin
   * escuadras — esas quedan para las 4 esquinas del marco general. */
  .val-div {
    display: none;
    width: 1px;
    background-color: var(--color-rule);
  }

  .val-celda {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    padding: 1.25rem;
  }

  /* Apilado (mobile): sin divisores verticales, se separan con un borde
   * inferior sólido del mismo --color-rule que el resto del marco. */
  .val-celda:not(:last-child) {
    border-bottom: 1px solid var(--color-rule);
  }

  /* Cuadrado con el radio del botón (=0): mismo lenguaje que `.srv-ico`, fondo
   * arena-200 sin trazo — el fondo ya diferencia el contenedor sin necesitar
   * un borde navy de 1px encima. */
  .val-ico {
    width: 56px;
    height: 56px;
    flex: 0 0 auto;
    border-radius: var(--radius-boton);
    background: var(--color-arena-200);
    color: var(--color-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.375rem;
  }
  .val-ico svg {
    width: 26px;
    height: 26px;
  }

  .val-desc {
    margin-top: 1.125rem;
  }

  @media (min-width: 768px) {
    .val-celda {
      padding: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .val-grid {
      grid-template-columns: 1fr auto 1fr auto 1fr;
    }
    .val-div {
      display: block;
    }
    .val-celda {
      padding: 3rem;
    }
    /* En columnas, el separador lo hacen los divisores verticales. */
    .val-celda:not(:last-child) {
      border-bottom: none;
    }
  }
</style>
